---
import '../styles/global.css';
import marketData from '../data/market-data.json';
import { ui, getLocalePath, type Locale, type NavKey } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  activeNav?: NavKey;
  lang?: Locale;
  ogType?: string;
  ogImage?: string;
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
}

const {
  lang = 'en',
  activeNav = 'dashboard',
  title = ui[lang].meta.defaultTitle,
  description = ui[lang].meta.defaultDescription,
  ogType = 'website',
  ogImage = 'https://vector87.com/og-banner.png',
  jsonLd,
} = Astro.props;

const t = ui[lang];

const navKeys: NavKey[] = ['dashboard', 'roles', 'cloud', 'academy', 'about'];
const navItems = navKeys.map((key) => ({
  id: key,
  label: t.nav[key],
  href: getLocalePath(lang, key),
}));

const currentPath = Astro.url.pathname;
const enHref = currentPath.startsWith('/cs')
  ? currentPath.replace(/^\/cs(\/|$)/, '$1') || '/'
  : currentPath;
const csHref = currentPath.startsWith('/cs')
  ? currentPath
  : `/cs${currentPath === '/' ? '/' : currentPath}`;
const homeHref = getLocalePath(lang, 'dashboard');
const canonicalUrl = new URL(currentPath, 'https://vector87.com').href;

const { meta, market_vitality } = marketData;
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#04070e" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Alternate / Hreflang Tags -->
    <link rel="alternate" hreflang="en" href={`https://vector87.com${enHref}`} />
    <link rel="alternate" hreflang="cs" href={`https://vector87.com${csHref}`} />
    <link rel="alternate" hreflang="x-default" href={`https://vector87.com${enHref}`} />

    <!-- Favicon & App Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:site_name" content="Vector87" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={lang === 'cs' ? 'cs_CZ' : 'en_US'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@antkucera" />
    <meta name="twitter:creator" content="@antkucera" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured Data JSON-LD -->
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Google Search Console Verification -->
    <meta name="google-site-verification" content="nK64geQVZxqABdHrt2uaPLgNmKHIFeZj4xUNEH1nC7k" />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-QF8ZTJNDK1"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-QF8ZTJNDK1');
    </script>
  </head>
  <body class="text-slate-100 antialiased selection:bg-cyan-400/20 selection:text-cyan-200 flex flex-col min-h-screen">
    <!-- Top Live Telemetry Bar -->
    <div class="border-b border-slate-800/80 bg-[#04070e]/90 text-[11px] font-mono text-slate-400">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-1.5 flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-4">
          <span class="inline-flex items-center gap-1.5 text-cyan-400 font-semibold">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            {t.telemetryBar.status}
          </span>
          <span class="hidden sm:inline text-slate-600">|</span>
          <span class="hidden sm:inline">
            {t.telemetryBar.snapshot} <strong class="text-slate-200">{meta.latest_snapshot_date}</strong>
          </span>
          <span class="text-slate-600">|</span>
          <span>
            {t.telemetryBar.activeJobs} <strong class="text-cyan-300">{market_vitality.total_ai_data_jobs.toLocaleString('en-US')}</strong>
          </span>
        </div>
        <div class="flex items-center gap-4">
          <span>
            {t.telemetryBar.sp500Coverage} <strong class="text-slate-200">{meta.sp500_tracked_companies}</strong> {t.telemetryBar.firms}
          </span>
          <span class="hidden md:inline text-slate-600">|</span>
          <span class="hidden md:inline">
            {t.telemetryBar.intensity} <strong class="text-emerald-400">{market_vitality.sp500_ai_intensity_pct}%</strong> {t.telemetryBar.ofPool}
          </span>
        </div>
      </div>
    </div>

    <!-- Main Navigation Header -->
    <header class="sticky top-0 z-40 border-b border-slate-800/80 bg-[#060911]/85 backdrop-blur-md">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
        <a href={homeHref} class="flex items-center gap-3 group">
          <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-cyan-500/20 to-blue-600/20 border border-cyan-400/40 flex items-center justify-center font-mono font-bold text-cyan-300 tracking-tighter text-sm group-hover:border-cyan-300 transition-colors">
            V87
          </div>
          <div>
            <div class="flex items-baseline gap-1.5">
              <span class="font-bold tracking-tight text-lg text-white">VECTOR</span>
              <span class="font-mono font-bold text-lg text-cyan-400">87</span>
            </div>
            <p class="text-[10px] font-mono uppercase tracking-widest text-slate-400 -mt-1">
              Data &amp; AI Market Direction
            </p>
          </div>
        </a>

        <nav aria-label={t.nav.mainAria} class="hidden lg:flex items-center gap-1">
          {navItems.map((item) => {
            const isActive = activeNav === item.id;
            return (
              <a
                href={item.href}
                class:list={[
                  'px-3.5 py-2 rounded-md text-xs font-mono transition-colors',
                  isActive
                    ? 'bg-cyan-500/15 text-cyan-300 border border-cyan-500/40 font-semibold'
                    : 'text-slate-300 hover:text-white hover:bg-slate-800/60 border border-transparent',
                ]}
              >
                {item.label}
              </a>
            );
          })}
        </nav>

        <div class="flex items-center gap-2.5">
          <!-- Language Switcher (EN primary / CS secondary) -->
          <div
            class="inline-flex items-center rounded-md border border-slate-800 bg-slate-900/90 p-0.5 font-mono text-[11px]"
            role="group"
            aria-label="Language switcher"
          >
            <a
              href={enHref}
              class:list={[
                'px-2 py-1 rounded transition-colors',
                lang === 'en'
                  ? 'bg-cyan-500/20 text-cyan-300 font-bold'
                  : 'text-slate-400 hover:text-slate-200',
              ]}
            >
              EN
            </a>
            <a
              href={csHref}
              class:list={[
                'px-2 py-1 rounded transition-colors',
                lang === 'cs'
                  ? 'bg-cyan-500/20 text-cyan-300 font-bold'
                  : 'text-slate-400 hover:text-slate-200',
              ]}
            >
              CS
            </a>
          </div>

          <a
            href="https://akucera.eu"
            target="_blank"
            rel="noopener noreferrer"
            class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-mono border border-slate-700/80 bg-slate-900/80 text-slate-300 hover:border-cyan-400/50 hover:text-cyan-300 transition-colors"
          >
            <span>akucera.eu</span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <!-- Mobile Horizontal Nav -->
      <nav aria-label={t.nav.mobileAria} class="lg:hidden border-t border-slate-800/60 px-4 py-2 flex items-center gap-2 overflow-x-auto">
        {navItems.map((item) => {
          const isActive = activeNav === item.id;
          return (
            <a
              href={item.href}
              class:list={[
                'px-2.5 py-1.5 rounded text-[11px] font-mono whitespace-nowrap',
                isActive
                  ? 'bg-cyan-500/15 text-cyan-300 border border-cyan-500/40 font-semibold'
                  : 'text-slate-400 hover:text-slate-200',
              ]}
            >
              {item.label}
            </a>
          );
        })}
      </nav>
    </header>

    <!-- Main Content -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-800/80 bg-[#04070e] mt-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 text-xs text-slate-400">
        <div class="space-y-1.5">
          <div class="flex items-center gap-2 font-mono text-slate-200 font-semibold">
            <span class="text-cyan-400">VECTOR 87</span>
            <span>//</span>
            <span>{t.footer.subtitle}</span>
          </div>
          <p class="text-slate-400 max-w-xl">
            {t.footer.description}
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-5 font-mono text-xs">
          <a href={enHref} class:list={[lang === 'en' ? 'text-cyan-300 font-semibold' : 'hover:text-cyan-300']}>
            EN
          </a>
          <a href={csHref} class:list={[lang === 'cs' ? 'text-cyan-300 font-semibold' : 'hover:text-cyan-300']}>
            CS
          </a>
          <span class="text-slate-700">|</span>
          <a href="https://akucera.eu" target="_blank" rel="noopener noreferrer" class="hover:text-cyan-300 transition-colors">
            akucera.eu ↗
          </a>
          <a href="https://www.linkedin.com/in/antoninkucera/" target="_blank" rel="noopener noreferrer" class="hover:text-cyan-300 transition-colors">
            LinkedIn ↗
          </a>
          <a href="https://x.com/antkucera" target="_blank" rel="noopener noreferrer" class="hover:text-cyan-300 transition-colors">
            X (@antkucera) ↗
          </a>
          <a href="https://github.com/antoninkucera/vector87" target="_blank" rel="noopener noreferrer" class="hover:text-cyan-300 transition-colors">
            GitHub ↗
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
