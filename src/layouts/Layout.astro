---
import '../styles/global.css';
import marketData from '../data/market-data.json';

interface Props {
  title?: string;
  description?: string;
  activeNav?: 'dashboard' | 'roles' | 'gcp' | 'academy' | 'about';
}

const {
  title = 'Vector87 — Quantitative Intelligence for the AI & Data Job Market',
  description = 'Analytický datový hub monitorující stav AI, ML a datového trhu práce v S&P 500, USA a Evropě.',
  activeNav = 'dashboard',
} = Astro.props;

const navItems = [
  { id: 'dashboard', label: '01 / Market Dashboard', href: '/' },
  { id: 'roles', label: '02 / Analýza rolí', href: '/roles' },
  { id: 'gcp', label: '03 / Google Cloud Hub', href: '/gcp-hub' },
  { id: 'academy', label: '04 / Vzdělávací akademie', href: '/academy' },
  { id: 'about', label: '05 / O autorovi', href: '/about' },
] as const;

const { meta, market_vitality } = marketData;
---

<!doctype html>
<html lang="cs" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="text-slate-100 antialiased selection:bg-cyan-400/20 selection:text-cyan-200 flex flex-col min-h-screen">
    <!-- Top Live Telemetry Bar -->
    <div class="border-b border-slate-800/80 bg-[#04070e]/90 text-[11px] font-mono text-slate-400">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-1.5 flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-4">
          <span class="inline-flex items-center gap-1.5 text-cyan-400 font-semibold">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            TELEMETRY: ONLINE
          </span>
          <span class="hidden sm:inline text-slate-600">|</span>
          <span class="hidden sm:inline">
            SNAPSHOT: <strong class="text-slate-200">{meta.latest_snapshot_date}</strong>
          </span>
          <span class="text-slate-600">|</span>
          <span>
            ACTIVE AI/DATA JOBS: <strong class="text-cyan-300">{market_vitality.total_ai_data_jobs.toLocaleString('en-US')}</strong>
          </span>
        </div>
        <div class="flex items-center gap-4">
          <span>
            S&amp;P 500 COVERAGE: <strong class="text-slate-200">{meta.sp500_tracked_companies}</strong> FIRMS
          </span>
          <span class="hidden md:inline text-slate-600">|</span>
          <span class="hidden md:inline">
            INTENSITY: <strong class="text-emerald-400">{market_vitality.sp500_ai_intensity_pct}%</strong> OF TOTAL HIRING POOL
          </span>
        </div>
      </div>
    </div>

    <!-- Main Navigation Header -->
    <header class="sticky top-0 z-40 border-b border-slate-800/80 bg-[#060911]/85 backdrop-blur-md">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-cyan-500/20 to-blue-600/20 border border-cyan-400/40 flex items-center justify-center font-mono font-bold text-cyan-300 tracking-tighter text-sm group-hover:border-cyan-300 transition-colors">
            V87
          </div>
          <div>
            <div class="flex items-baseline gap-1.5">
              <span class="font-bold tracking-tight text-lg text-white">VECTOR</span>
              <span class="font-mono font-bold text-lg text-cyan-400">87</span>
            </div>
            <p class="text-[10px] font-mono uppercase tracking-widest text-slate-400 -mt-1">
              Data &amp; AI Market Direction
            </p>
          </div>
        </a>

        <nav aria-label="Hlavní navigace" class="hidden lg:flex items-center gap-1">
          {navItems.map((item) => {
            const isActive = activeNav === item.id;
            return (
              <a
                href={item.href}
                class:list={[
                  'px-3.5 py-2 rounded-md text-xs font-mono transition-colors',
                  isActive
                    ? 'bg-cyan-500/15 text-cyan-300 border border-cyan-500/40 font-semibold'
                    : 'text-slate-300 hover:text-white hover:bg-slate-800/60 border border-transparent',
                ]}
              >
                {item.label}
              </a>
            );
          })}
        </nav>

        <div class="flex items-center gap-2.5">
          <a
            href="https://akucera.eu"
            target="_blank"
            rel="noopener noreferrer"
            class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-mono border border-slate-700/80 bg-slate-900/80 text-slate-300 hover:border-cyan-400/50 hover:text-cyan-300 transition-colors"
          >
            <span>akucera.eu</span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <!-- Mobile Horizontal Nav -->
      <nav aria-label="Mobilní navigace" class="lg:hidden border-t border-slate-800/60 px-4 py-2 flex items-center gap-2 overflow-x-auto">
        {navItems.map((item) => {
          const isActive = activeNav === item.id;
          return (
            <a
              href={item.href}
              class:list={[
                'px-2.5 py-1.5 rounded text-[11px] font-mono whitespace-nowrap',
                isActive
                  ? 'bg-cyan-500/15 text-cyan-300 border border-cyan-500/40 font-semibold'
                  : 'text-slate-400 hover:text-slate-200',
              ]}
            >
              {item.label}
            </a>
          );
        })}
      </nav>
    </header>

    <!-- Main Content -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-800/80 bg-[#04070e] mt-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 text-xs text-slate-400">
        <div class="space-y-1.5">
          <div class="flex items-center gap-2 font-mono text-slate-200 font-semibold">
            <span class="text-cyan-400">VECTOR 87</span>
            <span>//</span>
            <span>Analytical Telemetry Hub</span>
          </div>
          <p class="text-slate-400 max-w-xl">
            Statický datový hub monitorující globální poptávku po datových a AI expertech napříč S&amp;P 500, Severní Amerikou a Evropou. Poháněno lokální DuckDB pipeline a Astro SSG.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-5 font-mono text-xs">
          <a href="https://akucera.eu" target="_blank" rel="noopener noreferrer" class="hover:text-cyan-300 transition-colors">
            akucera.eu ↗
          </a>
          <a href="https://www.linkedin.com/in/antoninkucera/" target="_blank" rel="noopener noreferrer" class="hover:text-cyan-300 transition-colors">
            LinkedIn ↗
          </a>
          <a href="https://github.com/antoninkucera/vector87" target="_blank" rel="noopener noreferrer" class="hover:text-cyan-300 transition-colors">
            GitHub ↗
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
