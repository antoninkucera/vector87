---
import Layout from '../layouts/Layout.astro';
import { ui } from '../i18n/ui';

const t = ui.en;
---

<Layout
  title="404 | Page Not Found | Vector87"
  description="The requested page or telemetry signal could not be located in the Vector87 analytical warehouse."
  activeNav="dashboard"
  lang="en"
>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-24 text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-semibold bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 mb-6">
      <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
      SIGNAL NOT FOUND // ERROR 404
    </div>

    <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight font-mono mb-4">
      404 // DEAD TELEMETRY
    </h1>

    <p class="text-slate-400 text-base sm:text-lg max-w-xl mx-auto mb-10 leading-relaxed">
      The requested endpoint or role profile does not exist in our static intelligence snapshot.
      Please verify the URL or return to the live market dashboard.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="/"
        class="px-6 py-3 rounded-lg bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold font-mono text-sm transition-colors shadow-lg shadow-cyan-500/20"
      >
        MARKET DASHBOARD →
      </a>
      <a
        href="/roles"
        class="px-6 py-3 rounded-lg bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-700 font-mono text-sm transition-colors"
      >
        EXPLORE 21 ROLES
      </a>
      <a
        href="/cloud-tech"
        class="px-6 py-3 rounded-lg bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-700 font-mono text-sm transition-colors"
      >
        CLOUD STACK
      </a>
    </div>
  </main>
</Layout>
