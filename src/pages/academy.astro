---
import Layout from '../layouts/Layout.astro';

const tracks = [
  {
    code: 'TRACK 01',
    title: 'Analytics & Modern BI Engineering',
    level: 'Foundational → Senior IC',
    focus: 'Přechod od ad-hoc reportingu k inženýrsky řízené analytice, sémantickým vrstvám a Data-Informed rozhodování.',
    modules: [
      'Pokročilé analytické SQL (Window functions, CTEs, optimalizace exekučních plánů v BigQuery/Snowflake)',
      'Analytics Engineering: verzování datových modelů v dbt a Dataform (SQLX), automatizované testy kvality dat',
      'Návrh sémantické vrstvy (Semantic Layer / LookML / MetricFlow) jako prevence nekonzistentních KPI',
      'Produktová a byznysová analytika: kauzální uvažování, kohortové analýzy a komunikace se stakeholdery',
    ],
  },
  {
    code: 'TRACK 02',
    title: 'Cloud Data Engineering & Lakehouse Architecture',
    level: 'Mid → Staff / Architect',
    focus: 'Budování škálovatelných datových platforem, distribuovaných pipeline a spolehlivé infrastruktury.',
    modules: [
      'Python a softwarové inženýrství pro dataře (typování, testování, CI/CD, kontejnerizace v Dockeru)',
      'Distribuované zpracování a streaming: Apache Spark, Databricks, Google Cloud Dataflow',
      'Moderní úložiště a otevřené tabulkové formáty: Apache Iceberg, Delta Lake, BigLake',
      'Orchestrace, Data Contracts a Data Governance ve velkých organizacích',
    ],
  },
  {
    code: 'TRACK 03',
    title: 'Applied AI, LLM Systems & Agentic Engineering',
    level: 'Mid → Principal AI Engineer',
    focus: 'Návrh, evaluace a produkční provoz aplikací postavených na foundation modelech a autonomních agentech.',
    modules: [
      'Architektura RAG systémů: chunking strategie, hybridní vyhledávání a vektorové databáze',
      'Agentic AI workflows: nástrojové volání (tool use), multi-agentní orchestrace (LangGraph, Vertex AI)',
      'LLMOps & Evals: systematické měření halucinací, latence, regrese kvality a nasazení guardrails',
      'Fine-tuning (LoRA/QLoRA) vs. in-context learning a ekonomika provozu LLM v produkci',
    ],
  },
];

const books = [
  {
    title: 'Designing Data-Intensive Applications',
    author: 'Martin Kleppmann',
    category: 'Data Systems & Architecture',
    why: 'Základní bible pro pochopení distribuovaných datových systémů, replikace, konsistence a stream processingu.',
  },
  {
    title: 'Fundamentals of Data Engineering',
    author: 'Joe Reis & Matt Housley',
    category: 'Data Engineering',
    why: 'Systematický rámec životního cyklu datového inženýrství nezávislý na konkrétních módních nástrojích.',
  },
  {
    title: 'AI Engineering: Building Applications with Foundation Models',
    author: 'Chip Huyen',
    category: 'Applied AI & LLMOps',
    why: 'Praktický inženýrský pohled na hodnocení (evals), RAG, fine-tuning a produkční nasazování foundation modelů.',
  },
  {
    title: 'Google BigQuery: The Definitive Guide',
    author: 'Valliappa Lakshmanan & Jordan Tigani',
    category: 'Google Cloud / DWH',
    why: 'Hluboký vhled do interní architektury Dremelu, Colossusu a psaní vysoce efektivních analytických dotazů.',
  },
];
---

<Layout
  title="Vzdělávací akademie — Vector87 | Studijní cesty, literatura a Best Practices"
  activeNav="academy"
>
  <section class="mb-10 pb-8 border-b border-slate-800/80">
    <div class="max-w-3xl space-y-3">
      <span class="text-xs font-mono uppercase tracking-widest text-cyan-400">04 // KURÁTOROVANÉ VZDĚLÁVÁNÍ</span>
      <h1 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">
        Vzdělávací akademie &amp; Studijní cesty
      </h1>
      <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
        Rozcestník sestavený přímo podle reálné poptávky S&amp;P 500 firem z naší telemetrie. Namísto nahodilých tutoriálů se soustředí na architektonické základy, inženýrskou disciplínu a schopnost doručovat měřitelnou hodnotu.
      </p>
    </div>
  </section>

  <!-- 3 Studijní cesty -->
  <section class="mb-14">
    <h2 class="text-xl font-bold text-white mb-5">Strukturované studijní dráhy (Learning Tracks)</h2>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      {tracks.map((tr) => (
        <div class="panel-surface rounded-xl p-6 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2 text-xs font-mono">
              <span class="text-cyan-400 font-bold">{tr.code}</span>
              <span class="px-2 py-0.5 rounded bg-slate-900 text-slate-300 border border-slate-800">
                {tr.level}
              </span>
            </div>
            <h3 class="text-lg font-bold text-white mt-3">{tr.title}</h3>
            <p class="text-xs text-slate-300 mt-2 leading-relaxed">{tr.focus}</p>

            <ul class="mt-5 space-y-2.5 border-t border-slate-800/80 pt-4">
              {tr.modules.map((mod) => (
                <li class="text-xs text-slate-200 flex items-start gap-2 leading-relaxed">
                  <span class="text-cyan-400 font-mono mt-0.5">→</span>
                  <span>{mod}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Doporučená literatura -->
  <section class="mb-12">
    <h2 class="text-xl font-bold text-white mb-5">Základní knihovna datového architekta a AI inženýra</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {books.map((b) => (
        <div class="panel-surface-interactive rounded-xl p-5">
          <div class="flex items-center justify-between gap-2">
            <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded bg-cyan-500/10 text-cyan-300 border border-cyan-500/30">
              {b.category}
            </span>
            <span class="text-xs font-mono text-slate-400">{b.author}</span>
          </div>
          <h3 class="text-base font-bold text-white mt-2">{b.title}</h3>
          <p class="text-xs text-slate-300 mt-2 leading-relaxed">{b.why}</p>
        </div>
      ))}
    </div>
  </section>
</Layout>
