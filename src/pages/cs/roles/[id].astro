---
import RoleDetailView from '../../../components/views/RoleDetailView.astro';
import marketData from '../../../data/market-data.json';

export async function getStaticPaths() {
  const paths: any[] = [];
  for (const role of marketData.roles) {
    const kebabSlug = role.category_id.replace(/_/g, '-');
    paths.push({
      params: { id: kebabSlug },
      props: { roleId: role.category_id, isAlias: false },
    });
    paths.push({
      params: { id: role.category_id },
      props: { roleId: role.category_id, isAlias: true, targetSlug: kebabSlug },
    });
  }
  return paths;
}

interface Props {
  roleId: string;
  isAlias: boolean;
  targetSlug?: string;
}

const { roleId, isAlias, targetSlug } = Astro.props;

if (isAlias && targetSlug) {
  return Astro.redirect(`/cs/roles/${targetSlug}`, 301);
}
---

<RoleDetailView lang="cs" roleId={roleId} />
