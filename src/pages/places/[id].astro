---
import { getAllCountryStaticPaths } from '../../data/places';

export async function getStaticPaths() {
  return getAllCountryStaticPaths();
}

interface Props {
  countryMeta: any;
  targetSlug?: string;
}

const { countryMeta, targetSlug } = Astro.props;
const destination = targetSlug || countryMeta.slug;
return Astro.redirect(`/countries/${destination}/`, 301);
---
