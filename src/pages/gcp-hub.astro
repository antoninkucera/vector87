---
import Layout from '../layouts/Layout.astro';
import MarketTrendChart from '../components/MarketTrendChart.astro';
import marketData from '../data/market-data.json';

const { gcp_hub } = marketData;

const gcpNotes = [
  {
    service: 'BigQuery & BigLake',
    tag: 'Serverless Lakehouse',
    summary:
      'Základní analytický motor na GCP. V podnikových architekturách dominuje díky oddělení výpočetní kapacity od úložiště, nativní podpoře Apache Iceberg přes BigLake a přímému volání LLM/ML modelů z SQL (BigQuery ML).',
    linkLabel: 'BigQuery Deep-Dives na akucera.eu',
    href: 'https://akucera.eu',
  },
  {
    service: 'Vertex AI & Agent Builder',
    tag: 'Enterprise GenAI & MLOps',
    summary:
      'Sjednocená platforma pro nasazování Gemini i open-weight modelů, správu vektorového vyhledávání (Vector Search), evaluaci výstupů (Rapid Evaluation API) a orchestraci produkčních AI agentů.',
    linkLabel: 'Dokumentace Vertex AI',
    href: 'https://cloud.google.com/vertex-ai/docs',
  },
  {
    service: 'Dataform (v BigQuery)',
    tag: 'SQLX Analytics Engineering',
    summary:
      'Nativní orchestrátor ELT transformací v BigQuery postavený na SQLX. Umožňuje verzovat datové modely v Gitu, vynucovat data quality assertions a stavět závislosti bez nutnosti spravovat externí instanci.',
    linkLabel: 'Dataform Best Practices',
    href: 'https://cloud.google.com/dataform/docs',
  },
  {
    service: 'Looker & Semantic Layer',
    tag: 'Governed BI & LookML',
    summary:
      'Kritická sémantická vrstva (LookML), která definuje jednotné byznysové metriky napříč organizací. V éře GenAI slouží jako spolehlivý kontext, který brání halucinacím při dotazování nad firemními daty.',
    linkLabel: 'Článek: Proč je Data-Informed víc než Data-Driven',
    href: 'https://akucera.eu/no-blueprint-exists-why-ai-made-me-double-down-on-being-data-informed/',
  },
];
---

<Layout
  title="Google Cloud Hub — Vector87 | BigQuery, Vertex AI, Dataform & Looker Telemetry"
  activeNav="gcp"
>
  <section class="mb-10 pb-8 border-b border-slate-800/80">
    <div class="max-w-3xl space-y-3">
      <span class="text-xs font-mono uppercase tracking-widest text-cyan-400">03 // SPECIALIZOVANÁ TELEMETRIE</span>
      <h1 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">
        Google Cloud (GCP) Data &amp; AI Hub
      </h1>
      <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
        Detailní sledování adopce služeb Google Cloud Platform v datových a AI inzerátech — od analytického jádra <strong>BigQuery</strong> a transformací v <strong>Dataformu</strong> přes <strong>Dataflow</strong> a <strong>Looker</strong> až po generativní platformu <strong>Vertex AI</strong>.
      </p>
    </div>
  </section>

  <!-- GCP KPIs -->
  <section class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
    <div class="panel-surface rounded-xl p-5 border-l-2 border-l-cyan-400">
      <p class="text-xs font-mono uppercase text-slate-400">Pozice v GCP ekosystému</p>
      <p class="text-3xl font-bold font-mono text-white mt-2">
        {gcp_hub.total_gcp_ecosystem_jobs.toLocaleString('en-US')}
      </p>
      <p class="text-xs font-mono text-slate-400 mt-1">
        Aktivní inzeráty zmiňující alespoň jednu GCP datovou/AI službu
      </p>
    </div>

    <div class="panel-surface rounded-xl p-5 border-l-2 border-l-blue-500">
      <p class="text-xs font-mono uppercase text-slate-400">Podíl na celkovém trhu</p>
      <p class="text-3xl font-bold font-mono text-cyan-300 mt-2">
        {gcp_hub.gcp_share_of_all_jobs_pct}%
      </p>
      <p class="text-xs font-mono text-slate-400 mt-1">
        Ze všech sledovaných AI &amp; Data inzerátů
      </p>
    </div>

    <div class="panel-surface rounded-xl p-5 border-l-2 border-l-emerald-400">
      <p class="text-xs font-mono uppercase text-slate-400">Podíl mezi cloudovými inzeráty</p>
      <p class="text-3xl font-bold font-mono text-emerald-400 mt-2">
        {gcp_hub.gcp_share_of_cloud_jobs_pct}%
      </p>
      <p class="text-xs font-mono text-slate-400 mt-1">
        Z pozic, které explicitně uvádějí cloudovou platformu
      </p>
    </div>
  </section>

  <!-- Grafy GCP služeb a rolí -->
  <section class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-10">
    <MarketTrendChart
      chartId="chart-gcp-services"
      title="Poptávka po konkrétních službách Google Cloud"
      subtitle="Počet aktivních inzerátů v aktuálním snapshotu"
      badge="GCP STACK"
      type="bar"
      labels={gcp_hub.services.map((s) => s.service_name)}
      datasets={[
        {
          label: 'Počet pozic',
          data: gcp_hub.services.map((s) => s.job_count),
          backgroundColor: 'rgba(34, 211, 238, 0.8)',
          borderColor: '#22d3ee',
          borderWidth: 1,
          borderRadius: 5,
        },
      ]}
      heightClass="h-72"
    />

    <MarketTrendChart
      chartId="chart-gcp-roles"
      title="Nejčastější role pracující s GCP ekosystémem"
      subtitle="Rozložení kanonických pozic vyžadujících GCP / BigQuery / Vertex AI"
      badge="GCP ROLES"
      type="horizontalBar"
      labels={gcp_hub.top_gcp_roles.map((r) => r.canonical_name)}
      datasets={[
        {
          label: 'Počet GCP pozic',
          data: gcp_hub.top_gcp_roles.map((r) => r.job_count),
          backgroundColor: 'rgba(59, 130, 246, 0.8)',
          borderColor: '#3b82f6',
          borderWidth: 1,
          borderRadius: 4,
        },
      ]}
      heightClass="h-72"
    />
  </section>

  <!-- Karty jednotlivých GCP služeb s párovými technologiemi -->
  <section class="mb-12">
    <h2 class="text-xl font-bold text-white mb-4">Detailní telemetrie sledovaných GCP služeb</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {gcp_hub.services.map((svc) => (
        <div class="panel-surface rounded-xl p-5 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2">
              <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded bg-cyan-500/10 text-cyan-300 border border-cyan-500/30">
                {svc.category}
              </span>
              <span class="text-xs font-mono text-slate-400">
                {svc.penetration_in_gcp_pct}% GCP pozic
              </span>
            </div>
            <h3 class="text-lg font-bold text-white mt-2">{svc.service_name}</h3>
            <p class="text-2xl font-mono font-bold text-cyan-300 mt-1">
              {svc.job_count.toLocaleString('en-US')}{' '}
              <span class="text-xs font-normal text-slate-400">inzerátů ({svc.penetration_all_pct}% trhu)</span>
            </p>
          </div>

          <div class="mt-4 pt-3 border-t border-slate-800/80">
            <p class="text-[10px] font-mono uppercase text-slate-400 mb-1.5">Nejčastěji párováno s:</p>
            <div class="flex flex-wrap gap-1.5">
              {svc.top_paired_skills.map((ps) => (
                <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-slate-900 text-slate-200 border border-slate-800">
                  {ps}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Architektonické recenze a testování služeb -->
  <section class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-4">
      <h2 class="text-xl font-bold text-white">Architektonické poznámky, testování služeb a praxe</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {gcpNotes.map((item) => (
          <div class="panel-surface-interactive rounded-xl p-5 flex flex-col justify-between">
            <div>
              <span class="text-[10px] font-mono uppercase text-cyan-400">{item.tag}</span>
              <h3 class="text-base font-bold text-white mt-1">{item.service}</h3>
              <p class="text-xs text-slate-300 mt-2 leading-relaxed">{item.summary}</p>
            </div>
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 inline-flex items-center gap-1 text-xs font-mono text-cyan-300 hover:text-cyan-200"
            >
              <span>{item.linkLabel}</span>
              <span>↗</span>
            </a>
          </div>
        ))}
      </div>
    </div>

    <!-- Top GCP zaměstnavatelé -->
    <div class="panel-surface rounded-xl p-5">
      <h3 class="text-sm font-semibold text-white mb-1">Top 10 korporací poptávajících GCP</h3>
      <p class="text-xs text-slate-400 mb-4">Podle počtu otevřených inzerátů s GCP stackem</p>
      <div class="space-y-2.5">
        {gcp_hub.top_gcp_companies.map((comp, idx) => (
          <div class="flex items-center justify-between p-2.5 rounded-lg bg-slate-900/80 border border-slate-800/80 text-xs">
            <div class="truncate pr-2">
              <span class="font-mono text-slate-500 mr-1.5">#{idx + 1}</span>
              <span class="font-medium text-slate-200">{comp.company_name}</span>
            </div>
            <span class="font-mono font-bold text-cyan-300 shrink-0">{comp.job_count} pozic</span>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
