---
import type { Locale } from '../i18n/ui';
import type { OpportunityCountry } from '../data/opportunity-matrix';

interface Props {
  chartId: string;
  title: string;
  subtitle?: string;
  badge?: string;
  lang: Locale;
  countries: OpportunityCountry[];
}

const {
  chartId,
  title,
  subtitle,
  badge = 'FUTURE TRACKER',
  lang,
  countries,
} = Astro.props;

// Radius helper based on AI/Data jobs volume
const calcRadius = (jobs: number) => Math.max(5, Math.min(22, Math.round(4 + Math.sqrt(jobs) * 0.24)));

const jobsByIso3 = Object.fromEntries(countries.map((c) => [c.iso3, c.activeJobs]));
const usJobs = jobsByIso3.USA ?? 4508;
const caJobs = jobsByIso3.CAN ?? 591;
const ukJobs = jobsByIso3.GBR ?? 1232;
const esJobs = jobsByIso3.ESP ?? 354;

// Split into 3 visual groups for distinct colors and legend
const easyWins = countries
  .filter((c) => c.quadrant === 'easy_win')
  .map((c) => ({
    x: c.easeOfRelocation,
    y: c.livability,
    r: calcRadius(c.activeJobs),
    name: lang === 'cs' ? c.nameCs : c.name,
    iso3: c.iso3,
    easeOfRelocation: c.easeOfRelocation,
    livability: c.livability,
    activeJobs: c.activeJobs,
    hiringCompanies: c.hiringCompanies,
    topRoles: lang === 'cs' ? c.topRolesFormattedCs : c.topRolesFormattedEn,
    thrivingScore: c.thrivingScore,
    safety: c.safety,
    housing: c.housing,
    economy: c.economy,
    note: lang === 'cs' ? c.relocationNoteCs : c.relocationNoteEn,
  }));

const highReward = countries
  .filter((c) => c.quadrant === 'high_reward')
  .map((c) => ({
    x: c.easeOfRelocation,
    y: c.livability,
    r: calcRadius(c.activeJobs),
    name: lang === 'cs' ? c.nameCs : c.name,
    iso3: c.iso3,
    easeOfRelocation: c.easeOfRelocation,
    livability: c.livability,
    activeJobs: c.activeJobs,
    hiringCompanies: c.hiringCompanies,
    topRoles: lang === 'cs' ? c.topRolesFormattedCs : c.topRolesFormattedEn,
    thrivingScore: c.thrivingScore,
    safety: c.safety,
    housing: c.housing,
    economy: c.economy,
    note: lang === 'cs' ? c.relocationNoteCs : c.relocationNoteEn,
  }));

const lifestyleHavens = countries
  .filter((c) => c.quadrant === 'lifestyle_haven')
  .map((c) => ({
    x: c.easeOfRelocation,
    y: c.livability,
    r: calcRadius(c.activeJobs),
    name: lang === 'cs' ? c.nameCs : c.name,
    iso3: c.iso3,
    easeOfRelocation: c.easeOfRelocation,
    livability: c.livability,
    activeJobs: c.activeJobs,
    hiringCompanies: c.hiringCompanies,
    topRoles: lang === 'cs' ? c.topRolesFormattedCs : c.topRolesFormattedEn,
    thrivingScore: c.thrivingScore,
    safety: c.safety,
    housing: c.housing,
    economy: c.economy,
    note: lang === 'cs' ? c.relocationNoteCs : c.relocationNoteEn,
  }));

const labels = {
  easyWin:
    lang === 'cs'
      ? 'Easy Wins (Volný pohyb + Špičková kvalita života)'
      : 'Easy Wins (Free Movement + Top Livability)',
  highReward:
    lang === 'cs'
      ? 'High Friction / High Reward (Globální giganti, vízové kvóty)'
      : 'High Friction / High Reward (Top Markets, Visa Quotas)',
  lifestyleHaven:
    lang === 'cs'
      ? 'Lifestyle & Remote Havens (Maximální nomádská dostupnost, klima)'
      : 'Lifestyle & Remote Havens (Top Nomad Visas, Coastal)',
  modeRelocation:
    lang === 'cs'
      ? 'Mobility & Livability (Bubliny = Objem AI/Data trhu)'
      : 'Mobility & Livability (Bubble = AI/Data Market Size)',
  modeMarket:
    lang === 'cs'
      ? 'AI/Data Poptávka vs. Životní úroveň (Log osa)'
      : 'AI/Data Demand vs. Livability (Log Scale)',
  xAxisReloc:
    lang === 'cs'
      ? 'Snadnost přesunu a pracovní povolení (0–100)'
      : 'Ease of Relocation & Work Permit Index (0–100)',
  xAxisJobs:
    lang === 'cs'
      ? 'Aktivní otevřené AI/Data pozice v korporacích (log osa)'
      : 'Active Enterprise AI/Data Openings (Log Scale)',
  yAxis:
    lang === 'cs'
      ? 'Index kvality života & stability (0–100)'
      : 'Composite Livability & Stability Score (0–100)',
  marketWord: lang === 'cs' ? 'AI & Data trh' : 'AI & Data Market',
  jobsWord: lang === 'cs' ? 'otevřených pozic' : 'roles',
  firmsWord: lang === 'cs' ? 'zaměstnavatelů' : 'employers',
  relocWord: lang === 'cs' ? 'Dostupnost přesunu' : 'Relocation Ease',
  scoreWord: lang === 'cs' ? 'Kvalita života' : 'Livability Score',
  thrivingWord: lang === 'cs' ? 'Index uplatnění (AI Thriving)' : 'AI Thriving Index',
  rolesWord: lang === 'cs' ? 'Klíčové role' : 'Top Roles',
  safetyWord: lang === 'cs' ? 'Bezpečnost' : 'Safety',
  housingWord: lang === 'cs' ? 'Bydlení' : 'Housing',
  economyWord: lang === 'cs' ? 'Ekonomika' : 'Economy',
  noteWord: lang === 'cs' ? 'Vízový režim' : 'Visa & Mobility',
  bubbleNote:
    lang === 'cs'
      ? 'Velikost bubliny odpovídá objemu otevřených AI/Data pozic v korporátních ATS systémech.'
      : 'Bubble diameter represents active AI/Data postings across enterprise corporate ATS boards.',
};

const payload = JSON.stringify({
  labels,
  datasets: [
    {
      label: labels.easyWin,
      data: easyWins,
      backgroundColor: 'rgba(16, 185, 129, 0.85)',
      borderColor: '#10b981',
      borderWidth: 1.5,
    },
    {
      label: labels.highReward,
      data: highReward,
      backgroundColor: 'rgba(6, 182, 212, 0.85)',
      borderColor: '#06b6d4',
      borderWidth: 1.5,
    },
    {
      label: labels.lifestyleHaven,
      data: lifestyleHavens,
      backgroundColor: 'rgba(129, 140, 248, 0.75)',
      borderColor: '#818cf8',
      borderWidth: 1.5,
    },
  ],
});
---

<div class="panel-surface rounded-xl p-5 flex flex-col justify-between border border-slate-800">
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-4">
    <div>
      <div class="flex items-center gap-2">
        <h3 class="text-sm font-semibold text-white tracking-tight">{title}</h3>
        {badge && (
          <span class="px-2 py-0.5 rounded text-[10px] font-mono uppercase tracking-wider bg-emerald-500/10 text-emerald-300 border border-emerald-500/30">
            {badge}
          </span>
        )}
      </div>
      {subtitle && <p class="text-xs text-slate-400 mt-0.5">{subtitle}</p>}
    </div>

    <!-- Controls & Actions -->
    <div class="flex items-center gap-2 shrink-0">
      <!-- Dual Mode Toggle -->
      <div class="inline-flex p-1 bg-slate-900 border border-slate-800 rounded-lg text-xs font-mono">
        <button
          type="button"
          id={`${chartId}-btn-reloc`}
          class="px-3 py-1 rounded-md transition-all font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30"
          data-mode="relocation"
        >
          {labels.modeRelocation}
        </button>
        <button
          type="button"
          id={`${chartId}-btn-market`}
          class="px-3 py-1 rounded-md transition-all text-slate-400 hover:text-white"
          data-mode="market"
        >
          {labels.modeMarket}
        </button>
      </div>

      <!-- Action: Export Branded PNG -->
      <button
        type="button"
        class="v87-matrix-export-btn p-1.5 rounded-lg text-slate-400 hover:text-cyan-300 hover:bg-slate-800/80 border border-transparent hover:border-slate-700/60 transition-all cursor-pointer"
        data-chart-id={chartId}
        data-title={title}
        data-subtitle={subtitle || ''}
        title="Download branded 16:9 matrix image (PNG)"
        aria-label="Download matrix image"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
      </button>

      <!-- Action: Copy Direct Link -->
      <button
        type="button"
        class="v87-matrix-link-btn p-1.5 rounded-lg text-slate-400 hover:text-cyan-300 hover:bg-slate-800/80 border border-transparent hover:border-slate-700/60 transition-all cursor-pointer"
        data-title={title}
        title="Copy direct link to this matrix"
        aria-label="Copy link"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Dedicated Chart Container for Responsive Chart.js Canvas -->
  <div class="relative w-full h-80 sm:h-96">
    <canvas id={chartId} data-v87-matrix={payload} aria-label={title}></canvas>
  </div>

  <!-- Quadrant Explanation Footnotes -->
  <div class="mt-4 pt-3 border-t border-slate-800/80 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-[11px] font-mono">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 flex-1">
      <div class="flex items-center gap-2 text-slate-300">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 shrink-0"></span>
        <span class="text-slate-400">
          <strong class="text-emerald-300">Easy Wins:</strong> {lang === 'cs' ? 'Švýcarsko, Nizozemsko, Rakousko, Česko, Irsko, Skandinávie' : 'Switzerland, Netherlands, Austria, Czechia, Ireland, Nordics'}
        </span>
      </div>
      <div class="flex items-center gap-2 text-slate-300">
        <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 shrink-0"></span>
        <span class="text-slate-400">
          <strong class="text-cyan-300">High Friction / High Reward:</strong> {lang === 'cs' ? `USA (${usJobs.toLocaleString('cs-CZ')} pozic, loterie H-1B), Kanada (${caJobs.toLocaleString('cs-CZ')}), UK (${ukJobs.toLocaleString('cs-CZ')})` : `USA (${usJobs.toLocaleString('en-US')} jobs, H-1B lottery), Canada (${caJobs.toLocaleString('en-US')}), UK (${ukJobs.toLocaleString('en-US')})`}
        </span>
      </div>
      <div class="flex items-center gap-2 text-slate-300">
        <span class="w-2.5 h-2.5 rounded-full bg-indigo-400 shrink-0"></span>
        <span class="text-slate-400">
          <strong class="text-indigo-300">Lifestyle Havens:</strong> {lang === 'cs' ? `Španělsko (${esJobs.toLocaleString('cs-CZ')} rolí, Beckham Law), Portugalsko (D8 vízum)` : `Spain (${esJobs.toLocaleString('en-US')} jobs, Beckham Law), Portugal (D8 visa)`}
        </span>
      </div>
    </div>
    <div class="text-[10px] text-slate-500 font-mono italic sm:text-right shrink-0">
      💡 {labels.bubbleNote}
    </div>
  </div>

  <!-- Accessible Table Fallback for Screen Readers -->
  <div class="sr-only">
    <table>
      <caption>{title}</caption>
      <thead>
        <tr>
          <th scope="col">Country</th>
          <th scope="col">Ease of Relocation</th>
          <th scope="col">Livability Score</th>
          <th scope="col">Active AI/Data Jobs</th>
          <th scope="col">AI Thriving Score</th>
        </tr>
      </thead>
      <tbody>
        {countries.map((c) => (
          <tr>
            <th scope="row">{c.name}</th>
            <td>{c.easeOfRelocation}</td>
            <td>{c.livability}</td>
            <td>{c.activeJobs}</td>
            <td>{c.thrivingScore}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>

<script>
  import Chart from 'chart.js/auto';
  import { exportChartAsBrandedPng, copyLinkToClipboard } from '../utils/telemetryExport';

  function initMatrixActions() {
    document.querySelectorAll<HTMLButtonElement>('.v87-matrix-export-btn').forEach((btn) => {
      if (btn.getAttribute('data-v87-bound')) return;
      btn.setAttribute('data-v87-bound', 'true');

      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const chartId = btn.getAttribute('data-chart-id');
        const title = btn.getAttribute('data-title') || 'Global Relocation Matrix';
        const subtitle = btn.getAttribute('data-subtitle') || undefined;
        if (!chartId) return;
        const canvas = document.getElementById(chartId) as HTMLCanvasElement | null;
        if (canvas) {
          const isCs = window.location.pathname.startsWith('/cs');
          exportChartAsBrandedPng(canvas, title, subtitle, isCs ? 'cs' : 'en');
        }
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.v87-matrix-link-btn').forEach((btn) => {
      if (btn.getAttribute('data-v87-bound')) return;
      btn.setAttribute('data-v87-bound', 'true');

      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const isCs = window.location.pathname.startsWith('/cs');
        copyLinkToClipboard(undefined, isCs ? 'cs' : 'en');
      });
    });
  }

  function initOpportunityMatrix() {
    initMatrixActions();
    const canvases = document.querySelectorAll<HTMLCanvasElement>('canvas[data-v87-matrix]');
    canvases.forEach((canvas) => {
      try {
        const raw = canvas.getAttribute('data-v87-matrix');
        if (!raw) return;

        const existing = Chart.getChart(canvas);
        if (existing) {
          existing.destroy();
        }

        const cfg = JSON.parse(raw);
        const labels = cfg.labels;
        let currentMode: 'relocation' | 'market' = 'relocation';

        const chart = new Chart(canvas, {
          type: 'bubble',
          data: {
            datasets: cfg.datasets,
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: {
                display: true,
                position: 'bottom',
                labels: {
                  color: '#cbd5e1',
                  font: { family: "'JetBrains Mono', monospace", size: 10 },
                  boxWidth: 10,
                  padding: 12,
                },
              },
              tooltip: {
                backgroundColor: 'rgba(6, 9, 17, 0.96)',
                titleColor: '#f8fafc',
                bodyColor: '#e2e8f0',
                borderColor: 'rgba(16, 185, 129, 0.4)',
                borderWidth: 1,
                padding: 12,
                titleFont: { family: "'Inter', sans-serif", size: 13, weight: 'bold' },
                bodyFont: { family: "'JetBrains Mono', monospace", size: 11 },
                callbacks: {
                  title: (items) => {
                    const rawItem = items[0]?.raw as any;
                    return rawItem ? `${rawItem.name} (${rawItem.iso3})` : '';
                  },
                  label: (ctx) => {
                    const rawItem = ctx.raw as any;
                    if (!rawItem) return '';
                    const jobsStr = rawItem.activeJobs?.toLocaleString('en-US') ?? '1';
                    return [
                      ` • 🔥 ${labels.marketWord}: ${jobsStr} ${labels.jobsWord} (${rawItem.hiringCompanies ?? 1} ${labels.firmsWord})`,
                      ` • 🌟 ${labels.thrivingWord}: ${rawItem.thrivingScore} / 100`,
                      ` • 💼 ${labels.rolesWord}: ${rawItem.topRoles}`,
                      ` • 🛂 ${labels.relocWord}: ${rawItem.easeOfRelocation} / 100`,
                      ` • 🏡 ${labels.scoreWord}: ${rawItem.livability} / 100 (${labels.safetyWord}: ${rawItem.safety ?? '—'} | ${labels.housingWord}: ${rawItem.housing ?? '—'})`,
                      ` • ℹ️ ${labels.noteWord}: ${rawItem.note}`,
                    ];
                  },
                },
              },
            },
            scales: {
              x: {
                type: 'linear',
                min: 0,
                max: 105,
                grid: {
                  color: 'rgba(148, 163, 184, 0.08)',
                },
                ticks: {
                  color: '#94a3b8',
                  font: { family: "'JetBrains Mono', monospace", size: 10 },
                  stepSize: 20,
                  callback: (value) => `${value}`,
                },
                title: {
                  display: true,
                  text: labels.xAxisReloc,
                  color: '#64748b',
                  font: { family: "'JetBrains Mono', monospace", size: 11 },
                },
              },
              y: {
                min: 0,
                max: 100,
                grid: {
                  color: 'rgba(148, 163, 184, 0.08)',
                },
                ticks: {
                  color: '#cbd5e1',
                  font: { family: "'JetBrains Mono', monospace", size: 10 },
                  stepSize: 20,
                },
                title: {
                  display: true,
                  text: labels.yAxis,
                  color: '#64748b',
                  font: { family: "'JetBrains Mono', monospace", size: 11 },
                },
              },
            },
          },
        });

        // Setup Mode Switching
        const btnReloc = document.getElementById(`${canvas.id}-btn-reloc`);
        const btnMarket = document.getElementById(`${canvas.id}-btn-market`);

        function updateMode(mode: 'relocation' | 'market') {
          if (mode === currentMode) return;
          currentMode = mode;

          if (mode === 'relocation') {
            btnReloc?.classList.add('bg-emerald-500/20', 'text-emerald-300', 'border', 'border-emerald-500/30');
            btnReloc?.classList.remove('text-slate-400');
            btnMarket?.classList.remove('bg-emerald-500/20', 'text-emerald-300', 'border', 'border-emerald-500/30');
            btnMarket?.classList.add('text-slate-400');

            chart.options.scales!.x!.type = 'linear';
            (chart.options.scales!.x as any).min = 0;
            (chart.options.scales!.x as any).max = 105;
            (chart.options.scales!.y as any).min = 0;
            (chart.options.scales!.y as any).max = 100;
            chart.options.scales!.x!.title!.text = labels.xAxisReloc;
            chart.options.scales!.x!.ticks!.callback = (v: any) => `${v}`;

            chart.data.datasets.forEach((ds: any) => {
              ds.data.forEach((p: any) => {
                p.x = p.easeOfRelocation;
              });
            });
          } else {
            btnMarket?.classList.add('bg-emerald-500/20', 'text-emerald-300', 'border', 'border-emerald-500/30');
            btnMarket?.classList.remove('text-slate-400');
            btnReloc?.classList.remove('bg-emerald-500/20', 'text-emerald-300', 'border', 'border-emerald-500/30');
            btnReloc?.classList.add('text-slate-400');

            const maxActiveJobs = Math.max(
              5000,
              ...chart.data.datasets.flatMap((ds: any) => ds.data.map((p: any) => Number(p.activeJobs) || 1))
            );
            const dynamicLogMax = Math.max(10000, Math.ceil((maxActiveJobs * 1.45) / 1000) * 1000);

            chart.options.scales!.x!.type = 'logarithmic';
            (chart.options.scales!.x as any).min = 1;
            (chart.options.scales!.x as any).max = dynamicLogMax;
            (chart.options.scales!.y as any).min = 0;
            (chart.options.scales!.y as any).max = 100;
            chart.options.scales!.x!.title!.text = labels.xAxisJobs;
            chart.options.scales!.x!.ticks!.callback = (val: any) => {
              if ([1, 10, 50, 100, 500, 1000, 5000, 10000, 20000, 50000].includes(Number(val))) {
                return Number(val).toLocaleString('en-US');
              }
              return null;
            };

            chart.data.datasets.forEach((ds: any) => {
              ds.data.forEach((p: any) => {
                p.x = Math.max(1, p.activeJobs);
              });
            });
          }
          chart.update();
        }

        btnReloc?.addEventListener('click', () => updateMode('relocation'));
        btnMarket?.addEventListener('click', () => updateMode('market'));
      } catch (err) {
        console.error('Error initializing Opportunity Matrix chart on', canvas.id, err);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initOpportunityMatrix);
  } else {
    initOpportunityMatrix();
  }
  window.addEventListener('load', initOpportunityMatrix);
  document.addEventListener('astro:page-load', initOpportunityMatrix);
</script>
