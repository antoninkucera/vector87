---
import type { Locale } from '../i18n/ui';
import type { OpportunityCountry } from '../data/opportunity-matrix';

interface Props {
  chartId: string;
  title: string;
  subtitle?: string;
  badge?: string;
  lang: Locale;
  countries: OpportunityCountry[];
}

const {
  chartId,
  title,
  subtitle,
  badge = 'OPPORTUNITY MATRIX',
  lang,
  countries,
} = Astro.props;

// Split into 3 visual groups for distinct colors and legend
const dreamHubs = countries
  .filter((c) => c.quadrant === 'dream')
  .map((c) => ({
    x: c.jobs,
    y: c.livability,
    name: lang === 'cs' ? c.nameCs : c.name,
    iso3: c.iso3,
    jobs: c.jobs,
    livability: c.livability,
    safety: c.safety,
    housing: c.housing,
    economy: c.economy,
  }));

const volumeGiants = countries
  .filter((c) => c.quadrant === 'power')
  .map((c) => ({
    x: c.jobs,
    y: c.livability,
    name: lang === 'cs' ? c.nameCs : c.name,
    iso3: c.iso3,
    jobs: c.jobs,
    livability: c.livability,
    safety: c.safety,
    housing: c.housing,
    economy: c.economy,
  }));

const lifestyleHavens = countries
  .filter((c) => c.quadrant === 'haven' || c.quadrant === 'developing')
  .map((c) => ({
    x: c.jobs,
    y: c.livability,
    name: lang === 'cs' ? c.nameCs : c.name,
    iso3: c.iso3,
    jobs: c.jobs,
    livability: c.livability,
    safety: c.safety,
    housing: c.housing,
    economy: c.economy,
  }));

const labels = {
  dream: lang === 'cs' ? 'Dream Hubs (Vysoká poptávka + Špičková kvalita života)' : 'Dream Hubs (High Hiring + High Livability)',
  power: lang === 'cs' ? 'Objemoví giganti (Maximální trh, vyšší tlak/náklady)' : 'Volume Giants (Maximum Openings + High Pressure)',
  haven: lang === 'cs' ? 'Lifestyle & Remote ráje (Vysoký komfort, menší trh)' : 'Lifestyle & Remote Havens (High Livability)',
  xAxis: lang === 'cs' ? 'Aktivní otevřené AI/Data pozice (logaritmická osa)' : 'Active AI/Data Job Postings (Logarithmic Scale)',
  yAxis: lang === 'cs' ? 'Index kvality života & stability (0–100)' : 'Composite Livability & Stability Score (0–100)',
  jobsWord: lang === 'cs' ? 'pozic' : 'jobs',
  scoreWord: lang === 'cs' ? 'Skóre života' : 'Livability Score',
  safetyWord: lang === 'cs' ? 'Bezpečnost' : 'Safety',
  housingWord: lang === 'cs' ? 'Bydlení' : 'Housing',
  economyWord: lang === 'cs' ? 'Ekonomika' : 'Economy',
};

const payload = JSON.stringify({
  labels,
  datasets: [
    {
      label: labels.dream,
      data: dreamHubs,
      backgroundColor: 'rgba(16, 185, 129, 0.85)',
      borderColor: '#10b981',
      borderWidth: 1.5,
      pointRadius: 7,
      pointHoverRadius: 10,
    },
    {
      label: labels.power,
      data: volumeGiants,
      backgroundColor: 'rgba(6, 182, 212, 0.85)',
      borderColor: '#06b6d4',
      borderWidth: 1.5,
      pointRadius: 8,
      pointHoverRadius: 11,
    },
    {
      label: labels.haven,
      data: lifestyleHavens,
      backgroundColor: 'rgba(129, 140, 248, 0.75)',
      borderColor: '#818cf8',
      borderWidth: 1.5,
      pointRadius: 6,
      pointHoverRadius: 9,
    },
  ],
});
---

<div class="panel-surface rounded-xl p-5 flex flex-col justify-between border border-slate-800">
  <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3 mb-4">
    <div>
      <div class="flex items-center gap-2">
        <h3 class="text-sm font-semibold text-white tracking-tight">{title}</h3>
        {badge && (
          <span class="px-2 py-0.5 rounded text-[10px] font-mono uppercase tracking-wider bg-cyan-500/10 text-cyan-300 border border-cyan-500/30">
            {badge}
          </span>
        )}
      </div>
      {subtitle && <p class="text-xs text-slate-400 mt-0.5">{subtitle}</p>}
    </div>
  </div>

  <!-- Dedicated Chart Container for Responsive Chart.js Canvas -->
  <div class="relative w-full h-80 sm:h-96">
    <canvas id={chartId} data-v87-matrix={payload} aria-label={title}></canvas>
  </div>

  <!-- Quadrant Explanation Footnotes -->
  <div class="mt-4 pt-3 border-t border-slate-800/80 grid grid-cols-1 sm:grid-cols-3 gap-2 text-[11px] font-mono">
    <div class="flex items-center gap-2 text-slate-300">
      <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 shrink-0"></span>
      <span class="text-slate-400">
        <strong class="text-emerald-300">Dream Hubs:</strong> {lang === 'cs' ? 'Např. Kanada, Irsko, Švýcarsko, Nizozemsko, Česko' : 'e.g. Canada, Ireland, Switzerland, Netherlands, Czechia'}
      </span>
    </div>
    <div class="flex items-center gap-2 text-slate-300">
      <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 shrink-0"></span>
      <span class="text-slate-400">
        <strong class="text-cyan-300">Volume Giants:</strong> {lang === 'cs' ? 'USA a Spojené království (obrovský trh)' : 'US & UK (massive hiring volume)'}
      </span>
    </div>
    <div class="flex items-center gap-2 text-slate-300">
      <span class="w-2.5 h-2.5 rounded-full bg-indigo-400 shrink-0"></span>
      <span class="text-slate-400">
        <strong class="text-indigo-300">Lifestyle Havens:</strong> {lang === 'cs' ? 'Rakousko, Portugalsko, Švédsko, Norsko, Španělsko' : 'Austria, Portugal, Sweden, Norway, Spain'}
      </span>
    </div>
  </div>

  <!-- Accessible Semantic Data Table for SEO Crawlers & Screen Readers -->
  <div class="sr-only">
    <table>
      <caption>{title} - {subtitle}</caption>
      <thead>
        <tr>
          <th scope="col">Country</th>
          <th scope="col">Active AI/Data Jobs</th>
          <th scope="col">Livability Score</th>
          <th scope="col">Quadrant</th>
        </tr>
      </thead>
      <tbody>
        {countries.map((c) => (
          <tr>
            <th scope="row">{c.name}</th>
            <td>{c.jobs}</td>
            <td>{c.livability}</td>
            <td>{c.quadrant}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>

<script>
  import Chart from 'chart.js/auto';

  function initOpportunityMatrix() {
    const canvases = document.querySelectorAll<HTMLCanvasElement>('canvas[data-v87-matrix]');
    canvases.forEach((canvas) => {
      try {
        const raw = canvas.getAttribute('data-v87-matrix');
        if (!raw) return;

        const existing = Chart.getChart(canvas);
        if (existing) {
          existing.destroy();
        }

        const cfg = JSON.parse(raw);
        const labels = cfg.labels;

        new Chart(canvas, {
          type: 'scatter',
          data: {
            datasets: cfg.datasets,
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: {
                display: true,
                position: 'bottom',
                labels: {
                  color: '#cbd5e1',
                  font: { family: "'JetBrains Mono', monospace", size: 10 },
                  boxWidth: 10,
                  padding: 12,
                },
              },
              tooltip: {
                backgroundColor: 'rgba(6, 9, 17, 0.96)',
                titleColor: '#f8fafc',
                bodyColor: '#e2e8f0',
                borderColor: 'rgba(34, 211, 238, 0.4)',
                borderWidth: 1,
                padding: 12,
                titleFont: { family: "'Inter', sans-serif", size: 13, weight: 'bold' },
                bodyFont: { family: "'JetBrains Mono', monospace", size: 11 },
                callbacks: {
                  title: (items) => {
                    const rawItem = items[0]?.raw as any;
                    return rawItem ? `${rawItem.name} (${rawItem.iso3})` : '';
                  },
                  label: (ctx) => {
                    const rawItem = ctx.raw as any;
                    if (!rawItem) return '';
                    const jobsStr = rawItem.jobs.toLocaleString('en-US');
                    return [
                      ` • ${labels.xAxis}: ${jobsStr} ${labels.jobsWord}`,
                      ` • ${labels.scoreWord}: ${rawItem.livability} / 100`,
                      ` • ${labels.safetyWord}: ${rawItem.safety ?? 'N/A'} | ${labels.housingWord}: ${rawItem.housing ?? 'N/A'}`,
                    ];
                  },
                },
              },
            },
            scales: {
              x: {
                type: 'logarithmic',
                min: 1,
                max: 7000,
                grid: {
                  color: 'rgba(148, 163, 184, 0.08)',
                },
                ticks: {
                  color: '#94a3b8',
                  font: { family: "'JetBrains Mono', monospace", size: 10 },
                  callback: (value) => {
                    if ([1, 10, 50, 100, 500, 1000, 5000].includes(Number(value))) {
                      return Number(value).toLocaleString('en-US');
                    }
                    return null;
                  },
                },
                title: {
                  display: true,
                  text: labels.xAxis,
                  color: '#64748b',
                  font: { family: "'JetBrains Mono', monospace", size: 11 },
                },
              },
              y: {
                min: 55,
                max: 90,
                grid: {
                  color: 'rgba(148, 163, 184, 0.08)',
                },
                ticks: {
                  color: '#cbd5e1',
                  font: { family: "'JetBrains Mono', monospace", size: 10 },
                  stepSize: 5,
                },
                title: {
                  display: true,
                  text: labels.yAxis,
                  color: '#64748b',
                  font: { family: "'JetBrains Mono', monospace", size: 11 },
                },
              },
            },
          },
        });
      } catch (err) {
        console.error('Error initializing Opportunity Matrix chart on', canvas.id, err);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initOpportunityMatrix);
  } else {
    initOpportunityMatrix();
  }
  window.addEventListener('load', initOpportunityMatrix);
  document.addEventListener('astro:page-load', initOpportunityMatrix);
</script>
