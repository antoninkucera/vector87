---
import type { Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
  variant?: 'banner' | 'card' | 'compact';
  topic?: string;
}

const { lang, variant = 'card', topic } = Astro.props;

const isCs = lang === 'cs';

const title = topic
  ? (isCs ? `Sledujte trendy a poptávku pro ${topic}` : `Track hiring trends & demands for ${topic}`)
  : (isCs ? 'Jednou měsíčně: co se mění v požadavcích na AI a data' : 'Monthly Market Shift: AI & Data Talent Radar');

const subtitle = isCs
  ? '3 klíčové grafy, pohyby technologií (Databricks, Snowflake, cloud) a praktické závěry bez buzzwordů přímo od Antonína Kučery.'
  : '3 actionable charts, tech stack divergence (Databricks, Snowflake, hyperscalers), and zero-fluff analysis by Antonín Kučera.';

const buttonText = isCs ? 'Odebírat měsíční report ↗' : 'Subscribe to Monthly Brief ↗';
const trustBadge = isCs
  ? 'Bez spamu • Odhlášení kdykoliv 1 klikem • Na Substacku'
  : 'Zero spam • 1-click unsubscribe • Hosted on Substack';
---

<div
  class:list={[
    'panel-surface rounded-xl border border-cyan-500/30 p-6 sm:p-8 relative overflow-hidden group',
    variant === 'compact' ? 'py-4 px-5' : '',
  ]}
>
  <!-- Subtle glowing background accent -->
  <div class="absolute -top-24 -right-24 w-60 h-60 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none group-hover:bg-cyan-500/15 transition-all"></div>

  <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
    <div class="max-w-xl">
      <div class="flex items-center gap-2 mb-2">
        <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
        <span class="text-[11px] font-mono uppercase tracking-widest text-cyan-400 font-semibold">
          {isCs ? 'MĚSÍČNÍ DATOVÝ REPORT' : 'MONTHLY MARKET REPORT'}
        </span>
      </div>
      <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight leading-snug">
        {title}
      </h3>
      <p class="text-xs sm:text-sm text-slate-300 mt-2 leading-relaxed">
        {subtitle}
      </p>
      <div class="mt-3 flex items-center gap-2 text-[11px] font-mono text-slate-400">
        <span>✓</span>
        <span>{trustBadge}</span>
      </div>
    </div>

    <div class="shrink-0 w-full lg:w-auto">
      <form
        action="https://antoninkucera.substack.com/subscribe"
        method="get"
        target="_blank"
        rel="noopener noreferrer"
        class="flex flex-col sm:flex-row gap-2.5 items-stretch"
      >
        <label for="newsletter-email-input" class="sr-only">
          {isCs ? 'Váš e-mail pro odběr tržního newsletteru' : 'Your email for market intelligence newsletter'}
        </label>
        <input
          id="newsletter-email-input"
          type="email"
          name="email"
          aria-label={isCs ? 'Váš e-mail' : 'Your email'}
          placeholder={isCs ? 'váš@email.cz' : 'your.email@company.com'}
          required
          class="px-4 py-2.5 rounded-lg bg-slate-900 border border-slate-700/90 text-white placeholder-slate-400 text-xs font-mono focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition-all min-w-[220px]"
        />
        <button
          type="submit"
          class="px-5 py-2.5 rounded-lg text-xs font-mono font-bold bg-cyan-500 text-slate-950 hover:bg-cyan-400 transition-all shadow-lg shadow-cyan-500/20 hover:shadow-cyan-400/30 flex items-center justify-center gap-1.5 cursor-pointer shrink-0"
        >
          <span>{buttonText}</span>
        </button>
      </form>
    </div>
  </div>
</div>
