---
interface DatasetItem {
  label: string;
  data: number[];
  backgroundColor?: string | string[];
  borderColor?: string | string[];
  borderWidth?: number;
  borderRadius?: number;
  fill?: boolean;
  tension?: number;
}

interface Props {
  chartId: string;
  title: string;
  subtitle?: string;
  badge?: string;
  type: 'bar' | 'horizontalBar' | 'doughnut' | 'line' | 'radar';
  labels: string[];
  datasets: DatasetItem[];
  valueSuffix?: string;
  stacked?: boolean;
  heightClass?: string;
}

const {
  chartId,
  title,
  subtitle,
  badge,
  type,
  labels,
  datasets,
  valueSuffix = '',
  stacked = false,
  heightClass = 'h-72',
} = Astro.props;

const chartPayload = JSON.stringify({
  type: type === 'horizontalBar' ? 'bar' : type,
  indexAxis: type === 'horizontalBar' ? 'y' : 'x',
  labels,
  datasets,
  valueSuffix,
  stacked,
});
---

<div class="panel-surface rounded-xl p-5 flex flex-col justify-between">
  <div class="flex items-start justify-between gap-3 mb-4">
    <div>
      <h3 class="text-sm font-semibold text-white tracking-tight">{title}</h3>
      {subtitle && <p class="text-xs text-slate-400 mt-0.5">{subtitle}</p>}
    </div>
    <div class="flex items-center gap-1.5 shrink-0">
      {badge && (
        <span class="px-2 py-0.5 rounded text-[10px] font-mono uppercase tracking-wider bg-cyan-500/10 text-cyan-300 border border-cyan-500/30">
          {badge}
        </span>
      )}
      <!-- Chart Action: Export Branded 16:9 PNG -->
      <button
        type="button"
        class="v87-export-png-btn p-1.5 rounded-lg text-slate-400 hover:text-cyan-300 hover:bg-slate-800/80 border border-transparent hover:border-slate-700/60 transition-all cursor-pointer"
        data-chart-id={chartId}
        data-title={title}
        data-subtitle={subtitle || ''}
        title="Download branded 16:9 chart image (PNG)"
        aria-label="Download chart image"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
      </button>

      <!-- Chart Action: Copy Citation -->
      <button
        type="button"
        class="v87-cite-btn p-1.5 rounded-lg text-slate-400 hover:text-cyan-300 hover:bg-slate-800/80 border border-transparent hover:border-slate-700/60 transition-all cursor-pointer"
        data-title={title}
        title="Copy formal research citation"
        aria-label="Copy citation"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Dedicated Chart Container for Chart.js (must be isolated from siblings for responsive sizing) -->
  <div class:list={['relative w-full', heightClass]}>
    <canvas id={chartId} data-v87-chart={chartPayload} aria-label={title}></canvas>
  </div>

  <!-- Accessible Semantic Data Table for Search Crawlers (SEO) and Screen Readers (placed outside canvas container) -->
  <div class="sr-only">
    <table>
      <caption>{title} {subtitle ? `: ${subtitle}` : ''}</caption>
      <thead>
        <tr>
          <th scope="col">Metric / Technology</th>
          {datasets.map((d) => (
            <th scope="col">{d.label}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {labels.map((label, idx) => (
          <tr>
            <th scope="row">{label}</th>
            {datasets.map((d) => (
              <td>
                {d.data && d.data[idx] !== undefined ? `${d.data[idx]}${valueSuffix}` : '-'}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>

<script>
  import Chart from 'chart.js/auto';
  import { exportChartAsBrandedPng, copyCitationToClipboard } from '../utils/telemetryExport';

  function initChartActions() {
    document.querySelectorAll<HTMLButtonElement>('.v87-export-png-btn').forEach((btn) => {
      if (btn.getAttribute('data-v87-bound')) return;
      btn.setAttribute('data-v87-bound', 'true');

      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const chartId = btn.getAttribute('data-chart-id');
        const title = btn.getAttribute('data-title') || 'Vector87 Telemetry';
        const subtitle = btn.getAttribute('data-subtitle') || undefined;
        if (!chartId) return;
        const canvas = document.getElementById(chartId) as HTMLCanvasElement | null;
        if (canvas) {
          const isCs = window.location.pathname.startsWith('/cs');
          exportChartAsBrandedPng(canvas, title, subtitle, isCs ? 'cs' : 'en');
        }
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.v87-cite-btn').forEach((btn) => {
      if (btn.getAttribute('data-v87-bound')) return;
      btn.setAttribute('data-v87-bound', 'true');

      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const title = btn.getAttribute('data-title') || 'Vector87 Telemetry';
        const isCs = window.location.pathname.startsWith('/cs');
        copyCitationToClipboard(title, undefined, isCs ? 'cs' : 'en');
      });
    });
  }

  function initVector87Charts() {
    initChartActions();
    const canvases = document.querySelectorAll<HTMLCanvasElement>('canvas[data-v87-chart]');
    canvases.forEach((canvas) => {
      try {
        const raw = canvas.getAttribute('data-v87-chart');
        if (!raw) return;

        // Clean up any existing Chart instance attached to this canvas (crucial for HMR / re-render)
        const existing = Chart.getChart(canvas);
        if (existing) {
          existing.destroy();
        }

        const cfg = JSON.parse(raw);
        const isDoughnutOrRadar = cfg.type === 'doughnut' || cfg.type === 'radar';
        const showLegend = cfg.datasets.length > 1 || cfg.type === 'doughnut';

        new Chart(canvas, {
          type: cfg.type,
          data: {
            labels: cfg.labels,
            datasets: cfg.datasets,
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            indexAxis: cfg.indexAxis,
            interaction: isDoughnutOrRadar
              ? {
                  mode: 'nearest',
                  intersect: false,
                }
              : {
                  mode: 'index',
                  intersect: false,
                  axis: cfg.indexAxis === 'y' ? 'y' : 'x',
                },
            plugins: {
              legend: {
                display: showLegend,
                position: 'bottom',
                labels: {
                  color: '#cbd5e1',
                  font: { family: "'JetBrains Mono', monospace", size: 11 },
                  boxWidth: 10,
                  padding: 14,
                },
              },
              tooltip: {
                animation: {
                  duration: 100,
                },
                backgroundColor: 'rgba(6, 9, 17, 0.96)',
                titleColor: '#f8fafc',
                bodyColor: '#22d3ee',
                borderColor: 'rgba(34, 211, 238, 0.35)',
                borderWidth: 1,
                padding: 10,
                titleFont: { family: "'Inter', sans-serif", size: 12, weight: 'bold' },
                bodyFont: { family: "'JetBrains Mono', monospace", size: 11 },
                callbacks: {
                  label: (ctx) => {
                    const val = ctx.parsed.y !== undefined && cfg.indexAxis !== 'y' ? ctx.parsed.y : ctx.parsed.x ?? ctx.parsed;
                    const formatted = typeof val === 'number' ? val.toLocaleString('en-US') : val;
                    return ` ${ctx.dataset.label}: ${formatted}${cfg.valueSuffix || ''}`;
                  },
                },
              },
            },
            scales: isDoughnutOrRadar
              ? cfg.type === 'radar'
                ? {
                    r: {
                      angleLines: { color: 'rgba(148, 163, 184, 0.15)' },
                      grid: { color: 'rgba(148, 163, 184, 0.15)' },
                      pointLabels: { color: '#cbd5e1', font: { family: "'JetBrains Mono', monospace", size: 10 } },
                      ticks: { display: false },
                    },
                  }
                : {}
              : {
                  x: {
                    stacked: cfg.stacked,
                    grid: {
                      color: cfg.indexAxis === 'y' ? 'rgba(148, 163, 184, 0.08)' : 'transparent',
                    },
                    ticks: {
                      color: '#94a3b8',
                      font: { family: "'JetBrains Mono', monospace", size: 10 },
                    },
                  },
                  y: {
                    stacked: cfg.stacked,
                    grid: {
                      color: cfg.indexAxis === 'x' ? 'rgba(148, 163, 184, 0.08)' : 'transparent',
                    },
                    ticks: {
                      color: '#cbd5e1',
                      font: { family: "'JetBrains Mono', monospace", size: 11 },
                    },
                  },
                },
          },
        });
      } catch (err) {
        console.error('Error initializing chart on', canvas.id, err);
      }
    });
  }

  // Handle both initial page load and SPA navigation
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initVector87Charts);
  } else {
    initVector87Charts();
  }
  window.addEventListener('load', initVector87Charts);
  document.addEventListener('astro:page-load', initVector87Charts);
</script>
