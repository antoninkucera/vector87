---
import type { VennItem } from '../data/comparisons';
import type { Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
  nameA: string;
  nameB: string;
  uniqueA: VennItem[];
  shared: VennItem[];
  uniqueB: VennItem[];
}

const { lang, nameA, nameB, uniqueA, shared, uniqueB } = Astro.props;

const t = {
  en: {
    uniqueATitle: `Unique to ${nameA}`,
    sharedTitle: 'Shared Analytical Core',
    uniqueBTitle: `Unique to ${nameB}`,
    sharedSub: 'Skills & competencies demanded across both profiles',
    overlapLabel: 'Intersection',
  },
  cs: {
    uniqueATitle: `Specifické pro ${nameA}`,
    sharedTitle: 'Společný analytický průnik',
    uniqueBTitle: `Specifické pro ${nameB}`,
    sharedSub: 'Dovednosti a kompetence vyžadované u obou rolí',
    overlapLabel: 'Průnik',
  },
}[lang];
---

<div class="space-y-8">
  <!-- Desktop / Tablet SVG Venn Diagram Visualization -->
  <div class="hidden sm:block relative overflow-hidden rounded-2xl bg-gradient-to-b from-slate-900/60 to-slate-950/80 border border-slate-800 p-8 shadow-xl">
    <div class="max-w-2xl mx-auto">
      <svg
        viewBox="0 0 600 320"
        class="w-full h-auto select-none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <defs>
          <linearGradient id="circleAGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#0284c7" stop-opacity="0.25" />
            <stop offset="100%" stop-color="#0369a1" stop-opacity="0.08" />
          </linearGradient>
          <linearGradient id="circleBGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#059669" stop-opacity="0.25" />
            <stop offset="100%" stop-color="#047857" stop-opacity="0.08" />
          </linearGradient>
          <linearGradient id="overlapGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#6366f1" stop-opacity="0.30" />
            <stop offset="100%" stop-color="#4f46e5" stop-opacity="0.15" />
          </linearGradient>
          <filter id="glowA" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="8" result="blur" />
            <feComposite in="SourceGraphic" in2="blur" operator="over" />
          </filter>
        </defs>

        <!-- Circle A (Left) -->
        <circle
          cx="220"
          cy="160"
          r="140"
          fill="url(#circleAGrad)"
          stroke="#0284c7"
          stroke-width="2"
          stroke-dasharray="4 2"
          class="transition-all duration-300"
        />

        <!-- Circle B (Right) -->
        <circle
          cx="380"
          cy="160"
          r="140"
          fill="url(#circleBGrad)"
          stroke="#059669"
          stroke-width="2"
          stroke-dasharray="4 2"
          class="transition-all duration-300"
        />

        <!-- Title for Circle A -->
        <text
          x="150"
          y="75"
          text-anchor="middle"
          fill="#38bdf8"
          font-family="monospace"
          font-weight="bold"
          font-size="14"
          letter-spacing="0.5"
        >
          {nameA.toUpperCase()}
        </text>

        <!-- Title for Circle B -->
        <text
          x="450"
          y="75"
          text-anchor="middle"
          fill="#34d399"
          font-family="monospace"
          font-weight="bold"
          font-size="14"
          letter-spacing="0.5"
        >
          {nameB.toUpperCase()}
        </text>

        <!-- Title for Overlap -->
        <text
          x="300"
          y="50"
          text-anchor="middle"
          fill="#a5b4fc"
          font-family="monospace"
          font-weight="bold"
          font-size="11"
          letter-spacing="1"
        >
          {t.overlapLabel.toUpperCase()}
        </text>

        <!-- Sample Preview Items in Circles -->
        <!-- Items in A -->
        <g font-family="monospace" font-size="11" fill="#bae6fd">
          {uniqueA.slice(0, 3).map((item, idx) => (
            <text x="145" y={130 + idx * 28} text-anchor="middle">
              • {item.name}
            </text>
          ))}
        </g>

        <!-- Items in Shared Center -->
        <g font-family="monospace" font-size="11" font-weight="bold" fill="#e0e7ff">
          {shared.slice(0, 3).map((item, idx) => (
            <text x="300" y={130 + idx * 28} text-anchor="middle">
              ✓ {item.name}
            </text>
          ))}
        </g>

        <!-- Items in B -->
        <g font-family="monospace" font-size="11" fill="#a7f3d0">
          {uniqueB.slice(0, 3).map((item, idx) => (
            <text x="455" y={130 + idx * 28} text-anchor="middle">
              • {item.name}
            </text>
          ))}
        </g>
      </svg>
    </div>
  </div>

  <!-- Detailed 3-Column Breakdown (Venn Columns) -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    
    <!-- Column 1: Unique to A -->
    <div class="p-6 rounded-2xl bg-slate-900/40 border border-sky-500/30 flex flex-col justify-between">
      <div>
        <div class="flex items-center gap-2 mb-3">
          <span class="w-3 h-3 rounded-full bg-sky-400"></span>
          <h3 class="text-sm font-mono font-bold uppercase tracking-wider text-sky-400">
            {t.uniqueATitle}
          </h3>
        </div>
        <div class="space-y-4 mt-4">
          {uniqueA.map((item) => (
            <div class="p-3.5 rounded-xl bg-slate-800/50 border border-slate-700/60">
              <div class="flex items-center justify-between gap-2 mb-1">
                <span class="text-sm font-bold text-white font-mono">{item.name}</span>
                {item.pctA !== undefined && (
                  <span class="px-2 py-0.5 rounded text-[11px] font-mono font-bold bg-sky-500/20 text-sky-300">
                    {item.pctA}%
                  </span>
                )}
              </div>
              <p class="text-xs text-slate-300 leading-relaxed mt-1">
                {item.detail[lang]}
              </p>
            </div>
          ))}
        </div>
      </div>
      <div class="mt-6 pt-3 border-t border-slate-800 text-[11px] font-mono text-slate-500">
        Distinct technical & business profile
      </div>
    </div>

    <!-- Column 2: Shared Intersection (Center) -->
    <div class="p-6 rounded-2xl bg-indigo-950/20 border border-indigo-500/40 flex flex-col justify-between shadow-lg shadow-indigo-950/20">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="w-3 h-3 rounded-full bg-indigo-400 animate-pulse"></span>
          <h3 class="text-sm font-mono font-bold uppercase tracking-wider text-indigo-300">
            {t.sharedTitle}
          </h3>
        </div>
        <p class="text-[11px] text-slate-400 mb-4 font-mono">{t.sharedSub}</p>

        <div class="space-y-4">
          {shared.map((item) => (
            <div class="p-3.5 rounded-xl bg-slate-800/80 border border-indigo-500/30">
              <div class="flex items-center justify-between gap-2 mb-1">
                <span class="text-sm font-bold text-white font-mono">{item.name}</span>
                <div class="flex items-center gap-1.5 shrink-0">
                  {item.pctA !== undefined && (
                    <span class="px-1.5 py-0.5 rounded text-[10px] font-mono font-bold bg-sky-500/20 text-sky-300" title={`${nameA}: ${item.pctA}%`}>
                      {item.pctA}%
                    </span>
                  )}
                  {item.pctA !== undefined && item.pctB !== undefined && (
                    <span class="text-[10px] text-slate-500">/</span>
                  )}
                  {item.pctB !== undefined && (
                    <span class="px-1.5 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-500/20 text-emerald-300" title={`${nameB}: ${item.pctB}%`}>
                      {item.pctB}%
                    </span>
                  )}
                </div>
              </div>
              <p class="text-xs text-slate-300 leading-relaxed mt-1">
                {item.detail[lang]}
              </p>
            </div>
          ))}
        </div>
      </div>
      <div class="mt-6 pt-3 border-t border-indigo-500/20 text-[11px] font-mono text-indigo-300/80">
        Shared foundational baseline
      </div>
    </div>

    <!-- Column 3: Unique to B -->
    <div class="p-6 rounded-2xl bg-slate-900/40 border border-emerald-500/30 flex flex-col justify-between">
      <div>
        <div class="flex items-center gap-2 mb-3">
          <span class="w-3 h-3 rounded-full bg-emerald-400"></span>
          <h3 class="text-sm font-mono font-bold uppercase tracking-wider text-emerald-400">
            {t.uniqueBTitle}
          </h3>
        </div>
        <div class="space-y-4 mt-4">
          {uniqueB.map((item) => (
            <div class="p-3.5 rounded-xl bg-slate-800/50 border border-slate-700/60">
              <div class="flex items-center justify-between gap-2 mb-1">
                <span class="text-sm font-bold text-white font-mono">{item.name}</span>
                {item.pctB !== undefined && (
                  <span class="px-2 py-0.5 rounded text-[11px] font-mono font-bold bg-emerald-500/20 text-emerald-300">
                    {item.pctB}%
                  </span>
                )}
              </div>
              <p class="text-xs text-slate-300 leading-relaxed mt-1">
                {item.detail[lang]}
              </p>
            </div>
          ))}
        </div>
      </div>
      <div class="mt-6 pt-3 border-t border-slate-800 text-[11px] font-mono text-slate-500">
        Distinct technical & engineering specialization
      </div>
    </div>
  </div>
</div>
