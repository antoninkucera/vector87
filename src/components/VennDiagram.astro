---
import type { VennItem } from '../data/comparisons';
import type { Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
  nameA: string;
  nameB: string;
  uniqueA: VennItem[];
  shared: VennItem[];
  uniqueB: VennItem[];
}

const { lang, nameA, nameB, uniqueA, shared, uniqueB } = Astro.props;

const t = {
  en: {
    uniqueAHeading: 'Unique Focus & Tooling',
    sharedTitle: 'Shared Analytical Core',
    sharedSub: 'Enterprise Overlap',
    uniqueBHeading: 'Unique Focus & Tooling',
    colAFootnote: 'Distinct reporting & business logic profile',
    colSharedFootnote: 'Foundational baseline demanded across both roles',
    colBFootnote: 'Distinct algorithmic & predictive engineering profile',
  },
  cs: {
    uniqueAHeading: 'Specifické dovednosti a nástroje',
    sharedTitle: 'Společný analytický průnik',
    sharedSub: 'Podnikový přesah',
    uniqueBHeading: 'Specifické dovednosti a nástroje',
    colAFootnote: 'Specifický profil pro reporting a byznysové rozhodování',
    colSharedFootnote: 'Společný technologický základ vyžadovaný u obou rolí',
    colBFootnote: 'Specifický profil pro prediktivní modelování a algoritmy',
  },
}[lang];
---

<div class="relative w-full rounded-3xl bg-slate-950/90 border border-slate-800/90 p-5 sm:p-7 lg:p-9 shadow-2xl overflow-hidden">
  
  <!-- Atmospheric Desktop/Tablet Venn Diagram Background Geometry -->
  <div class="hidden md:block absolute inset-0 pointer-events-none select-none overflow-hidden" aria-hidden="true">
    <div class="relative w-full h-full flex items-center justify-center">
      
      <!-- Circle A (Left) -->
      <div 
        class="absolute w-[440px] h-[440px] lg:w-[500px] lg:h-[500px] rounded-full -translate-x-[26%] bg-sky-950/25 border-2 border-sky-500/35 shadow-[0_0_60px_rgba(14,165,233,0.12)]"
      >
        <!-- Subtle internal radar ring -->
        <div class="absolute inset-8 rounded-full border border-sky-500/10 border-dashed"></div>
      </div>

      <!-- Circle B (Right) -->
      <div 
        class="absolute w-[440px] h-[440px] lg:w-[500px] lg:h-[500px] rounded-full translate-x-[26%] bg-emerald-950/25 border-2 border-emerald-500/35 shadow-[0_0_60px_rgba(16,185,129,0.12)]"
      >
        <!-- Subtle internal radar ring -->
        <div class="absolute inset-8 rounded-full border border-emerald-500/10 border-dashed"></div>
      </div>

      <!-- Center Overlap Lens (Venn Intersection Highlight) -->
      <div 
        class="absolute w-[220px] lg:w-[260px] h-[360px] lg:h-[420px] rounded-[100px] bg-gradient-to-b from-indigo-500/15 via-indigo-500/10 to-indigo-500/15 border-x border-indigo-400/30 shadow-[0_0_40px_rgba(99,102,241,0.15)] backdrop-blur-[1px]"
      ></div>

    </div>
  </div>

  <!-- Content Layer: Perfectly Aligned 3-Column Grid -->
  <div class="relative z-10 grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 items-stretch">
    
    <!-- ==================== COLUMN 1: UNIQUE TO A ==================== -->
    <div class="flex flex-col justify-between p-5 rounded-2xl bg-slate-900/40 md:bg-transparent border border-sky-500/25 md:border-none">
      <div>
        <!-- Column Header -->
        <div class="text-center mb-5">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-bold bg-sky-500/20 text-sky-300 border border-sky-400/40 shadow-sm shadow-sky-950/30">
            <span class="w-2 h-2 rounded-full bg-sky-400"></span>
            <span>{nameA}</span>
          </div>
          <div class="text-[11px] font-mono text-sky-400/80 mt-1.5 uppercase tracking-wider font-semibold">
            {t.uniqueAHeading}
          </div>
        </div>

        <!-- Competency Cards -->
        <div class="space-y-3">
          {uniqueA.map((item) => (
            <div class="p-3.5 rounded-xl bg-slate-900/80 border border-sky-500/30 backdrop-blur-md transition-all hover:border-sky-400/60 hover:shadow-md hover:shadow-sky-950/30">
              <div class="flex items-center justify-between gap-2 mb-1">
                <span class="text-xs sm:text-sm font-bold text-white font-mono flex items-center gap-1.5">
                  <span class="text-sky-400 font-bold">•</span>
                  <span>{item.name}</span>
                </span>
                {item.pctA !== undefined && (
                  <span class="px-2 py-0.5 rounded text-[11px] font-mono font-bold bg-sky-500/20 text-sky-300 shrink-0 border border-sky-500/30">
                    {item.pctA}%
                  </span>
                )}
              </div>
              <p class="text-xs text-slate-300 leading-relaxed mt-1 pl-3.5">
                {item.detail[lang]}
              </p>
            </div>
          ))}
        </div>
      </div>

      <div class="mt-5 pt-3 border-t border-sky-500/20 text-[11px] font-mono text-sky-400/60 text-center">
        {t.colAFootnote}
      </div>
    </div>

    <!-- ==================== COLUMN 2: INTERSECTION (SHARED) ==================== -->
    <div class="flex flex-col justify-between p-5 rounded-2xl bg-indigo-950/20 md:bg-transparent border border-indigo-500/35 md:border-none shadow-lg shadow-indigo-950/20 md:shadow-none">
      <div>
        <!-- Column Header -->
        <div class="text-center mb-5">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-bold bg-indigo-500/30 text-indigo-200 border border-indigo-400/50 shadow-md shadow-indigo-950/40">
            <span class="w-2 h-2 rounded-full bg-indigo-400 animate-pulse"></span>
            <span>{t.sharedTitle}</span>
          </div>
          <div class="text-[11px] font-mono text-indigo-300/80 mt-1.5 uppercase tracking-wider font-semibold">
            {t.sharedSub}
          </div>
        </div>

        <!-- Competency Cards -->
        <div class="space-y-3">
          {shared.map((item) => (
            <div class="p-3.5 rounded-xl bg-slate-900/90 border border-indigo-500/40 backdrop-blur-md transition-all hover:border-indigo-400/70 hover:shadow-md hover:shadow-indigo-950/40">
              <div class="flex items-center justify-between gap-2 mb-1">
                <span class="text-xs sm:text-sm font-bold text-white font-mono flex items-center gap-1.5">
                  <span class="text-indigo-400 font-bold">✓</span>
                  <span>{item.name}</span>
                </span>
                <div class="flex items-center gap-1 shrink-0 font-mono text-[10px] sm:text-[11px]">
                  {item.pctA !== undefined && (
                    <span class="px-1.5 py-0.5 rounded font-bold bg-sky-500/20 text-sky-300 border border-sky-500/30" title={`${nameA}: ${item.pctA}%`}>
                      {item.pctA}%
                    </span>
                  )}
                  {item.pctA !== undefined && item.pctB !== undefined && (
                    <span class="text-slate-500 font-bold">/</span>
                  )}
                  {item.pctB !== undefined && (
                    <span class="px-1.5 py-0.5 rounded font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30" title={`${nameB}: ${item.pctB}%`}>
                      {item.pctB}%
                    </span>
                  )}
                </div>
              </div>
              <p class="text-xs text-slate-300 leading-relaxed mt-1 pl-3.5">
                {item.detail[lang]}
              </p>
            </div>
          ))}
        </div>
      </div>

      <div class="mt-5 pt-3 border-t border-indigo-500/20 text-[11px] font-mono text-indigo-300/70 text-center">
        {t.colSharedFootnote}
      </div>
    </div>

    <!-- ==================== COLUMN 3: UNIQUE TO B ==================== -->
    <div class="flex flex-col justify-between p-5 rounded-2xl bg-slate-900/40 md:bg-transparent border border-emerald-500/25 md:border-none">
      <div>
        <!-- Column Header -->
        <div class="text-center mb-5">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-400/40 shadow-sm shadow-emerald-950/30">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span>{nameB}</span>
          </div>
          <div class="text-[11px] font-mono text-emerald-400/80 mt-1.5 uppercase tracking-wider font-semibold">
            {t.uniqueBHeading}
          </div>
        </div>

        <!-- Competency Cards -->
        <div class="space-y-3">
          {uniqueB.map((item) => (
            <div class="p-3.5 rounded-xl bg-slate-900/80 border border-emerald-500/30 backdrop-blur-md transition-all hover:border-emerald-400/60 hover:shadow-md hover:shadow-emerald-950/30">
              <div class="flex items-center justify-between gap-2 mb-1">
                <span class="text-xs sm:text-sm font-bold text-white font-mono flex items-center gap-1.5">
                  <span class="text-emerald-400 font-bold">•</span>
                  <span>{item.name}</span>
                </span>
                {item.pctB !== undefined && (
                  <span class="px-2 py-0.5 rounded text-[11px] font-mono font-bold bg-emerald-500/20 text-emerald-300 shrink-0 border border-emerald-500/30">
                    {item.pctB}%
                  </span>
                )}
              </div>
              <p class="text-xs text-slate-300 leading-relaxed mt-1 pl-3.5">
                {item.detail[lang]}
              </p>
            </div>
          ))}
        </div>
      </div>

      <div class="mt-5 pt-3 border-t border-emerald-500/20 text-[11px] font-mono text-emerald-400/60 text-center">
        {t.colBFootnote}
      </div>
    </div>

  </div>
</div>
