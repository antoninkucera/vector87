---
import type { VennItem, DiagramBullets } from '../data/comparisons';
import type { Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
  nameA: string;
  nameB: string;
  uniqueA: VennItem[];
  shared: VennItem[];
  uniqueB: VennItem[];
  diagramBullets?: DiagramBullets;
}

const { lang, nameA, nameB, uniqueA, shared, uniqueB, diagramBullets } = Astro.props;

const t = {
  en: {
    sharedTitle: 'Shared Analytical Core',
    sharedSub: 'Competency Overlap',
    detailedHeading: 'Detailed Competency & Tooling Breakdown',
    detailedSub: 'Granular skill penetration across enterprise S&P 500 postings',
    uniqueATitle: `Unique to ${nameA}`,
    uniqueBTitle: `Unique to ${nameB}`,
    colAFootnote: 'Distinct reporting & business logic profile',
    colSharedFootnote: 'Foundational baseline demanded across both roles',
    colBFootnote: 'Distinct algorithmic & predictive engineering profile',
  },
  cs: {
    sharedTitle: 'Společný analytický základ',
    sharedSub: 'Průnik kompetencí',
    detailedHeading: 'Podrobný rozpad dovedností a technologií',
    detailedSub: 'Podíl zastoupení v inzerátech předních korporací',
    uniqueATitle: `Specifické pro ${nameA}`,
    uniqueBTitle: `Specifické pro ${nameB}`,
    colAFootnote: 'Specifický profil pro reporting a byznysová rozhodnutí',
    colSharedFootnote: 'Společný technologický základ vyžadovaný u obou rolí',
    colBFootnote: 'Specifický profil pro prediktivní modelování a algoritmy',
  },
}[lang];

// Fallback to top 3 items if explicit diagramBullets are not defined
const bulletsA = diagramBullets?.left[lang] || uniqueA.slice(0, 3).map((i) => i.name);
const bulletsShared = diagramBullets?.shared[lang] || shared.slice(0, 3).map((i) => i.name);
const bulletsB = diagramBullets?.right[lang] || uniqueB.slice(0, 3).map((i) => i.name);
---

<div class="space-y-12">
  
  <!-- ==================== 1. HERO VENN DIAGRAM (AUTHENTIC SOLID DISCS) ==================== -->
  <div class="relative w-full rounded-3xl bg-[#040814] border border-slate-800/90 p-4 sm:p-8 lg:p-10 shadow-2xl overflow-hidden">
    
    <!-- Header Toolbar: Badge & Cite Action -->
    <div class="flex items-center justify-between gap-3 mb-4 text-xs font-mono">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
        <span class="text-slate-400 uppercase tracking-widest text-[11px] font-bold">
          {lang === 'cs' ? 'Vennův diagram kompetencí' : 'Competency Venn Diagram'}
        </span>
      </div>
      <div class="flex items-center gap-2">
        <button
          type="button"
          class="v87-venn-cite-btn px-2.5 py-1 rounded-lg text-slate-400 hover:text-cyan-300 hover:bg-slate-800/80 border border-slate-800 hover:border-slate-700 transition-all cursor-pointer flex items-center gap-1.5 text-[11px]"
          data-title={`${nameA} vs. ${nameB}`}
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <span>{lang === 'cs' ? 'Citovat srovnání' : 'Cite Comparison'}</span>
        </button>
      </div>
    </div>

    <!-- Desktop / Tablet Venn Diagram (>= md) -->
    <div class="hidden md:block relative max-w-4xl mx-auto">
      <svg
        viewBox="0 0 960 500"
        class="w-full h-auto select-none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <defs>
          <!-- Left Circle Fill: Deep Navy Blue -->
          <linearGradient id="vennSolidLeft" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#0c233c" />
            <stop offset="100%" stop-color="#081829" />
          </linearGradient>

          <!-- Right Circle Fill: Deep Forest / Mint Green -->
          <linearGradient id="vennSolidRight" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#064e3b" />
            <stop offset="100%" stop-color="#022c22" />
          </linearGradient>

          <!-- Overlap Lens Fill: Vibrant Teal / Emerald -->
          <linearGradient id="vennSolidLens" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#093f33" />
            <stop offset="100%" stop-color="#052e25" />
          </linearGradient>

          <!-- Shadow Filter -->
          <filter id="vennShadow" x="-10%" y="-10%" width="120%" height="120%">
            <feDropShadow dx="0" dy="4" stdDeviation="8" flood-color="#000000" flood-opacity="0.5" />
          </filter>
        </defs>

        <!-- Circle A (Left): Center (350, 250), Radius 220 -->
        <circle
          cx="350"
          cy="250"
          r="220"
          fill="url(#vennSolidLeft)"
          stroke="#38bdf8"
          stroke-width="3"
          filter="url(#vennShadow)"
        />

        <!-- Circle B (Right): Center (610, 250), Radius 220 -->
        <circle
          cx="610"
          cy="250"
          r="220"
          fill="url(#vennSolidRight)"
          stroke="#34d399"
          stroke-width="3"
          filter="url(#vennShadow)"
        />

        <!-- Exact Overlap Lens: Arcs between (480, 72) and (480, 428) -->
        <path
          d="M 480,72 A 220,220 0 0,1 480,428 A 220,220 0 0,1 480,72 Z"
          fill="url(#vennSolidLens)"
          stroke="#6ee7b7"
          stroke-width="2.5"
        />

        <!-- ==================== CONTENT ZONE A (LEFT CIRCLE) ==================== -->
        <foreignObject x="150" y="85" width="225" height="330">
          <div xmlns="http://www.w3.org/1999/xhtml" class="h-full flex flex-col justify-center text-left text-white pr-2">
            <h3 class="text-base lg:text-lg font-bold text-white font-mono mb-4 tracking-tight flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-sky-400 shrink-0"></span>
              <span>{nameA}</span>
            </h3>
            <ul class="space-y-3.5 text-xs lg:text-[13px] text-slate-100 leading-snug">
              {bulletsA.map((bullet) => (
                <li class="flex items-start gap-2">
                  <span class="text-sky-400 font-bold text-sm leading-tight shrink-0">•</span>
                  <span class="font-medium text-slate-200">{bullet}</span>
                </li>
              ))}
            </ul>
          </div>
        </foreignObject>

        <!-- ==================== CONTENT ZONE CENTER (OVERLAP LENS) ==================== -->
        <foreignObject x="402" y="85" width="156" height="330">
          <div xmlns="http://www.w3.org/1999/xhtml" class="h-full flex flex-col justify-center text-left text-white px-1">
            <div class="mb-4">
              <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-400/30">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>{t.sharedTitle}</span>
              </div>
            </div>
            <ul class="space-y-3 text-xs lg:text-[12px] text-emerald-100 leading-snug">
              {bulletsShared.map((bullet) => (
                <li class="flex items-start gap-1.5">
                  <span class="text-emerald-400 font-bold text-xs leading-tight shrink-0">✓</span>
                  <span class="font-medium text-emerald-100">{bullet}</span>
                </li>
              ))}
            </ul>
          </div>
        </foreignObject>

        <!-- ==================== CONTENT ZONE B (RIGHT CIRCLE) ==================== -->
        <foreignObject x="585" y="85" width="225" height="330">
          <div xmlns="http://www.w3.org/1999/xhtml" class="h-full flex flex-col justify-center text-left text-white pl-2">
            <h3 class="text-base lg:text-lg font-bold text-white font-mono mb-4 tracking-tight flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 shrink-0"></span>
              <span>{nameB}</span>
            </h3>
            <ul class="space-y-3.5 text-xs lg:text-[13px] text-slate-100 leading-snug">
              {bulletsB.map((bullet) => (
                <li class="flex items-start gap-2">
                  <span class="text-emerald-400 font-bold text-sm leading-tight shrink-0">•</span>
                  <span class="font-medium text-slate-200">{bullet}</span>
                </li>
              ))}
            </ul>
          </div>
        </foreignObject>
      </svg>
    </div>

    <!-- Mobile Stack (< md) -->
    <div class="md:hidden space-y-4">
      <!-- Role A -->
      <div class="p-5 rounded-2xl bg-[#0c233c] border border-sky-500/40">
        <h3 class="text-sm font-bold text-white font-mono mb-3 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-sky-400"></span>
          <span>{nameA}</span>
        </h3>
        <ul class="space-y-2.5 text-xs text-slate-200">
          {bulletsA.map((b) => (
            <li class="flex items-start gap-2">
              <span class="text-sky-400 font-bold">•</span>
              <span>{b}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Shared -->
      <div class="p-5 rounded-2xl bg-[#064e3b] border border-emerald-500/40">
        <h3 class="text-xs font-mono font-bold text-emerald-300 uppercase tracking-wider mb-3 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>{t.sharedTitle}</span>
        </h3>
        <ul class="space-y-2.5 text-xs text-emerald-100">
          {bulletsShared.map((b) => (
            <li class="flex items-start gap-2">
              <span class="text-emerald-400 font-bold">✓</span>
              <span>{b}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Role B -->
      <div class="p-5 rounded-2xl bg-[#022c22] border border-emerald-500/40">
        <h3 class="text-sm font-bold text-white font-mono mb-3 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span>{nameB}</span>
        </h3>
        <ul class="space-y-2.5 text-xs text-slate-200">
          {bulletsB.map((b) => (
            <li class="flex items-start gap-2">
              <span class="text-emerald-400 font-bold">•</span>
              <span>{b}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <!-- ==================== 2. DETAILED EMPIRICAL BREAKDOWN MATRIX ==================== -->
  <div>
    <div class="flex items-center gap-2 mb-2">
      <span class="w-2 h-2 rounded-full bg-indigo-400"></span>
      <h3 class="text-xs font-mono uppercase tracking-widest text-slate-400">
        {t.detailedHeading}
      </h3>
    </div>
    <p class="text-xs sm:text-sm text-slate-400 mb-6 font-mono">
      {t.detailedSub}
    </p>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <!-- Col 1: Unique to A Details -->
      <div class="p-6 rounded-2xl bg-slate-900/50 border border-sky-500/30 flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-2 mb-4">
            <span class="w-2.5 h-2.5 rounded-full bg-sky-400"></span>
            <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-sky-400">
              {t.uniqueATitle}
            </h4>
          </div>
          <div class="space-y-3.5">
            {uniqueA.map((item) => (
              <div class="p-3.5 rounded-xl bg-slate-800/60 border border-slate-700/60">
                <div class="flex items-center justify-between gap-2 mb-1">
                  <span class="text-xs sm:text-sm font-bold text-white font-mono">{item.name}</span>
                  {item.pctA !== undefined && (
                    <span class="px-2 py-0.5 rounded text-[11px] font-mono font-bold bg-sky-500/20 text-sky-300 shrink-0">
                      {item.pctA}%
                    </span>
                  )}
                </div>
                <p class="text-xs text-slate-300 leading-relaxed mt-1">
                  {item.detail[lang]}
                </p>
              </div>
            ))}
          </div>
        </div>
        <div class="mt-6 pt-3 border-t border-slate-800 text-[11px] font-mono text-slate-500">
          {t.colAFootnote}
        </div>
      </div>

      <!-- Col 2: Shared Intersection Details -->
      <div class="p-6 rounded-2xl bg-indigo-950/20 border border-indigo-500/40 flex flex-col justify-between shadow-lg shadow-indigo-950/20">
        <div>
          <div class="flex items-center gap-2 mb-4">
            <span class="w-2.5 h-2.5 rounded-full bg-indigo-400 animate-pulse"></span>
            <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-indigo-300">
              {t.sharedTitle}
            </h4>
          </div>
          <div class="space-y-3.5">
            {shared.map((item) => (
              <div class="p-3.5 rounded-xl bg-slate-800/80 border border-indigo-500/30">
                <div class="flex items-center justify-between gap-2 mb-1">
                  <span class="text-xs sm:text-sm font-bold text-white font-mono">{item.name}</span>
                  <div class="flex items-center gap-1.5 shrink-0 font-mono text-[10px]">
                    {item.pctA !== undefined && (
                      <span class="px-1.5 py-0.5 rounded font-bold bg-sky-500/20 text-sky-300" title={`${nameA}: ${item.pctA}%`}>
                        {item.pctA}%
                      </span>
                    )}
                    {item.pctA !== undefined && item.pctB !== undefined && (
                      <span class="text-slate-500 font-bold">/</span>
                    )}
                    {item.pctB !== undefined && (
                      <span class="px-1.5 py-0.5 rounded font-bold bg-emerald-500/20 text-emerald-300" title={`${nameB}: ${item.pctB}%`}>
                        {item.pctB}%
                      </span>
                    )}
                  </div>
                </div>
                <p class="text-xs text-slate-300 leading-relaxed mt-1">
                  {item.detail[lang]}
                </p>
              </div>
            ))}
          </div>
        </div>
        <div class="mt-6 pt-3 border-t border-indigo-500/20 text-[11px] font-mono text-indigo-300/80">
          {t.colSharedFootnote}
        </div>
      </div>

      <!-- Col 3: Unique to B Details -->
      <div class="p-6 rounded-2xl bg-slate-900/50 border border-emerald-500/30 flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-2 mb-4">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
            <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-400">
              {t.uniqueBTitle}
            </h4>
          </div>
          <div class="space-y-3.5">
            {uniqueB.map((item) => (
              <div class="p-3.5 rounded-xl bg-slate-800/60 border border-slate-700/60">
                <div class="flex items-center justify-between gap-2 mb-1">
                  <span class="text-xs sm:text-sm font-bold text-white font-mono">{item.name}</span>
                  {item.pctB !== undefined && (
                    <span class="px-2 py-0.5 rounded text-[11px] font-mono font-bold bg-emerald-500/20 text-emerald-300 shrink-0">
                      {item.pctB}%
                    </span>
                  )}
                </div>
                <p class="text-xs text-slate-300 leading-relaxed mt-1">
                  {item.detail[lang]}
                </p>
              </div>
            ))}
          </div>
        </div>
        <div class="mt-6 pt-3 border-t border-slate-800 text-[11px] font-mono text-slate-500">
          {t.colBFootnote}
        </div>
      </div>

    </div>
  </div>

</div>

<script>
  import { copyCitationToClipboard } from '../utils/telemetryExport';

  function initVennCiteButtons() {
    document.querySelectorAll<HTMLButtonElement>('.v87-venn-cite-btn').forEach((btn) => {
      if (btn.getAttribute('data-v87-bound')) return;
      btn.setAttribute('data-v87-bound', 'true');

      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const title = btn.getAttribute('data-title') || 'Vector87 Comparison';
        const isCs = window.location.pathname.startsWith('/cs');
        copyCitationToClipboard(title, undefined, isCs ? 'cs' : 'en');
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initVennCiteButtons);
  } else {
    initVennCiteButtons();
  }
  document.addEventListener('astro:page-load', initVennCiteButtons);
</script>
