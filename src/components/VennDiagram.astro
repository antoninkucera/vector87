---
import type { VennItem } from '../data/comparisons';
import type { Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
  nameA: string;
  nameB: string;
  uniqueA: VennItem[];
  shared: VennItem[];
  uniqueB: VennItem[];
}

const { lang, nameA, nameB, uniqueA, shared, uniqueB } = Astro.props;

const t = {
  en: {
    uniqueAHeading: `Unique to ${nameA}`,
    sharedTitle: 'Shared Core',
    sharedSub: 'Intersection',
    uniqueBHeading: `Unique to ${nameB}`,
    legendA: 'Distinct business & reporting focus',
    legendShared: 'Baseline demanded across both profiles',
    legendB: 'Distinct algorithmic & predictive engineering focus',
  },
  cs: {
    uniqueAHeading: `Specifické pro ${nameA}`,
    sharedTitle: 'Společný základ',
    sharedSub: 'Průnik dovedností',
    uniqueBHeading: `Specifické pro ${nameB}`,
    legendA: 'Specifické pro reporting a byznysová rozhodnutí',
    legendShared: 'Společný základ vyžadovaný u obou rolí',
    legendB: 'Specifické pro prediktivní modelování a algoritmy',
  },
}[lang];
---

<div class="w-full max-w-5xl mx-auto my-6">
  
  <!-- ==================== DESKTOP & TABLET: TRUE VENN DIAGRAM (>= md) ==================== -->
  <div class="hidden md:block relative min-h-[580px] rounded-3xl bg-[#060913] border border-slate-800/80 p-6 lg:p-8 overflow-hidden shadow-2xl">
    
    <!-- SVG Venn Geometry Background (Authentic Overlapping Circles + Exact Lens) -->
    <div class="absolute inset-0 pointer-events-none select-none" aria-hidden="true">
      <svg viewBox="0 0 960 580" class="w-full h-full" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <!-- Circle A Gradient (Deep Navy / Sky) -->
          <radialGradient id="vennGradLeft" cx="35%" cy="45%" r="65%">
            <stop offset="0%" stop-color="#0284c7" stop-opacity="0.32" />
            <stop offset="60%" stop-color="#0369a1" stop-opacity="0.18" />
            <stop offset="100%" stop-color="#082f49" stop-opacity="0.25" />
          </radialGradient>

          <!-- Circle B Gradient (Deep Emerald / Mint) -->
          <radialGradient id="vennGradRight" cx="65%" cy="45%" r="65%">
            <stop offset="0%" stop-color="#10b981" stop-opacity="0.28" />
            <stop offset="60%" stop-color="#047857" stop-opacity="0.16" />
            <stop offset="100%" stop-color="#022c22" stop-opacity="0.25" />
          </radialGradient>

          <!-- Intersection Lens Gradient (Indigo / Cyan blend) -->
          <radialGradient id="vennGradLens" cx="50%" cy="50%" r="60%">
            <stop offset="0%" stop-color="#6366f1" stop-opacity="0.38" />
            <stop offset="65%" stop-color="#4f46e5" stop-opacity="0.22" />
            <stop offset="100%" stop-color="#1e1b4b" stop-opacity="0.35" />
          </radialGradient>

          <!-- Glow Filter -->
          <filter id="vennGlow" x="-10%" y="-10%" width="120%" height="120%">
            <feGaussianBlur stdDeviation="12" result="blur" />
            <feComposite in="SourceGraphic" in2="blur" operator="over" />
          </filter>
        </defs>

        <!-- Circle A: Center (340, 290), Radius 255 -->
        <circle
          cx="340"
          cy="290"
          r="255"
          fill="url(#vennGradLeft)"
          stroke="#38bdf8"
          stroke-width="2.5"
          stroke-opacity="0.75"
        />

        <!-- Circle B: Center (620, 290), Radius 255 -->
        <circle
          cx="620"
          cy="290"
          r="255"
          fill="url(#vennGradRight)"
          stroke="#34d399"
          stroke-width="2.5"
          stroke-opacity="0.75"
        />

        <!-- Exact Intersection Lens Path (where the two circles overlap between x=365 and x=595) -->
        <path
          d="M 480,78 A 255,255 0 0,1 480,502 A 255,255 0 0,1 480,78 Z"
          fill="url(#vennGradLens)"
          stroke="#818cf8"
          stroke-width="2"
          stroke-opacity="0.85"
        />
      </svg>
    </div>

    <!-- Content 3-Column Grid Layer (Direct typography, no rectangular cards) -->
    <div class="relative z-10 grid grid-cols-3 gap-4 lg:gap-6 h-full items-start pt-4">
      
      <!-- ==================== ZONE 1: UNIQUE TO A (LEFT CIRCLE) ==================== -->
      <div class="flex flex-col h-full max-w-[280px] lg:max-w-[295px] mr-auto pl-2 lg:pl-4">
        <!-- Zone Header -->
        <div class="mb-6 text-left">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-bold bg-sky-500/20 text-sky-200 border border-sky-400/50 shadow-sm shadow-sky-950/40">
            <span class="w-2 h-2 rounded-full bg-sky-400"></span>
            <span>{nameA}</span>
          </div>
          <div class="text-[11px] font-mono text-sky-400/80 mt-1 uppercase tracking-wider font-semibold">
            {t.uniqueAHeading}
          </div>
        </div>

        <!-- Clean Bulleted Items directly on circle background -->
        <ul class="space-y-4">
          {uniqueA.map((item) => (
            <li class="group">
              <div class="flex items-baseline justify-between gap-2">
                <span class="text-xs lg:text-sm font-bold text-white font-mono flex items-center gap-1.5 group-hover:text-sky-300 transition-colors">
                  <span class="text-sky-400 text-base leading-none">•</span>
                  <span>{item.name}</span>
                </span>
                {item.pctA !== undefined && (
                  <span class="px-1.5 py-0.5 rounded text-[10px] font-mono font-bold bg-sky-500/25 text-sky-200 border border-sky-400/30 shrink-0">
                    {item.pctA}%
                  </span>
                )}
              </div>
              <p class="text-[11px] text-slate-300 leading-relaxed mt-1 pl-3.5">
                {item.detail[lang]}
              </p>
            </li>
          ))}
        </ul>
      </div>

      <!-- ==================== ZONE 2: INTERSECTION (CENTER LENS) ==================== -->
      <div class="flex flex-col h-full max-w-[220px] lg:max-w-[240px] mx-auto text-center px-1">
        <!-- Zone Header -->
        <div class="mb-6">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-bold bg-indigo-500/30 text-indigo-200 border border-indigo-400/60 shadow-md shadow-indigo-950/50">
            <span class="w-2 h-2 rounded-full bg-indigo-400 animate-pulse"></span>
            <span>{t.sharedTitle}</span>
          </div>
          <div class="text-[11px] font-mono text-indigo-300/80 mt-1 uppercase tracking-wider font-semibold">
            {t.sharedSub}
          </div>
        </div>

        <!-- Clean Bulleted Items inside intersection lens -->
        <ul class="space-y-4 text-left">
          {shared.map((item) => (
            <li class="group">
              <div class="flex items-baseline justify-between gap-1.5">
                <span class="text-xs lg:text-sm font-bold text-white font-mono flex items-center gap-1.5 group-hover:text-indigo-200 transition-colors">
                  <span class="text-indigo-400 text-sm leading-none">✓</span>
                  <span>{item.name}</span>
                </span>
                <div class="flex items-center gap-1 shrink-0 font-mono text-[10px]">
                  {item.pctA !== undefined && (
                    <span class="px-1 py-0.5 rounded font-bold bg-sky-500/20 text-sky-300" title={`${nameA}: ${item.pctA}%`}>
                      {item.pctA}%
                    </span>
                  )}
                  {item.pctA !== undefined && item.pctB !== undefined && (
                    <span class="text-slate-500 font-bold">/</span>
                  )}
                  {item.pctB !== undefined && (
                    <span class="px-1 py-0.5 rounded font-bold bg-emerald-500/20 text-emerald-300" title={`${nameB}: ${item.pctB}%`}>
                      {item.pctB}%
                    </span>
                  )}
                </div>
              </div>
              <p class="text-[11px] text-slate-300 leading-relaxed mt-1 pl-3.5">
                {item.detail[lang]}
              </p>
            </li>
          ))}
        </ul>
      </div>

      <!-- ==================== ZONE 3: UNIQUE TO B (RIGHT CIRCLE) ==================== -->
      <div class="flex flex-col h-full max-w-[280px] lg:max-w-[295px] ml-auto pr-2 lg:pr-4 text-left">
        <!-- Zone Header -->
        <div class="mb-6 text-left">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-bold bg-emerald-500/20 text-emerald-200 border border-emerald-400/50 shadow-sm shadow-emerald-950/40">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span>{nameB}</span>
          </div>
          <div class="text-[11px] font-mono text-emerald-400/80 mt-1 uppercase tracking-wider font-semibold">
            {t.uniqueBHeading}
          </div>
        </div>

        <!-- Clean Bulleted Items directly on circle background -->
        <ul class="space-y-4">
          {uniqueB.map((item) => (
            <li class="group">
              <div class="flex items-baseline justify-between gap-2">
                <span class="text-xs lg:text-sm font-bold text-white font-mono flex items-center gap-1.5 group-hover:text-emerald-300 transition-colors">
                  <span class="text-emerald-400 text-base leading-none">•</span>
                  <span>{item.name}</span>
                </span>
                {item.pctB !== undefined && (
                  <span class="px-1.5 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-500/25 text-emerald-200 border border-emerald-400/30 shrink-0">
                    {item.pctB}%
                  </span>
                )}
              </div>
              <p class="text-[11px] text-slate-300 leading-relaxed mt-1 pl-3.5">
                {item.detail[lang]}
              </p>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <!-- Footnotes / Legend Bar at Bottom -->
    <div class="relative z-10 grid grid-cols-3 gap-4 pt-8 mt-6 border-t border-slate-800/60 text-[10px] font-mono text-center">
      <div class="text-sky-400/70">{t.legendA}</div>
      <div class="text-indigo-300/80 font-semibold">{t.legendShared}</div>
      <div class="text-emerald-400/70">{t.legendB}</div>
    </div>
  </div>

  <!-- ==================== MOBILE RESPONSIVE STACK (< md) ==================== -->
  <div class="md:hidden space-y-4">
    <!-- Mobile Role A -->
    <div class="p-5 rounded-2xl bg-sky-950/30 border border-sky-500/40">
      <div class="flex items-center justify-between gap-2 mb-3">
        <span class="text-xs font-mono font-bold text-sky-300 uppercase tracking-wider flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-sky-400"></span>
          <span>{nameA}</span>
        </span>
        <span class="text-[10px] font-mono text-sky-400/70">{t.uniqueAHeading}</span>
      </div>
      <ul class="space-y-3">
        {uniqueA.map((item) => (
          <li>
            <div class="flex items-center justify-between gap-2">
              <span class="text-xs font-bold text-white font-mono">• {item.name}</span>
              {item.pctA !== undefined && (
                <span class="px-1.5 py-0.5 rounded text-[10px] font-mono font-bold bg-sky-500/20 text-sky-300">
                  {item.pctA}%
                </span>
              )}
            </div>
            <p class="text-[11px] text-slate-300 leading-relaxed mt-0.5 pl-3">
              {item.detail[lang]}
            </p>
          </li>
        ))}
      </ul>
    </div>

    <!-- Mobile Intersection (Shared) -->
    <div class="p-5 rounded-2xl bg-indigo-950/40 border border-indigo-500/50 shadow-lg shadow-indigo-950/30">
      <div class="flex items-center justify-between gap-2 mb-3">
        <span class="text-xs font-mono font-bold text-indigo-200 uppercase tracking-wider flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-indigo-400 animate-pulse"></span>
          <span>{t.sharedTitle}</span>
        </span>
        <span class="text-[10px] font-mono text-indigo-300/70">{t.sharedSub}</span>
      </div>
      <ul class="space-y-3">
        {shared.map((item) => (
          <li>
            <div class="flex items-center justify-between gap-2">
              <span class="text-xs font-bold text-white font-mono">✓ {item.name}</span>
              <div class="flex items-center gap-1 font-mono text-[10px]">
                {item.pctA !== undefined && (
                  <span class="px-1 py-0.5 rounded font-bold bg-sky-500/20 text-sky-300">
                    {item.pctA}%
                  </span>
                )}
                {item.pctA !== undefined && item.pctB !== undefined && (
                  <span class="text-slate-500">/</span>
                )}
                {item.pctB !== undefined && (
                  <span class="px-1 py-0.5 rounded font-bold bg-emerald-500/20 text-emerald-300">
                    {item.pctB}%
                  </span>
                )}
              </div>
            </div>
            <p class="text-[11px] text-slate-300 leading-relaxed mt-0.5 pl-3">
              {item.detail[lang]}
            </p>
          </li>
        ))}
      </ul>
    </div>

    <!-- Mobile Role B -->
    <div class="p-5 rounded-2xl bg-emerald-950/30 border border-emerald-500/40">
      <div class="flex items-center justify-between gap-2 mb-3">
        <span class="text-xs font-mono font-bold text-emerald-300 uppercase tracking-wider flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span>{nameB}</span>
        </span>
        <span class="text-[10px] font-mono text-emerald-400/70">{t.uniqueBHeading}</span>
      </div>
      <ul class="space-y-3">
        {uniqueB.map((item) => (
          <li>
            <div class="flex items-center justify-between gap-2">
              <span class="text-xs font-bold text-white font-mono">• {item.name}</span>
              {item.pctB !== undefined && (
                <span class="px-1.5 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-500/20 text-emerald-300">
                  {item.pctB}%
                </span>
              )}
            </div>
            <p class="text-[11px] text-slate-300 leading-relaxed mt-0.5 pl-3">
              {item.detail[lang]}
            </p>
          </li>
        ))}
      </ul>
    </div>
  </div>

</div>
