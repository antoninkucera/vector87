---
import { ui, type Locale } from '../../i18n/ui';

interface Props {
  lang: Locale;
  active: 'courses' | 'podcasts';
}

const { lang, active } = Astro.props;
const t = ui[lang].academy.subNav;

const coursesHref = lang === 'cs' ? '/cs/academy' : '/academy';
const podcastsHref = lang === 'cs' ? '/cs/academy/podcasts' : '/academy/podcasts';
---

<nav aria-label="Academy sub-navigation" class="mb-10 flex flex-wrap items-center gap-2 border-b border-slate-800/80 pb-4">
  <a
    href={coursesHref}
    class:list={[
      'px-4 py-2 rounded-lg text-xs font-mono font-semibold transition-all inline-flex items-center gap-2',
      active === 'courses'
        ? 'bg-cyan-500/15 text-cyan-300 border border-cyan-500/40 shadow-sm shadow-cyan-950/50'
        : 'bg-slate-900/80 text-slate-400 border border-slate-800 hover:border-slate-700 hover:text-slate-200',
    ]}
  >
    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
    </svg>
    <span>{t.courses}</span>
  </a>

  <a
    href={podcastsHref}
    class:list={[
      'px-4 py-2 rounded-lg text-xs font-mono font-semibold transition-all inline-flex items-center gap-2',
      active === 'podcasts'
        ? 'bg-cyan-500/15 text-cyan-300 border border-cyan-500/40 shadow-sm shadow-cyan-950/50'
        : 'bg-slate-900/80 text-slate-400 border border-slate-800 hover:border-slate-700 hover:text-slate-200',
    ]}
  >
    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 100-6 3 3 0 000 6z" />
    </svg>
    <span>{t.podcasts}</span>
    <span class="px-1.5 py-0.5 rounded text-[10px] font-mono bg-cyan-950 text-cyan-300 border border-cyan-800/60 font-bold">
      NEW
    </span>
  </a>
</nav>
