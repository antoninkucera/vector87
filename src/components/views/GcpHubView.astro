---
import Layout from '../../layouts/Layout.astro';
import MarketTrendChart from '../MarketTrendChart.astro';
import marketData from '../../data/market-data.json';
import { ui, type Locale } from '../../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang].gcp;
const { gcp_hub } = marketData;
---

<Layout title={t.pageTitle} activeNav="gcp" lang={lang}>
  <section class="mb-10 pb-8 border-b border-slate-800/80">
    <div class="max-w-3xl space-y-3">
      <span class="text-xs font-mono uppercase tracking-widest text-cyan-400">{t.tag}</span>
      <h1 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">
        {t.title}
      </h1>
      <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
        {t.subtitle}
      </p>
    </div>
  </section>

  <section class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
    <div class="panel-surface rounded-xl p-5 border-l-2 border-l-cyan-400">
      <p class="text-xs font-mono uppercase text-slate-400">{t.kpi1Title}</p>
      <p class="text-3xl font-bold font-mono text-white mt-2">
        {gcp_hub.total_gcp_ecosystem_jobs.toLocaleString('en-US')}
      </p>
      <p class="text-xs font-mono text-slate-400 mt-1">{t.kpi1Foot}</p>
    </div>

    <div class="panel-surface rounded-xl p-5 border-l-2 border-l-blue-500">
      <p class="text-xs font-mono uppercase text-slate-400">{t.kpi2Title}</p>
      <p class="text-3xl font-bold font-mono text-cyan-300 mt-2">
        {gcp_hub.gcp_share_of_all_jobs_pct}%
      </p>
      <p class="text-xs font-mono text-slate-400 mt-1">{t.kpi2Foot}</p>
    </div>

    <div class="panel-surface rounded-xl p-5 border-l-2 border-l-emerald-400">
      <p class="text-xs font-mono uppercase text-slate-400">{t.kpi3Title}</p>
      <p class="text-3xl font-bold font-mono text-emerald-400 mt-2">
        {gcp_hub.gcp_share_of_cloud_jobs_pct}%
      </p>
      <p class="text-xs font-mono text-slate-400 mt-1">{t.kpi3Foot}</p>
    </div>
  </section>

  <section class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-10">
    <MarketTrendChart
      chartId="chart-gcp-services"
      title={t.chartSvcTitle}
      subtitle={t.chartSvcSub}
      badge="GCP STACK"
      type="bar"
      labels={gcp_hub.services.map((s) => s.service_name)}
      datasets={[
        {
          label: t.chartSvcLabel,
          data: gcp_hub.services.map((s) => s.job_count),
          backgroundColor: 'rgba(34, 211, 238, 0.8)',
          borderColor: '#22d3ee',
          borderWidth: 1,
          borderRadius: 5,
        },
      ]}
      heightClass="h-72"
    />

    <MarketTrendChart
      chartId="chart-gcp-roles"
      title={t.chartRoleTitle}
      subtitle={t.chartRoleSub}
      badge="GCP ROLES"
      type="horizontalBar"
      labels={gcp_hub.top_gcp_roles.map((r) => r.canonical_name)}
      datasets={[
        {
          label: t.chartRoleLabel,
          data: gcp_hub.top_gcp_roles.map((r) => r.job_count),
          backgroundColor: 'rgba(59, 130, 246, 0.8)',
          borderColor: '#3b82f6',
          borderWidth: 1,
          borderRadius: 4,
        },
      ]}
      heightClass="h-72"
    />
  </section>

  <section class="mb-12">
    <h2 class="text-xl font-bold text-white mb-4">{t.svcSectionTitle}</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {gcp_hub.services.map((svc) => (
        <div class="panel-surface rounded-xl p-5 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2">
              <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded bg-cyan-500/10 text-cyan-300 border border-cyan-500/30">
                {svc.category}
              </span>
              <span class="text-xs font-mono text-slate-400">
                {svc.penetration_in_gcp_pct}% {t.ofGcpPositions}
              </span>
            </div>
            <h3 class="text-lg font-bold text-white mt-2">{svc.service_name}</h3>
            <p class="text-2xl font-mono font-bold text-cyan-300 mt-1">
              {svc.job_count.toLocaleString('en-US')}{' '}
              <span class="text-xs font-normal text-slate-400">{t.postingsOfMarket(svc.penetration_all_pct)}</span>
            </p>
          </div>

          <div class="mt-4 pt-3 border-t border-slate-800/80">
            <p class="text-[10px] font-mono uppercase text-slate-400 mb-1.5">{t.pairedWithLabel}</p>
            <div class="flex flex-wrap gap-1.5">
              {svc.top_paired_skills.map((ps) => (
                <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-slate-900 text-slate-200 border border-slate-800">
                  {ps}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-4">
      <h2 class="text-xl font-bold text-white">{t.notesSectionTitle}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {t.notes.map((item) => (
          <div class="panel-surface-interactive rounded-xl p-5 flex flex-col justify-between">
            <div>
              <span class="text-[10px] font-mono uppercase text-cyan-400">{item.tag}</span>
              <h3 class="text-base font-bold text-white mt-1">{item.service}</h3>
              <p class="text-xs text-slate-300 mt-2 leading-relaxed">{item.summary}</p>
            </div>
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 inline-flex items-center gap-1 text-xs font-mono text-cyan-300 hover:text-cyan-200"
            >
              <span>{item.linkLabel}</span>
              <span>↗</span>
            </a>
          </div>
        ))}
      </div>
    </div>

    <div class="panel-surface rounded-xl p-5">
      <h3 class="text-sm font-semibold text-white mb-1">{t.topCompTitle}</h3>
      <p class="text-xs text-slate-400 mb-4">{t.topCompSub}</p>
      <div class="space-y-2.5">
        {gcp_hub.top_gcp_companies.map((comp, idx) => (
          <div class="flex items-center justify-between p-2.5 rounded-lg bg-slate-900/80 border border-slate-800/80 text-xs">
            <div class="truncate pr-2">
              <span class="font-mono text-slate-500 mr-1.5">#{idx + 1}</span>
              <span class="font-medium text-slate-200">{comp.company_name}</span>
            </div>
            <span class="font-mono font-bold text-cyan-300 shrink-0">
              {comp.job_count} {t.positionsWord}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
