---
import Layout from '../../layouts/Layout.astro';
import { ui, type Locale } from '../../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang].about;

const aboutJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  dateCreated: '2026-10-26T00:00:00Z',
  mainEntity: {
    '@type': 'Person',
    name: 'Antonín Kučera',
    jobTitle: 'Data & BI Leader, Google Cloud & BigQuery Specialist',
    url: 'https://akucera.eu',
    sameAs: [
      'https://akucera.eu',
      'https://www.linkedin.com/in/antoninkucera/',
      'https://github.com/antoninkucera',
    ],
    knowsAbout: [
      'Google Cloud Platform',
      'BigQuery',
      'Analytics Engineering',
      'Data Architecture',
      'Business Intelligence',
    ],
  },
};
---

<Layout title={t.pageTitle} description={t.pageDescription} activeNav="about" lang={lang} jsonLd={aboutJsonLd}>
  <section class="mb-12 pb-8 border-b border-slate-800/80">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-8 space-y-4">
        <span class="text-xs font-mono uppercase tracking-widest text-cyan-400">{t.tag}</span>
        <h1 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">
          Antonín Kučera
        </h1>
        <p class="text-base text-cyan-300 font-mono">
          {t.roleSubtitle}
        </p>
        <p class="text-sm sm:text-base text-slate-200 leading-relaxed">
          {t.bioP1}
        </p>
        <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
          {t.bioP2}
        </p>

        <div class="pt-3 flex flex-wrap gap-3">
          <a
            href="https://akucera.eu"
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2.5 rounded-lg bg-cyan-400 text-slate-950 font-mono text-xs font-bold hover:bg-cyan-300 transition-colors"
          >
            {t.ctaBlog}
          </a>
          <a
            href="https://antoninkucera.substack.com"
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2.5 rounded-lg border border-orange-500/40 bg-orange-500/10 text-orange-300 font-mono text-xs font-bold hover:bg-orange-500/20 hover:border-orange-400 transition-colors"
          >
            {t.ctaSubstack}
          </a>
          <a
            href="https://www.linkedin.com/in/antoninkucera/"
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2.5 rounded-lg border border-slate-700 bg-slate-900 text-slate-200 font-mono text-xs font-semibold hover:border-cyan-400/50 hover:text-cyan-300 transition-colors"
          >
            {t.ctaLinkedin}
          </a>
        </div>
      </div>

      <div class="lg:col-span-4 panel-surface rounded-xl p-6 space-y-4 border-t-2 border-t-cyan-400">
        <div class="flex items-center justify-between">
          <span class="font-mono text-xs uppercase text-cyan-400">{t.brandCardTitle}</span>
          <span class="font-mono text-xs text-slate-500">EST. 1987 // TELEMETRY</span>
        </div>
        <p class="text-xs text-slate-300 leading-relaxed">
          {t.brandCardP1}
        </p>
        <p class="text-xs text-slate-300 leading-relaxed">
          {t.brandCardP2}
        </p>
      </div>
    </div>
  </section>

  <section class="mb-10">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 mb-6">
      <div>
        <span class="text-xs font-mono uppercase tracking-widest text-cyan-400">{t.articlesTag}</span>
        <h2 class="text-2xl font-bold text-white mt-0.5">{t.articlesTitle}</h2>
      </div>
      <a
        href="https://antoninkucera.substack.com"
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs font-mono text-cyan-300 hover:text-cyan-200"
      >
        {t.articlesAllLink}
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {t.articles.map((art) => (
        <a
          href={art.href}
          target="_blank"
          rel="noopener noreferrer"
          class="panel-surface-interactive rounded-xl p-5 flex flex-col justify-between group"
        >
          <div>
            <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded bg-cyan-500/10 text-cyan-300 border border-cyan-500/30">
              {art.topic}
            </span>
            <h3 class="text-base font-bold text-white mt-3 group-hover:text-cyan-300 transition-colors leading-snug">
              {art.title}
            </h3>
            <p class="text-xs text-slate-300 mt-2.5 leading-relaxed">{art.summary}</p>
          </div>
          <div class="mt-5 pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs font-mono text-cyan-400">
            <span>{t.readArticle}</span>
            <span class="group-hover:translate-x-0.5 transition-transform">↗</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
