---
import Layout from '../../layouts/Layout.astro';
import AcademySubNav from '../academy/AcademySubNav.astro';
import { ui, type Locale } from '../../i18n/ui';
import podcastsData from '../../data/podcasts-data.json';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang].podcasts;

const sources = podcastsData.sources || [];
const rawEpisodes = podcastsData.episodes || [];

// Sort episodes by release_date descending
const episodes = [...rawEpisodes].sort((a, b) => {
  const dateA = a.release_date || '';
  const dateB = b.release_date || '';
  return dateB.localeCompare(dateA);
});

// Calculate statistics
const totalSources = sources.length;
const totalEpisodes = episodes.length;
const spotifyShowsCount = sources.filter((s) => s.external_url?.includes('spotify.com')).length;
const youtubeChannelsCount = sources.filter((s) => s.external_url?.includes('youtube.com')).length;

// Initial batch size rendered in SSR HTML to stay well under Googlebot 2MB cutoff
const INITIAL_BATCH_SIZE = 24;
const initialEpisodes = episodes.slice(0, INITIAL_BATCH_SIZE);

// Extract unique episode categories
const uniqueCategories = Array.from(
  new Set(episodes.map((e) => e.category).filter(Boolean))
).sort();

// Top topics for quick filters
const topTopics = [
  'Generative AI',
  'AI Agents',
  'Data Governance',
  'Data Strategy',
  'Large Language Models',
  'Agentic AI',
  'Data Engineering',
  'Cloud Data Warehousing',
  'Business Intelligence',
  'Cloud Architecture',
  'MLOps',
];

// Helper to format release date
function formatDate(dateStr: string | null | undefined): string {
  if (!dateStr) return '';
  try {
    const d = new Date(dateStr);
    return d.toLocaleDateString(lang === 'cs' ? 'cs-CZ' : 'en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    });
  } catch {
    return dateStr;
  }
}

// Helper to format duration
function formatDuration(ms: number | null | undefined): string {
  if (!ms || ms <= 0) return lang === 'cs' ? 'Video epizoda' : 'Video Episode';
  const minutes = Math.round(ms / 60000);
  return `${minutes} ${t.durationMin}`;
}

// Featured high-priority sources (mix of top Spotify + top YouTube)
const featuredSources = sources.filter((s) => {
  const name = s.name.toLowerCase();
  return (
    name.includes('karpathy') ||
    name.includes('lex fridman') ||
    name.includes('practical ai') ||
    name.includes('software engineering daily') ||
    name.includes('data engineering podcast') ||
    name.includes('google cloud tech') ||
    name.includes('data science at home') ||
    name.includes('ai jason') ||
    name.includes('weights & biases') ||
    name.includes('duckdb') ||
    name.includes('dbt labs') ||
    name.includes('linear digressions')
  );
}).slice(0, 8);

// Schema.org JSON-LD
const podcastsJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: t.title,
  description: t.pageDescription,
  mainEntity: {
    '@type': 'ItemList',
    name: t.title,
    numberOfItems: episodes.length,
    itemListElement: episodes.slice(0, 30).map((ep, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      item: {
        '@type': ep.external_url?.includes('spotify') ? 'PodcastEpisode' : 'VideoObject',
        name: ep.title,
        description: ep.summary || ep.description?.slice(0, 200) || ep.title,
        url: ep.external_url,
        datePublished: ep.release_date,
      },
    })),
  },
};
---

<Layout
  title={t.pageTitle}
  description={t.pageDescription}
  activeNav="academy"
  lang={lang}
  jsonLd={podcastsJsonLd}
>
  <!-- Hero Section -->
  <section class="mb-12 pb-8 border-b border-slate-800/80">
    <div class="max-w-4xl space-y-3">
      <span class="text-xs font-mono uppercase tracking-widest text-cyan-400">{t.tag}</span>
      <h1 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">
        {t.title}
      </h1>
      <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
        {t.subtitle}
      </p>
    </div>
  </section>

  <!-- Sub-navigation between Courses and Podcasts -->
  <AcademySubNav lang={lang} active="podcasts" />

  <!-- Live Pipeline KPI Market Cards -->
  <section class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
    <div class="panel-surface rounded-xl p-5 border-l-2 border-l-cyan-400">
      <span class="text-xs font-mono uppercase text-slate-400">{t.statSources}</span>
      <p class="text-3xl font-bold font-mono text-cyan-300 mt-2">{totalSources}</p>
      <p class="text-[11px] font-mono text-slate-400 mt-1">
        {spotifyShowsCount} Spotify • {youtubeChannelsCount} YouTube
      </p>
    </div>

    <div class="panel-surface rounded-xl p-5 border-l-2 border-l-emerald-400">
      <span class="text-xs font-mono uppercase text-slate-400">{t.statEpisodes}</span>
      <p class="text-3xl font-bold font-mono text-emerald-300 mt-2">{totalEpisodes}</p>
      <p class="text-[11px] font-mono text-slate-400 mt-1">
        {lang === 'cs' ? 'Inženýrská hloubka' : 'Technical Depth'}
      </p>
    </div>

    <div class="panel-surface rounded-xl p-5 border-l-2 border-l-purple-400">
      <span class="text-xs font-mono uppercase text-slate-400">{t.statPlatforms}</span>
      <p class="text-3xl font-bold font-mono text-purple-300 mt-2">2 Platforms</p>
      <p class="text-[11px] font-mono text-slate-400 mt-1">Audio RSS + Video</p>
    </div>

    <div class="panel-surface rounded-xl p-5 border-l-2 border-l-amber-400">
      <span class="text-xs font-mono uppercase text-slate-400">{t.statAiTagged}</span>
      <p class="text-3xl font-bold font-mono text-amber-300 mt-2">Gemini 2.0</p>
      <p class="text-[11px] font-mono text-slate-400 mt-1">
        {lang === 'cs' ? 'Exekutivní souhrny' : 'Executive Summaries'}
      </p>
    </div>
  </section>

  <!-- Featured Monitored Shows Showcase -->
  <section class="mb-14">
    <div class="mb-6 flex flex-col sm:flex-row sm:items-end justify-between gap-2">
      <div>
        <h2 class="text-2xl font-bold text-white tracking-tight">{t.featuredShowsTitle}</h2>
        <p class="text-xs font-mono text-slate-400 mt-1">{t.featuredShowsSubtitle}</p>
      </div>
      <span class="text-xs font-mono text-cyan-400 bg-cyan-500/10 border border-cyan-500/30 px-2.5 py-1 rounded">
        {t.verifiedSignal}
      </span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {featuredSources.map((source) => {
        const isSpotify = source.external_url?.includes('spotify.com');
        return (
          <a
            href={source.external_url}
            target="_blank"
            rel="noopener noreferrer"
            class="panel-surface-interactive rounded-xl p-4 flex flex-col justify-between group border border-slate-800/80 hover:border-cyan-500/40"
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span
                  class:list={[
                    'text-[10px] font-mono uppercase px-2 py-0.5 rounded border font-semibold flex items-center gap-1',
                    isSpotify
                      ? 'bg-emerald-500/10 text-emerald-300 border-emerald-500/30'
                      : 'bg-rose-500/10 text-rose-300 border-rose-500/30',
                  ]}
                >
                  {isSpotify ? 'Spotify' : 'YouTube'}
                </span>
                <span class="text-[10px] font-mono text-slate-400">
                  {source.total_episodes > 0 ? `${source.total_episodes} eps` : 'Channel'}
                </span>
              </div>

              <div class="flex items-start gap-3">
                {source.image_url ? (
                  <img
                    src={source.image_url}
                    alt={source.name}
                    class="w-11 h-11 rounded-lg object-cover shrink-0 border border-slate-700/60"
                    loading="lazy"
                  />
                ) : (
                  <div
                    class:list={[
                      'w-11 h-11 rounded-lg shrink-0 flex items-center justify-center font-bold text-sm font-mono border',
                      isSpotify
                        ? 'bg-emerald-950/60 text-emerald-400 border-emerald-800/50'
                        : 'bg-rose-950/60 text-rose-400 border-rose-800/50',
                    ]}
                  >
                    {isSpotify ? '♪' : '▶'}
                  </div>
                )}
                <div class="min-w-0">
                  <h3 class="text-sm font-bold text-white group-hover:text-cyan-300 transition-colors leading-snug line-clamp-2">
                    {source.name}
                  </h3>
                  {source.publisher && (
                    <p class="text-[11px] font-mono text-slate-400 truncate mt-0.5">
                      {source.publisher}
                    </p>
                  )}
                </div>
              </div>

              <p class="text-xs text-slate-300 mt-3 line-clamp-2 leading-relaxed">
                {source.description || source.category}
              </p>
            </div>

            <div class="mt-4 pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs font-mono">
              <span class="text-[10px] text-cyan-400/90 truncate max-w-[140px]">
                {source.category}
              </span>
              <span class="text-slate-400 group-hover:text-cyan-300 transition-colors">
                ↗
              </span>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- Interactive Episodes Filter & Feed -->
  <section class="mb-14" id="episodes-feed">
    <div class="mb-6 flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <h2 class="text-2xl font-bold text-white tracking-tight">{t.recentEpisodesTitle}</h2>
        <p class="text-xs font-mono text-slate-400 mt-1">{t.recentEpisodesSubtitle}</p>
      </div>
      <div class="text-xs font-mono text-slate-400" id="results-count">
        {lang === 'cs' ? `Zobrazeno ${initialEpisodes.length} z ${totalEpisodes} epizod` : `Showing ${initialEpisodes.length} of ${totalEpisodes} episodes`}
      </div>
    </div>

    <!-- Filter Bar Container -->
    <div class="panel-surface rounded-xl p-5 mb-8 border border-slate-800 space-y-4">
      <!-- Search Input & Platform Switcher Row -->
      <div class="flex flex-col lg:flex-row gap-3 items-stretch lg:items-center justify-between">
        <!-- Live Search Field -->
        <div class="relative flex-1">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input
            type="text"
            id="episode-search-input"
            placeholder={t.searchPlaceholder}
            class="w-full pl-10 pr-4 py-2 rounded-lg bg-slate-900 border border-slate-700/80 text-white placeholder-slate-400 text-xs font-mono focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition-all"
          />
        </div>

        <!-- Platform Toggle Buttons -->
        <div class="flex items-center gap-1.5 shrink-0" id="platform-filter">
          <button
            type="button"
            class="platform-btn px-3 py-1.5 rounded-lg text-xs font-mono font-semibold bg-cyan-500/15 text-cyan-300 border border-cyan-500/40 transition-all"
            data-platform="all"
          >
            {t.filterPlatformAll}
          </button>
          <button
            type="button"
            class="platform-btn px-3 py-1.5 rounded-lg text-xs font-mono font-semibold bg-slate-900 text-slate-400 border border-slate-800 hover:border-slate-700 hover:text-slate-200 transition-all flex items-center gap-1.5"
            data-platform="spotify"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            <span>Spotify</span>
          </button>
          <button
            type="button"
            class="platform-btn px-3 py-1.5 rounded-lg text-xs font-mono font-semibold bg-slate-900 text-slate-400 border border-slate-800 hover:border-slate-700 hover:text-slate-200 transition-all flex items-center gap-1.5"
            data-platform="youtube"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span>
            <span>YouTube</span>
          </button>
        </div>
      </div>

      <!-- Category Filter Pills -->
      <div class="pt-2 border-t border-slate-800/80">
        <div class="flex flex-wrap items-center gap-2" id="category-filter">
          <button
            type="button"
            class="category-btn px-3 py-1 rounded-full text-[11px] font-mono font-semibold whitespace-nowrap bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 transition-all"
            data-category="all"
          >
            {t.filterAll}
          </button>
          {uniqueCategories.map((cat) => (
            <button
              type="button"
              class="category-btn px-3 py-1 rounded-full text-[11px] font-mono font-semibold whitespace-nowrap bg-slate-900 text-slate-400 border border-slate-800 hover:border-cyan-500/40 hover:text-slate-200 transition-all"
              data-category={cat}
            >
              {cat}
            </button>
          ))}
        </div>
      </div>

      <!-- Quick Topics Pills -->
      <div class="pt-2 border-t border-slate-800/80 flex flex-wrap items-center gap-1.5">
        <span class="text-[10px] font-mono uppercase text-slate-400 mr-1.5">
          {lang === 'cs' ? 'Populární témata:' : 'Top Topics:'}
        </span>
        {topTopics.map((topic) => (
          <button
            type="button"
            class="topic-quick-btn px-2.5 py-0.5 rounded text-[10px] font-mono bg-slate-900/90 text-slate-300 border border-slate-800 hover:border-cyan-500/50 hover:text-cyan-300 transition-colors"
            data-topic={topic}
          >
            #{topic}
          </button>
        ))}
      </div>
    </div>

    <!-- Episodes Grid (SSR renders initial 24 episodes for crawlability & ultra-light HTML payload) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="episodes-container">
      {initialEpisodes.map((ep) => {
        const isSpotify = ep.external_url?.includes('spotify.com');
        const releaseFormatted = formatDate(ep.release_date);
        const durationFormatted = formatDuration(ep.duration_ms);
        const textContent = lang === 'cs' ? ep.summary || ep.description : ep.description || ep.summary;

        return (
          <article
            class="episode-card panel-surface-interactive rounded-xl p-5 flex flex-col justify-between group border border-slate-800/80 hover:border-cyan-500/40 transition-all"
            data-platform={isSpotify ? 'spotify' : 'youtube'}
            data-category={ep.category}
            data-title={(ep.title || '').toLowerCase()}
            data-show={(ep.show_name || '').toLowerCase()}
            data-topics={(ep.topics || []).join(' ').toLowerCase()}
            data-keywords={(ep.keywords || []).join(' ').toLowerCase()}
            data-search={`${ep.title || ''} ${ep.show_name || ''} ${ep.category || ''} ${(ep.topics || []).join(' ')} ${(ep.keywords || []).join(' ')} ${ep.summary || ''}`.toLowerCase()}
          >
            <div>
              <!-- Header Badges -->
              <div class="flex items-center justify-between gap-2 mb-3">
                <span
                  class:list={[
                    'text-[10px] font-mono uppercase px-2 py-0.5 rounded border font-semibold flex items-center gap-1.5',
                    isSpotify
                      ? 'bg-emerald-500/10 text-emerald-300 border-emerald-500/30'
                      : 'bg-rose-500/10 text-rose-300 border-rose-500/30',
                  ]}
                >
                  <span class="w-1.5 h-1.5 rounded-full" class:list={[isSpotify ? 'bg-emerald-400' : 'bg-rose-400']}></span>
                  <span>{isSpotify ? 'Spotify' : 'YouTube'}</span>
                </span>

                <div class="flex items-center gap-2 text-[11px] font-mono text-slate-400">
                  <span>{durationFormatted}</span>
                  {releaseFormatted && <span>• {releaseFormatted}</span>}
                </div>
              </div>

              <!-- Show Name -->
              <div class="text-xs font-mono font-semibold text-cyan-400/90 mb-1 truncate">
                {ep.show_name}
              </div>

              <!-- Episode Title -->
              <h3 class="text-base font-bold text-white group-hover:text-cyan-300 transition-colors leading-snug line-clamp-2">
                <a
                  href={ep.external_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:underline"
                >
                  {ep.title}
                </a>
              </h3>

              <!-- Category Badge -->
              <div class="mt-2.5 flex items-center gap-2">
                <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded bg-slate-900 text-slate-300 border border-slate-800">
                  {ep.category}
                </span>
                {ep.relevance_score && ep.relevance_score >= 0.85 && (
                  <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-300 border border-amber-500/20">
                    ★ {Math.round(ep.relevance_score * 100)}% Match
                  </span>
                )}
              </div>

              <!-- Executive AI Summary / Description -->
              {textContent && (
                <div class="mt-3 p-3 rounded-lg bg-slate-900/80 border border-slate-800/80">
                  <span class="text-[10px] font-mono text-cyan-400/80 block mb-1.5 font-semibold uppercase tracking-wider">
                    {lang === 'cs' ? '✦ AI Shrnutí (Gemini):' : '✦ Key Insights:'}
                  </span>
                  <p class:list={[
                    'text-xs text-slate-300 leading-relaxed',
                    lang === 'en' ? 'line-clamp-4' : '',
                  ]}>
                    {textContent}
                  </p>
                </div>
              )}

              <!-- Topics & Keywords Badges -->
              {ep.topics && ep.topics.length > 0 && (
                <div class="mt-3.5 flex flex-wrap gap-1">
                  {ep.topics.slice(0, 4).map((topic) => (
                    <button
                      type="button"
                      class="topic-inline-pill text-[10px] font-mono px-2 py-0.5 rounded bg-slate-800/70 text-slate-300 border border-slate-700/60 hover:border-cyan-400/60 hover:text-cyan-300 transition-colors"
                      data-topic={topic}
                    >
                      #{topic}
                    </button>
                  ))}
                </div>
              )}
            </div>

            <!-- Footer CTA -->
            <div class="mt-5 pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs font-mono">
              <span class="text-slate-400 text-[11px] truncate max-w-[120px]">
                {ep.keywords?.[0] || ep.category}
              </span>
              <a
                href={ep.external_url}
                target="_blank"
                rel="noopener noreferrer"
                class:list={[
                  'px-3 py-1.5 rounded font-bold transition-colors inline-flex items-center gap-1.5',
                  isSpotify
                    ? 'bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 hover:bg-emerald-400 hover:text-slate-950'
                    : 'bg-rose-500/10 border border-rose-500/30 text-rose-300 hover:bg-rose-400 hover:text-slate-950',
                ]}
              >
                <span>{isSpotify ? t.listenOnSpotify : t.watchOnYouTube}</span>
              </a>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Load More Button -->
    <div id="load-more-container" class="mt-10 flex justify-center">
      <button
        type="button"
        id="load-more-btn"
        class="px-6 py-2.5 rounded-lg text-xs font-mono font-semibold bg-cyan-500/15 text-cyan-300 border border-cyan-500/40 hover:bg-cyan-500/25 transition-all cursor-pointer"
      >
        {t.loadMore}
      </button>
    </div>

    <!-- Hidden metadata for client script -->
    <div
      id="podcasts-meta"
      class="hidden"
      data-lang={lang}
      data-duration-min={t.durationMin}
      data-listen-spotify={t.listenOnSpotify}
      data-watch-youtube={t.watchOnYouTube}
      data-total-episodes={totalEpisodes}
    ></div>

    <!-- No Results State -->
    <div id="no-results-state" class="hidden panel-surface rounded-xl p-12 text-center border border-slate-800 my-8">
      <div class="w-12 h-12 rounded-full bg-slate-900 border border-slate-800 text-slate-400 flex items-center justify-center mx-auto mb-3 font-mono text-xl">
        ∅
      </div>
      <h3 class="text-base font-bold text-white">{t.noResultsTitle}</h3>
      <p class="text-xs text-slate-400 mt-1 max-w-md mx-auto">{t.noResultsText}</p>
      <button
        type="button"
        id="reset-filters-btn"
        class="mt-4 px-4 py-2 rounded-lg text-xs font-mono font-semibold bg-cyan-500/15 text-cyan-300 border border-cyan-500/40 hover:bg-cyan-500/25 transition-all"
      >
        {t.resetFilters}
      </button>
    </div>
  </section>

  <!-- Connect with Roles Labour Market Intelligence -->
  <section class="mb-14 p-6 sm:p-8 rounded-xl panel-surface border-t-2 border-t-emerald-400">
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
      <div class="max-w-2xl">
        <span class="text-xs font-mono uppercase tracking-widest text-emerald-400">
          {t.rolesConnectionTag}
        </span>
        <h2 class="text-2xl font-bold text-white tracking-tight mt-1">
          {t.rolesConnectionTitle}
        </h2>
        <p class="text-xs sm:text-sm text-slate-300 mt-2 leading-relaxed">
          {t.rolesConnectionSubtitle}
        </p>
      </div>
      <a
        href={lang === 'cs' ? '/cs/roles' : '/roles'}
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-xs font-mono font-semibold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30 hover:bg-emerald-500/25 transition-all shrink-0"
      >
        {t.exploreRolesBtn}
      </a>
    </div>
  </section>
</Layout>

<script is:inline>
  // Progressive Client-Side Hydration, Paging & Filtering
  document.addEventListener('DOMContentLoaded', () => {
    const metaEl = document.getElementById('podcasts-meta');
    const lang = metaEl ? metaEl.getAttribute('data-lang') || 'en' : 'en';
    const durationMinText = metaEl ? metaEl.getAttribute('data-duration-min') || 'min' : 'min';
    const listenSpotifyText = metaEl ? metaEl.getAttribute('data-listen-spotify') || 'Listen on Spotify ↗' : 'Listen on Spotify ↗';
    const watchYouTubeText = metaEl ? metaEl.getAttribute('data-watch-youtube') || 'Watch on YouTube ↗' : 'Watch on YouTube ↗';
    const isCs = lang === 'cs';

    const searchInput = document.getElementById('episode-search-input');
    const platformBtns = document.querySelectorAll('.platform-btn');
    const categoryBtns = document.querySelectorAll('.category-btn');
    const episodesContainer = document.getElementById('episodes-container');
    const resultsCountEl = document.getElementById('results-count');
    const noResultsEl = document.getElementById('no-results-state');
    const resetBtn = document.getElementById('reset-filters-btn');
    const loadMoreContainer = document.getElementById('load-more-container');
    const loadMoreBtn = document.getElementById('load-more-btn');

    const BATCH_SIZE = 24;
    let currentPlatform = 'all';
    let currentCategory = 'all';
    let currentSearch = '';
    let renderedCount = BATCH_SIZE;
    let allEpisodes = null;
    let filteredEpisodes = [];

    // Parse URL search parameters on initial load
    const urlParams = new URLSearchParams(window.location.search);
    const initialCategory = urlParams.get('category');
    const initialSearch = urlParams.get('search');
    const initialPlatform = urlParams.get('platform');

    if (initialPlatform) currentPlatform = initialPlatform;
    if (initialCategory) currentCategory = initialCategory;
    if (initialSearch) {
      currentSearch = initialSearch.toLowerCase();
      if (searchInput) searchInput.value = initialSearch;
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function formatDate(dateStr) {
      if (!dateStr) return '';
      try {
        const d = new Date(dateStr);
        return d.toLocaleDateString(isCs ? 'cs-CZ' : 'en-US', {
          year: 'numeric',
          month: 'short',
          day: 'numeric',
        });
      } catch {
        return dateStr;
      }
    }

    function formatDuration(ms) {
      if (!ms || ms <= 0) return isCs ? 'Video epizoda' : 'Video Episode';
      const minutes = Math.round(ms / 60000);
      return `${minutes} ${durationMinText}`;
    }

    function createCardHtml(ep) {
      const isSpotify = ep.external_url && ep.external_url.includes('spotify.com');
      const releaseFormatted = formatDate(ep.release_date);
      const durationFormatted = formatDuration(ep.duration_ms);
      const textContent = isCs ? ep.summary || ep.description : ep.description || ep.summary;

      const topicsHtml = (ep.topics && ep.topics.length > 0)
        ? `<div class="mt-3.5 flex flex-wrap gap-1">
            ${ep.topics.slice(0, 4).map((t) => `
              <button type="button" class="topic-inline-pill text-[10px] font-mono px-2 py-0.5 rounded bg-slate-800/70 text-slate-300 border border-slate-700/60 hover:border-cyan-400/60 hover:text-cyan-300 transition-colors" data-topic="${escapeHtml(t)}">
                #${escapeHtml(t)}
              </button>
            `).join('')}
          </div>`
        : '';

      const matchBadge = (ep.relevance_score && ep.relevance_score >= 0.85)
        ? `<span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-300 border border-amber-500/20">★ ${Math.round(ep.relevance_score * 100)}% Match</span>`
        : '';

      const summaryBox = textContent
        ? `<div class="mt-3 p-3 rounded-lg bg-slate-900/80 border border-slate-800/80">
            <span class="text-[10px] font-mono text-cyan-400/80 block mb-1.5 font-semibold uppercase tracking-wider">
              ${isCs ? '✦ AI Shrnutí (Gemini):' : '✦ Key Insights:'}
            </span>
            <p class="text-xs text-slate-300 leading-relaxed ${!isCs ? 'line-clamp-4' : ''}">
              ${escapeHtml(textContent)}
            </p>
          </div>`
        : '';

      return `
        <article
          class="episode-card panel-surface-interactive rounded-xl p-5 flex flex-col justify-between group border border-slate-800/80 hover:border-cyan-500/40 transition-all"
          data-platform="${isSpotify ? 'spotify' : 'youtube'}"
          data-category="${escapeHtml(ep.category || '')}"
        >
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded border font-semibold flex items-center gap-1.5 ${isSpotify ? 'bg-emerald-500/10 text-emerald-300 border-emerald-500/30' : 'bg-rose-500/10 text-rose-300 border-rose-500/30'}">
                <span class="w-1.5 h-1.5 rounded-full ${isSpotify ? 'bg-emerald-400' : 'bg-rose-400'}"></span>
                <span>${isSpotify ? 'Spotify' : 'YouTube'}</span>
              </span>
              <div class="flex items-center gap-2 text-[11px] font-mono text-slate-400">
                <span>${escapeHtml(durationFormatted)}</span>
                ${releaseFormatted ? `<span>• ${escapeHtml(releaseFormatted)}</span>` : ''}
              </div>
            </div>

            <div class="text-xs font-mono font-semibold text-cyan-400/90 mb-1 truncate">
              ${escapeHtml(ep.show_name || '')}
            </div>

            <h3 class="text-base font-bold text-white group-hover:text-cyan-300 transition-colors leading-snug line-clamp-2">
              <a href="${escapeHtml(ep.external_url || '#')}" target="_blank" rel="noopener noreferrer" class="hover:underline">
                ${escapeHtml(ep.title || '')}
              </a>
            </h3>

            <div class="mt-2.5 flex items-center gap-2">
              <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded bg-slate-900 text-slate-300 border border-slate-800">
                ${escapeHtml(ep.category || '')}
              </span>
              ${matchBadge}
            </div>

            ${summaryBox}
            ${topicsHtml}
          </div>

          <div class="mt-5 pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs font-mono">
            <span class="text-slate-400 text-[11px] truncate max-w-[120px]">
              ${escapeHtml(ep.keywords?.[0] || ep.category || '')}
            </span>
            <a href="${escapeHtml(ep.external_url || '#')}" target="_blank" rel="noopener noreferrer" class="px-3 py-1.5 rounded font-bold transition-colors inline-flex items-center gap-1.5 ${isSpotify ? 'bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 hover:bg-emerald-400 hover:text-slate-950' : 'bg-rose-500/10 border border-rose-500/30 text-rose-300 hover:bg-rose-400 hover:text-slate-950'}">
              <span>${isSpotify ? listenSpotifyText : watchYouTubeText}</span>
            </a>
          </div>
        </article>
      `;
    }

    function updateResultsUI() {
      const totalMatching = filteredEpisodes.length;
      const countToShow = Math.min(renderedCount, totalMatching);

      if (resultsCountEl) {
        resultsCountEl.textContent = isCs
          ? `Zobrazeno ${countToShow} z ${totalMatching} epizod`
          : `Showing ${countToShow} of ${totalMatching} episodes`;
      }

      if (noResultsEl) {
        if (totalMatching === 0) {
          noResultsEl.classList.remove('hidden');
        } else {
          noResultsEl.classList.add('hidden');
        }
      }

      if (loadMoreContainer) {
        if (countToShow >= totalMatching || totalMatching === 0) {
          loadMoreContainer.classList.add('hidden');
        } else {
          loadMoreContainer.classList.remove('hidden');
        }
      }
    }

    function renderBatch(append = false) {
      if (!episodesContainer) return;
      const startIndex = append ? renderedCount - BATCH_SIZE : 0;
      const endIndex = Math.min(renderedCount, filteredEpisodes.length);
      const batch = filteredEpisodes.slice(startIndex, endIndex);

      const html = batch.map(createCardHtml).join('');
      if (append) {
        episodesContainer.insertAdjacentHTML('beforeend', html);
      } else {
        episodesContainer.innerHTML = html;
      }

      updateResultsUI();
    }

    function applyFilters() {
      if (!allEpisodes) return;

      filteredEpisodes = allEpisodes.filter((ep) => {
        const isSpotify = ep.external_url && ep.external_url.includes('spotify.com');
        const platform = isSpotify ? 'spotify' : 'youtube';
        if (currentPlatform !== 'all' && platform !== currentPlatform) return false;
        if (currentCategory !== 'all' && ep.category !== currentCategory) return false;

        if (currentSearch) {
          const haystack = [
            ep.title || '',
            ep.show_name || '',
            ep.category || '',
            (ep.topics || []).join(' '),
            (ep.keywords || []).join(' '),
            ep.summary || '',
            ep.description || '',
          ].join(' ').toLowerCase();

          if (!haystack.includes(currentSearch)) return false;
        }

        return true;
      });

      renderedCount = BATCH_SIZE;
      renderBatch(false);

      // Update button active styling
      platformBtns.forEach((btn) => {
        const p = btn.getAttribute('data-platform');
        if (p === currentPlatform) {
          btn.className = 'platform-btn px-3 py-1.5 rounded-lg text-xs font-mono font-semibold bg-cyan-500/15 text-cyan-300 border border-cyan-500/40 transition-all';
        } else {
          btn.className = 'platform-btn px-3 py-1.5 rounded-lg text-xs font-mono font-semibold bg-slate-900 text-slate-400 border border-slate-800 hover:border-slate-700 hover:text-slate-200 transition-all';
        }
      });

      categoryBtns.forEach((btn) => {
        const c = btn.getAttribute('data-category');
        if (c === currentCategory) {
          btn.className = 'category-btn px-3 py-1 rounded-full text-[11px] font-mono font-semibold whitespace-nowrap bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 transition-all';
        } else {
          btn.className = 'category-btn px-3 py-1 rounded-full text-[11px] font-mono font-semibold whitespace-nowrap bg-slate-900 text-slate-400 border border-slate-800 hover:border-cyan-500/40 hover:text-slate-200 transition-all';
        }
      });
    }

    // Load full dataset in background
    fetch('/data/podcasts.json')
      .then((r) => r.json())
      .then((data) => {
        allEpisodes = data.episodes || [];
        filteredEpisodes = allEpisodes;

        // If URL params exist or user typed before fetch completed:
        if (currentPlatform !== 'all' || currentCategory !== 'all' || currentSearch) {
          applyFilters();
        } else {
          updateResultsUI();
        }
      })
      .catch((err) => {
        console.error('Failed to load podcasts data:', err);
      });

    // Load More click handler
    if (loadMoreBtn) {
      loadMoreBtn.addEventListener('click', () => {
        if (!allEpisodes) return;
        renderedCount += BATCH_SIZE;
        renderBatch(true);
      });
    }

    // Live search input
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        currentSearch = (e.target.value || '').trim().toLowerCase();
        applyFilters();
      });
    }

    // Platform switcher
    platformBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentPlatform = btn.getAttribute('data-platform') || 'all';
        applyFilters();
      });
    });

    // Category switcher
    categoryBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentCategory = btn.getAttribute('data-category') || 'all';
        applyFilters();
      });
    });

    // Topic quick pills (using event delegation for SSR + dynamic cards)
    document.addEventListener('click', (e) => {
      const topicBtn = e.target.closest('.topic-quick-btn, .topic-inline-pill');
      if (topicBtn) {
        e.preventDefault();
        const topic = topicBtn.getAttribute('data-topic');
        if (topic) {
          currentSearch = topic.toLowerCase();
          if (searchInput) searchInput.value = topic;
          applyFilters();
          const feedEl = document.getElementById('episodes-feed');
          if (feedEl) feedEl.scrollIntoView({ behavior: 'smooth' });
        }
      }
    });

    // Reset button
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        currentPlatform = 'all';
        currentCategory = 'all';
        currentSearch = '';
        if (searchInput) searchInput.value = '';
        applyFilters();
      });
    }
  });
</script>
