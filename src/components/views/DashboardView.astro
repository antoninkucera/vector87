---
import Layout from '../../layouts/Layout.astro';
import MarketTrendChart from '../MarketTrendChart.astro';
import marketData from '../../data/market-data.json';
import { TOP_SPOTLIGHT_COUNTRIES } from '../../data/opportunity-matrix';
import { TECHNOLOGIES_CATALOG } from '../../data/technologies';
import { ui, getLocalePath, type Locale } from '../../i18n/ui';
import NewsletterCta from '../NewsletterCta.astro';
import ShareBar from '../ShareBar.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang].dashboard;

const {
  meta,
  market_vitality,
  tech_cloud_stack,
  hierarchy_shift,
  trend_radar,
  time_series,
} = marketData;

const topCompaniesSlice = market_vitality.top_hiring_companies.slice(0, 8);

// 4 Top Anchor Roles for Lean Grid
const topSpotlightRoles = [
  marketData.roles.find((r) => r.category_id === 'ml_engineer') || marketData.roles[0],
  marketData.roles.find((r) => r.category_id === 'ai_developer') || marketData.roles[1],
  marketData.roles.find((r) => r.category_id === 'data_engineer') || marketData.roles[2],
  marketData.roles.find((r) => r.category_id === 'analytics_engineer') || marketData.roles[3],
];

// Top Core Technologies for Lean Stack Preview
const topTechSlice = tech_cloud_stack.top_technologies.slice(0, 6);
const topTechIds = new Set(topTechSlice.map((t) => t.skill_id));
const radarKeywords = trend_radar.keywords.filter((k) => !topTechIds.has(k.skill_id)).slice(0, 8);

const sp500AdoptionPct = Math.round((market_vitality.sp500_hiring_companies / meta.sp500_tracked_companies) * 100);

const dashboardJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://vector87.com/#website',
      url: 'https://vector87.com/',
      name: 'Vector87',
      description: t.pageDescription,
      inLanguage: lang,
    },
    {
      '@type': 'Organization',
      '@id': 'https://vector87.com/#organization',
      name: 'Vector87',
      url: 'https://vector87.com/',
      logo: 'https://vector87.com/favicon.svg',
      founder: {
        '@type': 'Person',
        name: 'Antonín Kučera',
        url: 'https://akucera.eu',
      },
    },
    {
      '@type': 'Dataset',
      '@id': 'https://vector87.com/#dataset',
      name: 'S&P 500 AI & Data Job Market Intelligence',
      description: t.pageDescription,
      url: 'https://vector87.com/',
      license: 'https://creativecommons.org/licenses/by/4.0/',
      creator: {
        '@id': 'https://vector87.com/#organization',
      },
      temporalCoverage: meta.latest_snapshot_date,
      spatialCoverage: 'Global, US, Europe',
      variableMeasured: [
        'AI/Data Hiring Intensity',
        'Cloud Hyperscaler Adoption',
        'Canonical Role Penetration',
        'Compensation Benchmarks',
      ],
    },
  ],
};
---

<Layout title={t.pageTitle} description={t.pageDescription} activeNav="dashboard" lang={lang} jsonLd={dashboardJsonLd}>
  <!-- 00: HERO HEADER & VALUE PROPOSITION -->
  <section class="mb-10 pb-8 border-b border-slate-800/80">
    <div class="space-y-6 max-w-4xl">
      <div class="space-y-3">
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 text-xs font-mono">
          <span>{t.heroBadge}</span>
          <span class="text-slate-500">•</span>
          <span>SNAPSHOT {meta.latest_snapshot_date}</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white leading-tight">
          {t.heroTitlePrefix}
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-300 via-cyan-400 to-blue-500">
            {t.heroTitleHighlight}
          </span>
        </h1>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed max-w-3xl font-light">
          {t.heroDescription(meta.sp500_tracked_companies)}
        </p>
      </div>

      <!-- Hero Fast Numbers Bar -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 py-2">
        <div class="p-3 rounded-lg bg-slate-900/60 border border-slate-800">
          <span class="text-[10px] font-mono uppercase text-slate-400 block">{lang === 'cs' ? 'Aktivní inzeráty' : 'Verified Open Jobs'}</span>
          <span class="text-xl sm:text-2xl font-bold font-mono text-cyan-300">{market_vitality.total_ai_data_jobs.toLocaleString('en-US')}</span>
        </div>
        <div class="p-3 rounded-lg bg-slate-900/60 border border-slate-800">
          <span class="text-[10px] font-mono uppercase text-slate-400 block">{lang === 'cs' ? 'Kanonické role' : 'Canonical Roles'}</span>
          <span class="text-xl sm:text-2xl font-bold font-mono text-white">21</span>
        </div>
        <div class="p-3 rounded-lg bg-slate-900/60 border border-slate-800">
          <span class="text-[10px] font-mono uppercase text-slate-400 block">{lang === 'cs' ? 'Sledované země' : 'Target Countries'}</span>
          <span class="text-xl sm:text-2xl font-bold font-mono text-emerald-400">29</span>
        </div>
        <div class="p-3 rounded-lg bg-slate-900/60 border border-slate-800">
          <span class="text-[10px] font-mono uppercase text-slate-400 block">{lang === 'cs' ? 'AI Premium (Platy)' : 'AI Salary Premium'}</span>
          <span class="text-xl sm:text-2xl font-bold font-mono text-indigo-300">+24.0%</span>
        </div>
      </div>

      <!-- Primary Action Buttons -->
      <div class="flex flex-wrap items-center gap-3 pt-1">
        <a
          href={lang === 'cs' ? '/cs/academy/analyzer/' : '/academy/analyzer/'}
          class="px-4 py-2.5 rounded-lg bg-gradient-to-r from-cyan-400 to-cyan-300 text-slate-950 font-mono text-xs font-bold hover:brightness-110 transition-all shadow-lg shadow-cyan-950/50 inline-flex items-center gap-2"
        >
          <span>✨</span>
          <span>{lang === 'cs' ? 'Spustit Skill Gap Analyzer' : 'Launch Skill Gap Analyzer'}</span>
        </a>
        <a
          href={getLocalePath(lang, 'roles')}
          class="px-4 py-2.5 rounded-lg border border-slate-700 bg-slate-900/90 text-slate-200 font-mono text-xs font-semibold hover:border-cyan-400/50 hover:text-cyan-300 transition-colors"
        >
          {t.ctaRoles}
        </a>
        <a
          href={getLocalePath(lang, 'countries')}
          class="px-4 py-2.5 rounded-lg border border-emerald-500/40 bg-emerald-950/40 text-emerald-300 font-mono text-xs font-semibold hover:border-emerald-400 hover:text-emerald-200 transition-colors inline-flex items-center gap-1.5"
        >
          <span>{t.ctaPlaces}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 01: EXECUTIVE BRIEF & MARKET PULSE -->
  <section class="mb-14 scroll-mt-20">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 mb-6">
      <div>
        <span class="text-xs font-mono uppercase tracking-widest text-cyan-400">EXECUTIVE BRIEF</span>
        <h2 class="text-2xl font-bold text-white tracking-tight mt-0.5">{t.takeawaysTitle}</h2>
      </div>
      <p class="text-xs font-mono text-slate-400">{t.takeawaysSub}</p>
    </div>

    <!-- 3 Key Takeaways Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
      <div class="p-5 rounded-xl panel-surface border border-slate-800 space-y-2 border-l-2 border-l-cyan-400">
        <span class="text-[10px] font-mono uppercase tracking-wider text-cyan-400 font-semibold">{t.takeaway1Tag}</span>
        <h3 class="text-base font-bold text-white">{t.takeaway1Title}</h3>
        <p class="text-xs text-slate-300 leading-relaxed font-sans font-light">{t.takeaway1Desc}</p>
      </div>

      <div class="p-5 rounded-xl panel-surface border border-slate-800 space-y-2 border-l-2 border-l-blue-400">
        <span class="text-[10px] font-mono uppercase tracking-wider text-blue-400 font-semibold">{t.takeaway2Tag}</span>
        <h3 class="text-base font-bold text-white">{t.takeaway2Title}</h3>
        <p class="text-xs text-slate-300 leading-relaxed font-sans font-light">{t.takeaway2Desc}</p>
      </div>

      <div class="p-5 rounded-xl panel-surface border border-slate-800 space-y-2 border-l-2 border-l-emerald-400">
        <span class="text-[10px] font-mono uppercase tracking-wider text-emerald-400 font-semibold">{t.takeaway3Tag}</span>
        <h3 class="text-base font-bold text-white">{t.takeaway3Title}</h3>
        <p class="text-xs text-slate-300 leading-relaxed font-sans font-light">{t.takeaway3Desc}</p>
      </div>
    </div>

    <!-- Market KPIs + Top Hiring Companies Chart -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      <!-- 4 KPI Metrics -->
      <div class="lg:col-span-5 grid grid-cols-2 gap-3">
        <div class="panel-surface rounded-xl p-4 border-l-2 border-l-cyan-400">
          <p class="text-[10px] font-mono uppercase text-slate-400">{t.kpi1Title}</p>
          <div class="mt-1 text-2xl font-bold font-mono text-cyan-300">{market_vitality.sp500_ai_intensity_pct}%</div>
          <p class="text-[11px] text-slate-400 mt-1 font-mono">{t.kpi1Sub}</p>
        </div>

        <div class="panel-surface rounded-xl p-4 border-l-2 border-l-blue-500">
          <p class="text-[10px] font-mono uppercase text-slate-400">{t.kpi2Title}</p>
          <div class="mt-1 text-2xl font-bold font-mono text-white">{market_vitality.total_ai_data_jobs.toLocaleString('en-US')}</div>
          <p class="text-[11px] text-emerald-400 mt-1 font-mono">{market_vitality.overall_ai_intensity_pct}% {t.kpi2Sub}</p>
        </div>

        <div class="panel-surface rounded-xl p-4 border-l-2 border-l-emerald-400">
          <p class="text-[10px] font-mono uppercase text-slate-400">{t.kpi3Title}</p>
          <div class="mt-1 text-2xl font-bold font-mono text-emerald-400">
            {market_vitality.sp500_hiring_companies}
            <span class="text-xs text-slate-500">/{meta.sp500_tracked_companies}</span>
          </div>
          <p class="text-[11px] text-slate-400 mt-1 font-mono">{sp500AdoptionPct}% {lang === 'cs' ? 'firem nabírá' : 'adoption'}</p>
        </div>

        <div class="panel-surface rounded-xl p-4 border-l-2 border-l-amber-400">
          <p class="text-[10px] font-mono uppercase text-slate-400">{t.kpi4Title}</p>
          <div class="mt-1 text-xl font-bold font-mono text-amber-300">
            {market_vitality.cz_ai_data_jobs} <span class="text-xs text-slate-400 font-normal">CZ</span>
          </div>
          <p class="text-[11px] text-slate-400 mt-1 font-mono">v {market_vitality.regional_breakdown.length} zemích</p>
        </div>

        <div class="col-span-2 p-3.5 rounded-xl bg-slate-900/60 border border-slate-800 text-xs font-mono text-slate-300 flex items-center justify-between">
          <span class="text-slate-400">{lang === 'cs' ? 'Hledáte detailní srovnání technologií?' : 'Looking for complete technology insights?'}</span>
          <a href={lang === 'cs' ? '/cs/cloud-tech/' : '/cloud-tech/'} class="text-cyan-400 hover:text-cyan-300 font-semibold inline-flex items-center gap-1">
            <span>{lang === 'cs' ? 'Cloud & Tech Hub' : 'Cloud & Tech Hub'}</span>
            <span>→</span>
          </a>
        </div>
      </div>

      <!-- Top Companies Bar Chart -->
      <div class="lg:col-span-7">
        <MarketTrendChart
          chartId="chart-top-companies"
          title={t.chartTopCompTitle}
          subtitle={t.chartTopCompSub}
          badge="LIVE ATS POOL"
          type="horizontalBar"
          labels={topCompaniesSlice.map((c) => c.company_name)}
          datasets={[
            {
              label: t.chartTopCompLabel,
              data: topCompaniesSlice.map((c) => c.ai_data_jobs),
              backgroundColor: 'rgba(34, 211, 238, 0.75)',
              borderColor: '#22d3ee',
              borderWidth: 1,
              borderRadius: 4,
            },
          ]}
          heightClass="h-72"
        />
      </div>
    </div>
  </section>

  <!-- 02: FEATURE SPOTLIGHT: SKILL GAP ANALYZER (KDE STOJÍTE VY?) -->
  <section class="mb-14 p-6 sm:p-8 rounded-2xl bg-gradient-to-br from-cyan-950/30 via-slate-900 to-indigo-950/20 border border-cyan-500/40 shadow-xl shadow-cyan-950/20 relative overflow-hidden">
    <div class="absolute -right-12 -bottom-12 w-64 h-64 bg-cyan-500/5 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-3xl space-y-4">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-cyan-500/15 border border-cyan-500/30 text-cyan-300 text-xs font-mono">
        <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
        <span>04 // INTERACTIVE CAREER MATCHER & GAP ANALYSIS</span>
      </div>

      <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
        {lang === 'cs' ? 'Změřte si shodu svých dovedností s 21 kanonickými rolemi' : 'Calculate Your Skill Gap Against 21 Canonical Roles'}
      </h2>

      <p class="text-sm sm:text-base text-slate-300 leading-relaxed font-light">
        {lang === 'cs'
          ? 'Zvolte svůj současný technologický stack (např. Python, SQL, dbt, BigQuery, PyTorch). Náš matching engine porovná váš profil s tisíci inzerátů a okamžitě odhalí vaši kariérní shodu, prioritní chybějící dovednosti i doporučené kurzy pro další kariérní skok.'
          : 'Select your current tech stack (e.g. Python, SQL, dbt, BigQuery, PyTorch). Our matching engine compares your profile against thousands of verified postings, revealing your strongest career matches, exact missing skills, and curated learning paths to close the gap.'}
      </p>

      <!-- Preset profile shortcuts -->
      <div class="pt-2 flex flex-wrap gap-2 text-xs font-mono">
        <span class="text-slate-400 py-1">{lang === 'cs' ? 'Populární profily:' : 'Popular profiles:'}</span>
        <span class="px-2.5 py-1 rounded bg-slate-800/80 border border-slate-700 text-cyan-300">📊 BI Analyst</span>
        <span class="px-2.5 py-1 rounded bg-slate-800/80 border border-slate-700 text-cyan-300">🏗️ Analytics Engineer</span>
        <span class="px-2.5 py-1 rounded bg-slate-800/80 border border-slate-700 text-cyan-300">⚙️ Data Engineer</span>
        <span class="px-2.5 py-1 rounded bg-slate-800/80 border border-slate-700 text-cyan-300">🤖 Applied AI Dev</span>
      </div>

      <div class="pt-4 flex flex-wrap items-center gap-4">
        <a
          href={lang === 'cs' ? '/cs/academy/analyzer/' : '/academy/analyzer/'}
          class="px-5 py-2.5 rounded-lg bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-mono text-xs font-bold transition-all shadow-lg shadow-cyan-950/60 inline-flex items-center gap-2"
        >
          <span>{lang === 'cs' ? 'Spustit Skill Gap Analyzer' : 'Launch Skill Gap Analyzer'}</span>
          <span>→</span>
        </a>
        <a
          href={lang === 'cs' ? '/cs/academy/' : '/academy/'}
          class="text-xs font-mono text-slate-400 hover:text-cyan-300 transition-colors inline-flex items-center gap-1.5"
        >
          <span>{lang === 'cs' ? 'Prohlédnout kurzy a certifikace' : 'Explore Courses & Certifications'}</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 03: CANONICAL ROLES & SALARIES RADAR -->
  <section class="mb-14 scroll-mt-20">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
      <div>
        <span class="text-xs font-mono uppercase tracking-widest text-cyan-400">{t.topRolesTag}</span>
        <h2 class="text-2xl font-bold text-white tracking-tight mt-0.5">{t.topRolesTitle}</h2>
        <p class="text-xs text-slate-400 mt-1">{t.topRolesSub}</p>
      </div>
      <div class="flex items-center gap-3">
        <a
          href={getLocalePath(lang, 'roles')}
          class="inline-flex items-center gap-1.5 text-xs font-mono font-semibold text-cyan-400 hover:text-cyan-300"
        >
          <span>{t.viewAllRolesBtn}</span>
        </a>
      </div>
    </div>

    <!-- 4 Anchor Role Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
      {topSpotlightRoles.map((role) => (
        <article class="p-5 rounded-xl panel-surface border border-slate-800 hover:border-cyan-500/40 transition-all flex flex-col justify-between space-y-4">
          <div class="space-y-2">
            <div class="flex items-center justify-between text-xs font-mono">
              <span class="text-cyan-400 font-bold">{role.domain}</span>
              <span class="text-slate-400">{role.track}</span>
            </div>
            <h3 class="text-base font-bold text-white tracking-tight">
              <a href={`${getLocalePath(lang, 'roles')}/${role.category_id.replace(/_/g, '-')}/`} class="hover:text-cyan-300 transition-colors">
                {role.canonical_name}
              </a>
            </h3>
            <p class="text-xs text-slate-300 line-clamp-2 leading-relaxed font-light">
              {role.synthesized_description[lang][0]}
            </p>
          </div>

          <div class="pt-3 border-t border-slate-800/80 space-y-2 text-xs font-mono">
            <div class="flex items-center justify-between">
              <span class="text-slate-400">{lang === 'cs' ? 'Inzerátů v perimetru:' : 'Active Postings:'}</span>
              <span class="font-bold text-slate-200">{role.job_count.toLocaleString('en-US')}</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-slate-400">{lang === 'cs' ? 'Seniorní podíl:' : 'Senior+ Share:'}</span>
              <span class="text-cyan-300 font-bold">{role.senior_plus_pct}%</span>
            </div>
            <a
              href={`${getLocalePath(lang, 'roles')}/${role.category_id.replace(/_/g, '-')}/`}
              class="w-full text-center py-1.5 rounded bg-slate-800/80 hover:bg-cyan-500/15 hover:text-cyan-300 text-slate-300 transition-colors block text-[11px] font-semibold"
            >
              {lang === 'cs' ? 'Detail role a dovednosti →' : 'Inspect Role & Skills →'}
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Executive Compensation Callout Banner -->
    <div class="p-4 sm:p-5 rounded-xl bg-slate-900/60 border border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <span class="text-2xl">💰</span>
        <div>
          <span class="text-xs font-mono uppercase tracking-wider text-emerald-400 font-bold">
            {lang === 'cs' ? 'Platový benchmark trhu (Salaries Radar)' : 'Compensation & Salary Benchmarks'}
          </span>
          <p class="text-xs text-slate-300 mt-0.5 font-light">
            {lang === 'cs'
              ? '#1 Director / VP of Data & AI ($275k základ / $440k TC). #2 ML Engineer ($195k základ). Porovnejte reálné platy napříč US, UK, EU a ČR.'
              : '#1 Director / VP of Data & AI ($275k Base / $440k TC). #2 ML Engineer ($195k Base). Compare verified benchmark bands across US, UK, EU & CZ.'}
          </p>
        </div>
      </div>
      <a
        href={lang === 'cs' ? '/cs/salaries/' : '/salaries/'}
        class="px-4 py-2 rounded-lg bg-emerald-500/15 hover:bg-emerald-500/25 text-emerald-300 border border-emerald-500/40 text-xs font-mono font-semibold transition-colors shrink-0 inline-flex items-center gap-1.5"
      >
        <span>{lang === 'cs' ? 'Otevřít platový benchmark' : 'Explore Salary Benchmarks'}</span>
        <span>→</span>
      </a>
    </div>
  </section>

  <!-- 04: FUTURE TRACKER & RELOCATION RADAR (KDE ŽÍT DLOUHODOBĚ?) -->
  <section class="mb-14 scroll-mt-20">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
      <div>
        <span class="text-xs font-mono uppercase tracking-widest text-emerald-400">{t.placesTeaserTag}</span>
        <h2 class="text-2xl font-bold text-white tracking-tight mt-0.5">{t.placesTeaserTitle}</h2>
        <p class="text-xs text-slate-400 mt-1 max-w-3xl leading-relaxed">{t.placesTeaserSub}</p>
      </div>
      <a
        href={getLocalePath(lang, 'countries')}
        class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-xs font-mono font-semibold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30 hover:bg-emerald-500/25 transition-colors shrink-0"
      >
        <span>{t.exploreAllPlacesBtn}</span>
      </a>
    </div>

    <!-- 4 Quadrants & Spotlight Destinations Teaser Card -->
    <div class="p-6 sm:p-7 rounded-2xl panel-surface border border-slate-800 space-y-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 text-xs font-mono">
        <div class="p-3.5 rounded-lg bg-slate-900/80 border border-emerald-500/30 border-l-2 border-l-emerald-400">
          <span class="font-bold text-emerald-300 block mb-1">🟢 EASY WINS</span>
          <span class="text-slate-400">{lang === 'cs' ? 'Vysoká kvalita života + volný pohyb EU (např. Nizozemsko, Česko, Irsko).' : 'High QoL + EU free mobility (e.g. Netherlands, Czechia, Ireland).'}</span>
        </div>
        <div class="p-3.5 rounded-lg bg-slate-900/80 border border-amber-500/30 border-l-2 border-l-amber-400">
          <span class="font-bold text-amber-300 block mb-1">🟡 HIGH REWARD / FRICTION</span>
          <span class="text-slate-400">{lang === 'cs' ? 'Extrémní příjmy, ale vízové kvóty (USA, Švýcarsko).' : 'Extreme comp upside, but strict visa barriers (US, Switzerland).'}</span>
        </div>
        <div class="p-3.5 rounded-lg bg-slate-900/80 border border-blue-500/30 border-l-2 border-l-blue-400">
          <span class="font-bold text-blue-300 block mb-1">🔵 LOW FRICTION / LOW COST</span>
          <span class="text-slate-400">{lang === 'cs' ? 'Nízké životní náklady a snadná relokace (Španělsko, Polsko).' : 'Low living costs, high affordability (Spain, Poland).'}</span>
        </div>
        <div class="p-3.5 rounded-lg bg-slate-900/80 border border-rose-500/30 border-l-2 border-l-rose-400">
          <span class="font-bold text-rose-300 block mb-1">🔴 HIGH RISK / LOW FIT</span>
          <span class="text-slate-400">{lang === 'cs' ? 'Regulační bariéry nebo slabý lokální data trh.' : 'Regulatory hurdles or sparse local hiring market.'}</span>
        </div>
      </div>

      <!-- Spotlight destinations preview -->
      <div class="pt-4 border-t border-slate-800/80 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="space-y-1">
          <span class="text-xs font-mono uppercase tracking-wider text-slate-300 font-bold">
            {lang === 'cs' ? 'Doporučené destinace podle dat:' : 'Data-Backed Top Destinations:'}
          </span>
          <p class="text-xs text-slate-400 font-light">
            {lang === 'cs'
              ? '🇨🇭 Švýcarsko (#1 čistý příjem), 🇳🇱 Nizozemsko (#1 technologický hub EU), 🇨🇿 Česko (top poměr lokální kupní síly k nákladům).'
              : '🇨🇭 Switzerland (#1 Disposable Income), 🇳🇱 Netherlands (#1 EU Tech Hub), 🇨🇿 Czechia (Top Purchasing Power to Cost Ratio).'}
          </p>
        </div>
        <a
          href={getLocalePath(lang, 'countries')}
          class="px-4 py-2 rounded-lg bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-300 border border-emerald-500/40 text-xs font-mono font-semibold transition-colors shrink-0 inline-flex items-center gap-1.5"
        >
          <span>{lang === 'cs' ? 'Zobrazit interaktivní 2D mapu a srovnávač 29 zemí' : 'Open Interactive 2D Map & 29-Country Index'}</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 05: TECH STACK & CLOUD RADAR -->
  <section class="mb-14 scroll-mt-20">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
      <div>
        <span class="text-xs font-mono uppercase tracking-widest text-cyan-400">{t.stackTag}</span>
        <h2 class="text-2xl font-bold text-white tracking-tight mt-0.5">{t.stackTitle}</h2>
        <p class="text-xs text-slate-400 mt-1">{t.stackSub}</p>
      </div>
      <a
        href={lang === 'cs' ? '/cs/cloud-tech/' : '/cloud-tech/'}
        class="inline-flex items-center gap-1.5 text-xs font-mono font-semibold text-cyan-400 hover:text-cyan-300"
      >
        <span>{lang === 'cs' ? 'Kompletní Cloud & Tech Matrix →' : 'Explore Full Tech Radar & Matrix →'}</span>
      </a>
    </div>

    <!-- Core Technologies Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 mb-6">
      {topTechSlice.map((tech) => (
        <a
          href={`${lang === 'cs' ? '/cs/technologies' : '/technologies'}/${tech.skill_id.replace(/_/g, '-')}/`}
          class="p-4 rounded-xl panel-surface border border-slate-800 hover:border-cyan-500/40 transition-colors block text-left"
        >
          <div class="text-xs font-mono text-cyan-400 truncate">{tech.category}</div>
          <div class="text-sm font-bold text-white mt-1 truncate">{tech.skill_name}</div>
          <div class="text-xs font-mono text-slate-400 mt-2">
            <span class="font-bold text-slate-200">{tech.penetration_pct}%</span> {lang === 'cs' ? 'inzerátů' : 'share'}
          </div>
          <div class="w-full h-1 bg-slate-900 rounded-full mt-1.5 overflow-hidden border border-slate-800">
            <div class="h-full bg-cyan-400 rounded-full" style={`width: ${tech.penetration_pct}%`}></div>
          </div>
        </a>
      ))}
    </div>

    <!-- Fast Moving Trends Tag Cloud -->
    <div class="p-4 rounded-xl bg-slate-900/50 border border-slate-800 flex flex-wrap items-center gap-2">
      <span class="text-xs font-mono uppercase text-slate-400 font-bold mr-2">
        {lang === 'cs' ? 'Rychle rostoucí signály:' : 'Fast-Moving Signals:'}
      </span>
      {radarKeywords.map((kw) => {
        const catItem = TECHNOLOGIES_CATALOG.find(
          (t) =>
            t.id === kw.skill_id.replace(/_/g, '-') ||
            (t.aliases && (t.aliases.includes(kw.skill_id) || t.aliases.includes(kw.skill_id.replace(/_/g, '-'))))
        );
        const targetUrl = catItem
          ? `${lang === 'cs' ? '/cs/technologies' : '/technologies'}/${catItem.id}/`
          : `${lang === 'cs' ? '/cs/cloud-tech/' : '/cloud-tech/'}`;

        return (
          <a
            href={targetUrl}
            class="px-2.5 py-1 rounded-md bg-slate-800/80 hover:bg-slate-700 text-slate-300 hover:text-white border border-slate-700/60 transition-colors text-xs font-mono inline-flex items-center gap-1.5"
          >
            <span>{kw.label}</span>
            <span class="px-1.5 py-0.2 rounded bg-cyan-950 text-cyan-300 border border-cyan-800/60 text-[10px] font-bold">
              {kw.penetration_pct}%
            </span>
          </a>
        );
      })}
    </div>
  </section>

  <!-- 06: MACHINE-READABLE BRIEF & METHODOLOGY PERIMETER -->
  <section class="mb-14 pt-8 border-t border-slate-800/80">
    <div class="p-6 rounded-2xl bg-slate-900/40 border border-slate-800 space-y-4">
      <div class="flex items-center justify-between text-xs font-mono">
        <span class="text-slate-400 uppercase tracking-wider font-semibold">
          {lang === 'cs' ? 'Otevřená metodika a strojová data pro AI' : 'Methodology & Machine-Readable Data for AI'}
        </span>
        <span class="px-2 py-0.5 rounded bg-slate-800 text-cyan-300 border border-slate-700 text-[10px]">
          LLM-READY
        </span>
      </div>

      <p class="text-xs text-slate-300 leading-relaxed font-light">
        {lang === 'cs'
          ? 'Vector87 sleduje výhradně kariérní portály TOP 100 enterprise zaměstnavatelů v každé z 25 evropských zemí, lídrů amerického indexu S&P 500 a Big Tech. Žádný agregovaný šum z tuzemských inzertních desek, žádné duplicity. Data jsou aktualizována denně a dostupná ve strukturované podobě pro LLM agenty i analytiky.'
          : 'Vector87 tracks career portals of TOP 100 enterprise employers per country across 25 European nations, S&P 500 market leaders, and Big Tech. Zero cross-country sampling bias, no unvetted job boards. Updated daily and formatted for AI agents and market researchers.'}
      </p>

      <div class="pt-2 flex flex-wrap items-center gap-4 text-xs font-mono">
        <a href="/llms.txt" class="text-cyan-400 hover:underline">/llms.txt (Endpoint Reference)</a>
        <span class="text-slate-600">•</span>
        <a href="/llms-full.txt" class="text-cyan-400 hover:underline">/llms-full.txt (Full Knowledge Base)</a>
        <span class="text-slate-600">•</span>
        <a href="https://github.com/antoninkucera/vector87" class="text-slate-400 hover:text-white" target="_blank" rel="noopener noreferrer">GitHub Repo ↗</a>
      </div>
    </div>
  </section>

  <!-- Share & Newsletter CTA -->
  <section class="mb-14">
    <ShareBar
      lang={lang}
      title={t.pageTitle}
      subtitle={t.pageDescription}
      sourceUrl={`https://vector87.com${lang === 'en' ? '' : '/cs'}/`}
    />
  </section>
  <NewsletterCta lang={lang} />
</Layout>
