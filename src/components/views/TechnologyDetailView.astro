---
import Layout from '../../layouts/Layout.astro';
import { getTechnology, type TechnologyResolved } from '../../data/technologies';
import { COMPARISONS_CATALOG } from '../../data/comparisons';
import { ui, getLocalePath, type Locale } from '../../i18n/ui';
import ShareBar from '../ShareBar.astro';
import NewsletterCta from '../NewsletterCta.astro';

interface Props {
  lang: Locale;
  techId: string;
}

const { lang, techId } = Astro.props;
const tech = getTechnology(techId);

if (!tech) {
  throw new Error(`Technology '${techId}' not found in technologies catalog.`);
}

const t = ui[lang].technologyDetail;
const homeHref = getLocalePath(lang, 'dashboard');
const techListHref = lang === 'en' ? '/technologies' : '/cs/technologies';

const authorNotes = tech.authorNotes ? tech.authorNotes[lang] : undefined;
const descriptions = tech.description[lang];

// Category Badge Color
const categoryColorMap: Record<string, { bg: string; text: string; border: string }> = {
  cloud: { bg: 'bg-sky-500/10', text: 'text-sky-400', border: 'border-sky-500/30' },
  'data-platform': { bg: 'bg-emerald-500/10', text: 'text-emerald-400', border: 'border-emerald-500/30' },
  programming: { bg: 'bg-amber-500/10', text: 'text-amber-400', border: 'border-amber-500/30' },
  'ai-ml': { bg: 'bg-purple-500/10', text: 'text-purple-400', border: 'border-purple-500/30' },
  'bi-analytics': { bg: 'bg-cyan-500/10', text: 'text-cyan-400', border: 'border-cyan-500/30' },
  framework: { bg: 'bg-indigo-500/10', text: 'text-indigo-400', border: 'border-indigo-500/30' },
  mlops: { bg: 'bg-teal-500/10', text: 'text-teal-400', border: 'border-teal-500/30' },
};

const catStyle = categoryColorMap[tech.category] || categoryColorMap['cloud'];

const pageTitle = lang === 'en' 
  ? `${tech.name} Market Demand & Skills | Vector87` 
  : `${tech.name}: Poptávka na trhu práce a dovednosti | Vector87`;

const pageDescription = lang === 'en'
  ? `Live enterprise hiring demand for ${tech.name}: ${tech.jobCount.toLocaleString()} active jobs (${tech.penetrationPct}% penetration), required roles, paired skills, and top hiring companies.`
  : `Aktuální data z trhu práce pro ${tech.name}: ${tech.jobCount.toLocaleString()} aktivních pozic (${tech.penetrationPct} % trhu), nejčastější role, párované technologie a najímající firmy.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: pageTitle,
  description: pageDescription,
  about: {
    '@type': 'ComputerLanguage',
    name: tech.name,
  },
  author: {
    '@type': 'Person',
    name: 'Antonín Kučera',
    url: 'https://akucera.eu',
  },
};
---

<Layout
  lang={lang}
  activeNav="technologies"
  title={pageTitle}
  description={pageDescription}
  jsonLd={jsonLd}
>
  <main class="min-h-screen bg-[#04070e] pb-24">
    <!-- Breadcrumb -->
    <div class="border-b border-slate-800/80 bg-[#060911]/60 backdrop-blur-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
        <nav class="flex items-center gap-2 text-xs font-mono text-slate-400" aria-label="Breadcrumb">
          <a href={homeHref} class="hover:text-cyan-300 transition-colors">{t.breadcrumbHome}</a>
          <span class="text-slate-600">/</span>
          <a href={techListHref} class="hover:text-cyan-300 transition-colors">{t.breadcrumbTech}</a>
          <span class="text-slate-600">/</span>
          <span class="text-slate-200 font-semibold">{tech.name}</span>
        </nav>
      </div>
    </div>

    <!-- Hero Header -->
    <section class="relative pt-12 pb-16 border-b border-slate-800/80 overflow-hidden bg-gradient-to-b from-slate-900/40 via-transparent to-transparent">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(14,165,233,0.15),rgba(255,255,255,0))] pointer-events-none"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="flex flex-wrap items-center gap-3 mb-4">
          <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-mono font-medium border ${catStyle.bg} ${catStyle.text} ${catStyle.border}`}>
            {tech.category.toUpperCase()}
          </span>
          {tech.tags.map((tag) => (
            <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-mono text-slate-400 bg-slate-800/60 border border-slate-700/60">
              #{tag}
            </span>
          ))}
        </div>

        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-8 mb-10">
          <div>
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
              {tech.name}
            </h1>
            <p class="text-base sm:text-lg text-slate-300 max-w-3xl mt-3 leading-relaxed">
              {descriptions[0]}
            </p>
          </div>

          <!-- Quick Comparisons Shortcuts -->
          {tech.comparisons && tech.comparisons.length > 0 && (
            <div class="flex flex-col sm:flex-row lg:flex-col gap-2 shrink-0">
              <span class="text-xs font-mono text-slate-400">{t.compareWithLabel || (lang === 'en' ? 'Head-to-Head:' : 'Přímé srovnání:')}</span>
              <div class="flex flex-wrap gap-2">
                {tech.comparisons.map((comp) => {
                  const comparisonMatch = COMPARISONS_CATALOG.find(
                    (c) =>
                      c.type === 'technology' &&
                      ((c.entityAId === tech.id && c.entityBId === comp.targetSlug) ||
                        (c.entityBId === tech.id && c.entityAId === comp.targetSlug))
                  );
                  const href = comparisonMatch
                    ? `${lang === 'en' ? '/compare' : '/cs/compare'}/${comparisonMatch.slug}`
                    : `${lang === 'en' ? '/technologies' : '/cs/technologies'}/${comp.targetSlug}`;

                  return (
                    <a
                      href={href}
                      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-mono font-medium bg-slate-800/80 hover:bg-slate-700/80 text-cyan-300 border border-slate-700/80 hover:border-cyan-500/50 transition-all shadow-sm"
                    >
                      <span>vs {comp.targetName}</span>
                      <span class="text-slate-500">→</span>
                    </a>
                  );
                })}
              </div>
            </div>
          )}
        </div>

        <!-- 3 Core Market KPI Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6">
          <div class="p-5 rounded-xl bg-slate-900/60 border border-slate-800/90 backdrop-blur-sm">
            <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">{t.kpiJobs}</div>
            <div class="text-3xl sm:text-4xl font-extrabold font-mono text-white mt-1">
              {tech.jobCount.toLocaleString()}
            </div>
            <div class="text-xs text-slate-400 mt-1">{t.kpiJobsSub}</div>
          </div>

          <div class="p-5 rounded-xl bg-slate-900/60 border border-slate-800/90 backdrop-blur-sm">
            <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">{t.kpiPenetration}</div>
            <div class="text-3xl sm:text-4xl font-extrabold font-mono text-cyan-400 mt-1">
              {tech.penetrationPct}%
            </div>
            <div class="text-xs text-slate-400 mt-1">{t.kpiPenetrationSub}</div>
          </div>

          <div class="p-5 rounded-xl bg-slate-900/60 border border-slate-800/90 backdrop-blur-sm">
            <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">{t.kpiRank}</div>
            <div class="text-3xl sm:text-4xl font-extrabold font-mono text-emerald-400 mt-1">
              #{tech.rank}
            </div>
            <div class="text-xs text-slate-400 mt-1">{t.kpiRankSub(tech.totalCatalogued)}</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Content Grid -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 space-y-16">
      
      <!-- Architectural Narrative / Executive Synthesis -->
      <section class="bg-slate-900/40 border border-slate-800/80 rounded-2xl p-6 sm:p-8">
        <div class="flex items-center gap-2 mb-4">
          <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
          <h2 class="text-xs font-mono uppercase tracking-widest text-slate-400">
            {lang === 'en' ? '01 // ARCHITECTURAL CONTEXT & ROLE IN STACK' : '01 // ARCHITEKTONICKÝ KONTEXT & VÝZNAM VE STACKU'}
          </h2>
        </div>
        <div class="space-y-4 text-slate-200 text-sm sm:text-base leading-relaxed">
          {descriptions.map((p) => (
            <p>{p}</p>
          ))}
        </div>
      </section>

      <!-- Author Deep-Dive Spotlight (Antonín Kučera / akucera.eu / Substack) -->
      {authorNotes && (
        <section class="relative overflow-hidden rounded-2xl border border-cyan-500/30 bg-gradient-to-br from-cyan-950/20 via-slate-900/80 to-slate-950 p-6 sm:p-8 shadow-xl shadow-cyan-950/10">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-cyan-500/20 mb-6">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-xl bg-cyan-500/20 border border-cyan-400/40 flex items-center justify-center text-cyan-300 font-mono font-bold text-lg">
                AK
              </div>
              <div>
                <span class="text-xs font-mono text-cyan-400 uppercase tracking-widest block font-semibold">
                  {lang === 'en' ? 'PRACTICAL FIELD NOTES // AUTHOR PERSPECTIVE' : 'POZNÁMKY Z ARCHITEKTURY // POHLED AUTORA'}
                </span>
                <h3 class="text-xl sm:text-2xl font-bold text-white mt-0.5">
                  {authorNotes.title}
                </h3>
              </div>
            </div>
            <a
              href={lang === 'en' ? '/about' : '/cs/about'}
              class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono text-slate-300 bg-slate-800/80 hover:bg-slate-700 border border-slate-700 hover:border-cyan-500/40 transition-colors"
            >
              <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
              <span>Antonín Kučera (akucera.eu) ↗</span>
            </a>
          </div>

          <div class="space-y-4 text-slate-300 text-sm sm:text-base leading-relaxed">
            <p class="font-medium text-slate-100">{authorNotes.lead}</p>
            {authorNotes.paragraphs.map((p) => (
              <p>{p}</p>
            ))}
          </div>

          {authorNotes.links && authorNotes.links.length > 0 && (
            <div class="mt-6 pt-6 border-t border-cyan-500/20">
              <div class="text-xs font-mono text-slate-400 mb-3">
                {lang === 'en' ? 'Read in-depth technical analysis on Substack:' : 'Číst detailní technický rozbor na autorově Substacku:'}
              </div>
              <div class="flex flex-wrap gap-3">
                {authorNotes.links.map((link) => (
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-xs font-mono font-semibold bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 hover:border-cyan-400 transition-all shadow-sm"
                  >
                    <span>{link.label}</span>
                  </a>
                ))}
              </div>
            </div>
          )}
        </section>
      )}

      <!-- Agent Frameworks Radar (Specialized Section for AI Agents) -->
      {tech.agentFrameworks && tech.agentFrameworks.length > 0 && (
        <section class="p-6 sm:p-8 rounded-2xl bg-gradient-to-br from-slate-900/90 via-[#060b18] to-slate-900 border border-cyan-500/30 shadow-2xl space-y-8">
          <div>
            <div class="flex items-center gap-2 mb-2">
              <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-pulse"></span>
              <h2 class="text-xs font-mono uppercase tracking-widest text-cyan-300 font-bold">
                {lang === 'en' ? '02 // AUTONOMOUS AI AGENT FRAMEWORK RADAR' : '02 // RADAR ADOPCE AGENTNÍCH FRAMEWORKŮ'}
              </h2>
            </div>
            <p class="text-sm text-slate-300 max-w-3xl leading-relaxed">
              {lang === 'en'
                ? 'Empirical breakdown across 1,612 enterprise job postings mentioning Agentic AI. Direct market demand comparing state machines (LangGraph), multi-agent crews (CrewAI), conversational solvers (AutoGen), and enterprise SDKs (Semantic Kernel).'
                : 'Empirický rozbor napříč 1 612 inzeráty poptávajícími autonomní agenty. Přímá poptávka firem porovnávající stavové automaty (LangGraph), víceagentní týmy (CrewAI), konverzační agenty (AutoGen) a podnikové SDK (Semantic Kernel).'}
            </p>
          </div>

          <!-- Framework Comparison Cards Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            {tech.agentFrameworks.map((fw) => (
              <div class="p-5 rounded-xl bg-slate-900/70 border border-slate-800 hover:border-cyan-500/40 transition-all flex flex-col justify-between space-y-4">
                <div>
                  <div class="flex items-start justify-between gap-3">
                    <div>
                      <h3 class="text-lg font-bold text-white tracking-tight flex items-center gap-2">
                        <span>{fw.name}</span>
                      </h3>
                      <span class="inline-block mt-1 px-2 py-0.5 rounded text-[10px] font-mono text-cyan-300 bg-cyan-950/70 border border-cyan-800/60 font-semibold">
                        {fw.paradigm}
                      </span>
                    </div>

                    <div class="text-right shrink-0">
                      <div class="text-xl font-bold font-mono text-cyan-300">
                        {fw.jobCount}
                      </div>
                      <div class="text-[10px] font-mono text-slate-500 uppercase">
                        {lang === 'en' ? 'active jobs' : 'pozic'}
                      </div>
                    </div>
                  </div>

                  <!-- Share of Agent Jobs Bar -->
                  <div class="mt-4 space-y-1.5">
                    <div class="flex justify-between text-xs font-mono text-slate-400">
                      <span>{lang === 'en' ? 'Share of Agent Jobs:' : 'Podíl v agentních inzerátech:'}</span>
                      <span class="text-cyan-400 font-bold">{fw.shareOfAgentJobsPct}%</span>
                    </div>
                    <div class="w-full h-1.5 bg-slate-800 rounded-full overflow-hidden">
                      <div
                        class="h-full bg-gradient-to-r from-cyan-500 to-indigo-500 rounded-full"
                        style={`width: ${Math.min(100, fw.shareOfAgentJobsPct * 3.5)}%`}
                      ></div>
                    </div>
                  </div>

                  <p class="text-xs text-slate-300 mt-3 leading-relaxed">
                    {fw.summary}
                  </p>
                </div>

                <div class="pt-3 border-t border-slate-800/80 space-y-3">
                  <!-- Top Companies Hiring -->
                  <div>
                    <span class="text-[11px] font-mono text-slate-400 uppercase tracking-wider block mb-1.5">
                      {lang === 'en' ? 'Top Hiring Employers:' : 'Najímající zaměstnavatelé:'}
                    </span>
                    <div class="flex flex-wrap gap-1.5">
                      {fw.topCompanies.slice(0, 4).map((c) => (
                        <span class="px-2 py-0.5 rounded bg-slate-800/90 text-[11px] font-mono text-slate-300 border border-slate-700/60">
                          {c.companyName} <span class="text-cyan-400 font-bold">({c.jobCount})</span>
                        </span>
                      ))}
                    </div>
                  </div>

                  <!-- Sample Postings -->
                  {fw.samplePostings && fw.samplePostings.length > 0 && (
                    <div>
                      <span class="text-[11px] font-mono text-slate-400 uppercase tracking-wider block mb-1.5">
                        {lang === 'en' ? 'Live In-Market Postings:' : 'Ukázkové aktivní pozice:'}
                      </span>
                      <div class="space-y-1">
                        {fw.samplePostings.slice(0, 2).map((p) => (
                          <a
                            href={p.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="block p-2 rounded bg-slate-950/60 hover:bg-slate-800/80 border border-slate-800/80 hover:border-cyan-500/40 text-[11px] text-slate-300 hover:text-cyan-200 transition-colors truncate"
                          >
                            <span class="text-cyan-400 font-semibold">{p.companyName}:</span> {p.title} ↗
                          </a>
                        ))}
                      </div>
                    </div>
                  )}
                </div>
              </div>
            ))}
          </div>

          <!-- Architectural Decision Matrix -->
          <div class="mt-8 pt-6 border-t border-slate-800/80">
            <h4 class="text-xs font-mono uppercase tracking-widest text-slate-400 mb-4 font-semibold">
              {lang === 'en' ? 'ARCHITECTURAL FRAMEWORK SELECTION MATRIX' : 'ROZHODOVACÍ MATICE PRO VOLBU FRAMEWORKU'}
            </h4>
            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs font-mono border-collapse">
                <thead>
                  <tr class="border-b border-slate-800 text-slate-400">
                    <th class="py-2.5 px-3">{lang === 'en' ? 'Framework' : 'Framework'}</th>
                    <th class="py-2.5 px-3">{lang === 'en' ? 'Core Execution Model' : 'Běhový model'}</th>
                    <th class="py-2.5 px-3">{lang === 'en' ? 'State & Persistence' : 'Správa stavu'}</th>
                    <th class="py-2.5 px-3">{lang === 'en' ? 'Enterprise Fit' : 'Primární uplatnění v praxi'}</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-800/50 text-slate-300">
                  <tr class="hover:bg-slate-800/30">
                    <td class="py-2.5 px-3 font-bold text-cyan-300">LangGraph</td>
                    <td class="py-2.5 px-3">{lang === 'en' ? 'Cyclic State Graphs & Subgraphs' : 'Cyklické stavové grafy & podgrafy'}</td>
                    <td class="py-2.5 px-3 text-emerald-400">{lang === 'en' ? 'First-class Checkpointing & Time-travel' : 'Plný checkpointing & time-travel'}</td>
                    <td class="py-2.5 px-3">{lang === 'en' ? 'Complex deterministic agent workflows & human-in-the-loop' : 'Deterministické procesy s lidským schvalováním'}</td>
                  </tr>
                  <tr class="hover:bg-slate-800/30">
                    <td class="py-2.5 px-3 font-bold text-cyan-300">CrewAI</td>
                    <td class="py-2.5 px-3">{lang === 'en' ? 'Role-playing Task Teams (Crews)' : 'Týmy se specializovanými rolemi (Crews)'}</td>
                    <td class="py-2.5 px-3">{lang === 'en' ? 'Short & long-term shared memory' : 'Sdílená krátkodobá i dlouhodobá paměť'}</td>
                    <td class="py-2.5 px-3">{lang === 'en' ? 'Autonomous business task delegation (Researcher + Coder + Writer)' : 'Autonomní delegování úloh (analytik, programátor, auditor)'}</td>
                  </tr>
                  <tr class="hover:bg-slate-800/30">
                    <td class="py-2.5 px-3 font-bold text-cyan-300">AutoGen</td>
                    <td class="py-2.5 px-3">{lang === 'en' ? 'Multi-Agent Conversational Chat' : 'Víceagentní konverzační dialog'}</td>
                    <td class="py-2.5 px-3">{lang === 'en' ? 'Chat context & Code execution environment' : 'Kontext chatu & sandbox pro spouštění kódu'}</td>
                    <td class="py-2.5 px-3">{lang === 'en' ? 'Collaborative problem solving & automated code execution' : 'Výzkumné úlohy a automatické ladění programového kódu'}</td>
                  </tr>
                  <tr class="hover:bg-slate-800/30">
                    <td class="py-2.5 px-3 font-bold text-cyan-300">Semantic Kernel</td>
                    <td class="py-2.5 px-3">{lang === 'en' ? 'Enterprise Native SDK (C#, Python, TS)' : 'Nativní enterprise SDK (C#, Python, TS)'}</td>
                    <td class="py-2.5 px-3">{lang === 'en' ? 'Native connectors & enterprise vector memory' : 'Nativní konektory & Azure AI paměť'}</td>
                    <td class="py-2.5 px-3">{lang === 'en' ? 'Enterprises committed to Microsoft, Azure & .NET backends' : 'Podnikové systémy postavené na Microsoft & Azure stacku'}</td>
                  </tr>
                  <tr class="hover:bg-slate-800/30">
                    <td class="py-2.5 px-3 font-bold text-cyan-300">LlamaIndex</td>
                    <td class="py-2.5 px-3">{lang === 'en' ? 'Data Agents & Query Routing' : 'Datoví agenti & směrování dotazů'}</td>
                    <td class="py-2.5 px-3">{lang === 'en' ? 'Knowledge graph & Vector indices' : 'Znalostní grafy & vektorové indexy'}</td>
                    <td class="py-2.5 px-3">{lang === 'en' ? 'Agentic RAG over complex multimodal enterprise documentation' : 'Agentní RAG nad složitou podnikovou dokumentací'}</td>
                  </tr>
                  <tr class="hover:bg-slate-800/30">
                    <td class="py-2.5 px-3 font-bold text-cyan-300">LangChain</td>
                    <td class="py-2.5 px-3">{lang === 'en' ? 'Sequential Chains & Tool Binding' : 'Lineární řetězce & binding nástrojů'}</td>
                    <td class="py-2.5 px-3">{lang === 'en' ? 'Stateless or simple memory buffers' : 'Bezstavové či jednoduché buffery'}</td>
                    <td class="py-2.5 px-3">{lang === 'en' ? 'Foundational scaffolding & rapid prototype orchestration' : 'Základní propojování modelů a rychlé prototypování'}</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </section>
      )}

      <!-- Section: Roles Demanding This Technology -->
      <section>
        <div class="flex items-center gap-2 mb-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <h2 class="text-xs font-mono uppercase tracking-widest text-slate-400">
            {t.sectionRoles}
          </h2>
        </div>
        <p class="text-sm text-slate-400 mb-6">{t.sectionRolesSub}</p>

        {tech.topRoles.length === 0 ? (
          <div class="p-6 rounded-xl bg-slate-900/40 border border-slate-800/80 text-sm text-slate-400 font-mono">
            {lang === 'en' ? 'Cross-cutting technology required across multiple engineering profiles.' : 'Průřezová technologie vyžadovaná napříč více inženýrskými profily.'}
          </div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {tech.topRoles.map((r) => (
              <a
                href={`${lang === 'en' ? '/roles' : '/cs/roles'}/${r.kebabSlug}`}
                class="group p-5 rounded-xl bg-slate-900/50 hover:bg-slate-800/60 border border-slate-800/80 hover:border-slate-700 transition-all flex items-center justify-between gap-4"
              >
                <div>
                  <h3 class="text-base font-bold text-white group-hover:text-cyan-300 transition-colors">
                    {r.roleName}
                  </h3>
                  <div class="flex items-center gap-3 mt-1.5 text-xs font-mono text-slate-400">
                    <span>{r.jobCount.toLocaleString()} {lang === 'en' ? 'postings' : 'pozic'}</span>
                  </div>
                </div>

                <div class="text-right shrink-0">
                  <div class="text-xl font-bold font-mono text-cyan-400">
                    {r.penetrationPct}%
                  </div>
                  <div class="text-[10px] font-mono text-slate-500 uppercase">
                    {lang === 'en' ? 'of role postings' : 'inzerátů role'}
                  </div>
                </div>
              </a>
            ))}
          </div>
        )}
      </section>

      <!-- Section: Paired Skills & Hiring Companies (Two Columns) -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        
        <!-- Paired Technologies -->
        <section class="p-6 rounded-xl bg-slate-900/40 border border-slate-800/80">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
            <h2 class="text-xs font-mono uppercase tracking-widest text-slate-400">
              {t.sectionPaired}
            </h2>
          </div>
          <p class="text-xs text-slate-400 mb-6">{t.sectionPairedSub}</p>

          <div class="flex flex-wrap gap-2.5">
            {tech.pairedSkills.map((sk) => (
              <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-mono bg-slate-800/70 border border-slate-700/80 text-slate-200">
                <span class="text-cyan-400 font-bold">+</span>
                <span>{sk.skillName}</span>
                {sk.penetrationPct && (
                  <span class="text-slate-500 text-[10px]">({sk.penetrationPct}%)</span>
                )}
              </span>
            ))}
          </div>
        </section>

        <!-- Hiring Companies -->
        <section class="p-6 rounded-xl bg-slate-900/40 border border-slate-800/80">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2 h-2 rounded-full bg-purple-400"></span>
            <h2 class="text-xs font-mono uppercase tracking-widest text-slate-400">
              {t.sectionCompanies}
            </h2>
          </div>
          <p class="text-xs text-slate-400 mb-6">{t.sectionCompaniesSub}</p>

          {tech.topCompanies.length === 0 ? (
            <div class="text-xs text-slate-500 font-mono">
              {lang === 'en' ? 'Demanded across all major S&P 500 enterprises.' : 'Vyžadováno napříč všemi velkými S&P 500 podniky.'}
            </div>
          ) : (
            <div class="space-y-3">
              {tech.topCompanies.map((c) => (
                <div class="flex items-center justify-between gap-4 text-xs font-mono">
                  <div class="text-slate-200 font-medium truncate">{c.companyName}</div>
                  <div class="flex items-center gap-3 shrink-0">
                    {c.sector && <span class="text-slate-500 text-[11px] hidden sm:inline">{c.sector}</span>}
                    <span class="px-2 py-0.5 rounded bg-slate-800 text-cyan-300 font-bold">
                      {c.jobCount} {lang === 'en' ? 'jobs' : 'pozic'}
                    </span>
                  </div>
                </div>
              ))}
            </div>
          )}
        </section>
      </div>

      <!-- Section: Recommended Learning & Certifications -->
      {(tech.recommendedCourses.length > 0 || tech.recommendedCerts.length > 0) && (
        <section class="p-6 sm:p-8 rounded-2xl bg-slate-900/40 border border-slate-800/80">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2 h-2 rounded-full bg-amber-400"></span>
            <h2 class="text-xs font-mono uppercase tracking-widest text-slate-400">
              {t.sectionAcademy}
            </h2>
          </div>
          <p class="text-sm text-slate-400 mb-6">{t.sectionAcademySub}</p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {tech.recommendedCerts.map((cert) => (
              <a
                href={cert.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group p-5 rounded-xl bg-slate-800/40 hover:bg-slate-800/70 border border-slate-700/60 hover:border-amber-500/40 transition-all flex flex-col justify-between"
              >
                <div>
                  <div class="flex items-center justify-between gap-2 mb-2">
                    <span class="text-[11px] font-mono text-amber-400 font-semibold uppercase tracking-wider">
                      {cert.code} · {cert.issuer}
                    </span>
                    <span class="text-xs font-mono text-slate-400">↗</span>
                  </div>
                  <h3 class="text-base font-bold text-white group-hover:text-amber-300 transition-colors">
                    {cert.title}
                  </h3>
                  <p class="text-xs text-slate-300 mt-2 leading-relaxed">
                    {cert.summary[lang]}
                  </p>
                </div>
                <div class="mt-4 pt-3 border-t border-slate-700/60 text-[11px] font-mono text-slate-400">
                  {cert.level[lang]}
                </div>
              </a>
            ))}

            {tech.recommendedCourses.map((course) => (
              <a
                href={course.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group p-5 rounded-xl bg-slate-800/40 hover:bg-slate-800/70 border border-slate-700/60 hover:border-cyan-500/40 transition-all flex flex-col justify-between"
              >
                <div>
                  <div class="flex items-center justify-between gap-2 mb-2">
                    <span class="text-[11px] font-mono text-cyan-400 font-semibold uppercase tracking-wider">
                      {course.platform}
                    </span>
                    <span class="text-xs font-mono text-slate-400">↗</span>
                  </div>
                  <h3 class="text-base font-bold text-white group-hover:text-cyan-300 transition-colors">
                    {course.title[lang]}
                  </h3>
                  <p class="text-xs text-slate-300 mt-2 leading-relaxed">
                    {course.description[lang]}
                  </p>
                </div>
                <div class="mt-4 pt-3 border-t border-slate-700/60 flex items-center justify-between text-[11px] font-mono text-slate-400">
                  <span>{course.duration[lang]}</span>
                  <span class="text-emerald-400">{course.marketSignal[lang]}</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Social Sharing & Link Bar -->
      <ShareBar
        lang={lang}
        title={`${tech.name} Market Demand & Hiring Trends`}
        subtitle={tech.description[lang]?.[0]}
        sourceUrl={`https://vector87.com${lang === 'en' ? '' : '/cs'}/technologies/${tech.id}`}
        className="mb-12"
      />

      <!-- Substack / Newsletter CTA -->
      <NewsletterCta lang={lang} />
    </div>
  </main>
</Layout>
