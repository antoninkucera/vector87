---
import Layout from '../../layouts/Layout.astro';
import { getAllComparisons, type ComparisonResolved } from '../../data/comparisons';
import { ui, getLocalePath, type Locale } from '../../i18n/ui';
import NewsletterCta from '../NewsletterCta.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const homeHref = getLocalePath(lang, 'dashboard');
const allComparisons = getAllComparisons();

const pageTitle = lang === 'en'
  ? 'Head-to-Head Comparisons & Venn Diagrams | Vector87 Telemetry'
  : 'Srovnání rolí a technologií & Vennovy diagramy | Vector87';

const pageDescription = lang === 'en'
  ? 'Empirical head-to-head comparisons of AI and data roles and technology stacks: Data Analyst vs Data Scientist, Data Engineer vs Data Analyst, Databricks vs Snowflake.'
  : 'Empirická srovnání datových a AI rolí a technologií: Data Analyst vs Data Scientist, Data Engineer vs Data Analyst, Databricks vs Snowflake na základě inzerátů firem.';
---

<Layout
  lang={lang}
  activeNav="compare"
  title={pageTitle}
  description={pageDescription}
>
  <main class="min-h-screen bg-[#04070e] pb-24">
    <!-- Breadcrumb -->
    <div class="border-b border-slate-800/80 bg-[#060911]/60 backdrop-blur-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
        <nav class="flex items-center gap-2 text-xs font-mono text-slate-400" aria-label="Breadcrumb">
          <a href={homeHref} class="hover:text-cyan-300 transition-colors">{lang === 'en' ? 'Home' : 'Domů'}</a>
          <span class="text-slate-600">/</span>
          <span class="text-slate-200 font-semibold">{lang === 'en' ? 'Comparisons' : 'Srovnání'}</span>
        </nav>
      </div>
    </div>

    <!-- Hero Header -->
    <section class="relative pt-12 pb-14 border-b border-slate-800/80 overflow-hidden bg-gradient-to-b from-slate-900/40 via-transparent to-transparent">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(99,102,241,0.12),rgba(255,255,255,0))] pointer-events-none"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full text-xs font-mono font-medium border border-indigo-500/30 bg-indigo-500/10 text-indigo-300 mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-indigo-400 animate-pulse"></span>
          <span>04 // HEAD-TO-HEAD BATTLES & OVERLAPS</span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
          {lang === 'en' ? 'Role & Technology Comparisons' : 'Srovnání rolí, technologií a stacků'}
        </h1>
        <p class="text-base sm:text-lg text-slate-300 max-w-3xl mt-3 leading-relaxed">
          {lang === 'en'
            ? 'Empirical head-to-head comparisons backed by enterprise telemetry: Venn diagrams illustrating shared analytical foundations vs. distinct technical specializations.'
            : 'Empirická srovnání rolí a technologií podložená reálnými daty z tisíců inzerátů: interaktivní Vennovy diagramy znázorňující společný základ i specifické odlišnosti.'}
        </p>
      </div>
    </section>

    <!-- Comparisons Grid -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {allComparisons.map((comp) => {
          const detailHref = `${lang === 'en' ? '/compare' : '/cs/compare'}/${comp.slug}`;

          return (
            <a
              href={detailHref}
              class="group block p-6 rounded-2xl bg-slate-900/40 hover:bg-slate-900/80 border border-slate-800/80 hover:border-cyan-500/50 hover:shadow-xl hover:shadow-cyan-950/20 transition-all duration-200 flex flex-col justify-between"
            >
              <div>
                <div class="flex items-center justify-between gap-2 mb-3">
                  <span class="px-2 py-0.5 rounded text-[11px] font-mono font-bold bg-indigo-500/10 text-indigo-300 border border-indigo-500/20">
                    {comp.type === 'role' ? (lang === 'en' ? 'ROLE COMPARISON' : 'SROVNÁNÍ ROLÍ') : (lang === 'en' ? 'TECH BATTLE' : 'SROVNÁNÍ TECHNOLOGIÍ')}
                  </span>
                  <span class="inline-flex items-center gap-1 text-[11px] font-mono text-cyan-400">
                    <span>Venn Diagram</span>
                    <span>✓</span>
                  </span>
                </div>

                <h2 class="text-2xl font-bold text-white mb-2 group-hover:text-cyan-300 transition-colors">
                  {comp.entityA.name} <span class="text-slate-500 font-normal">vs.</span> {comp.entityB.name}
                </h2>

                <p class="text-xs text-slate-300 line-clamp-2 leading-relaxed mb-6">
                  {comp.subtitle[lang]}
                </p>

                <!-- Side-by-side Mini KPI Preview -->
                <div class="grid grid-cols-2 gap-3 p-3.5 rounded-xl bg-slate-800/50 border border-slate-700/60 text-xs font-mono mb-6">
                  <div>
                    <div class="text-sky-400 font-bold truncate">{comp.entityA.name}</div>
                    <div class="text-base font-bold text-white mt-1">
                      {comp.entityA.jobCount.toLocaleString()} <span class="text-[10px] text-slate-400 font-normal">{lang === 'en' ? 'jobs' : 'inzerátů'}</span>
                    </div>
                    <div class="text-[11px] text-slate-400">{comp.entityA.marketSharePct}% {lang === 'en' ? 'market share' : 'trhu'}</div>
                  </div>

                  <div class="border-l border-slate-700/60 pl-3">
                    <div class="text-emerald-400 font-bold truncate">{comp.entityB.name}</div>
                    <div class="text-base font-bold text-white mt-1">
                      {comp.entityB.jobCount.toLocaleString()} <span class="text-[10px] text-slate-400 font-normal">{lang === 'en' ? 'jobs' : 'inzerátů'}</span>
                    </div>
                    <div class="text-[11px] text-slate-400">{comp.entityB.marketSharePct}% {lang === 'en' ? 'market share' : 'trhu'}</div>
                  </div>
                </div>

                <!-- Overlap Preview Tags -->
                <div class="space-y-1.5 text-xs font-mono">
                  <div class="text-slate-500 text-[10px] uppercase">
                    {lang === 'en' ? 'Shared Foundation:' : 'Společný průnik dovedností:'}
                  </div>
                  <div class="flex flex-wrap gap-1.5">
                    {comp.shared.slice(0, 4).map((item) => (
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] bg-slate-800 text-indigo-200 border border-indigo-500/20">
                        {item.name}
                      </span>
                    ))}
                  </div>
                </div>
              </div>

              <!-- Footer CTA Indicator -->
              <div class="mt-8 pt-4 border-t border-slate-800/80 flex items-center justify-between text-xs font-mono text-cyan-400 font-semibold">
                <span class="group-hover:text-cyan-300 transition-colors">
                  {lang === 'en' ? 'View Full Comparison & Venn Diagram' : 'Zobrazit srovnání & Vennův diagram'}
                </span>
                <span class="text-slate-600 group-hover:text-cyan-400 group-hover:translate-x-1 transition-all">→</span>
              </div>
            </a>
          );
        })}
      </div>
    </div>

    <!-- Newsletter CTA -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-16">
      <NewsletterCta lang={lang} />
    </div>
  </main>
</Layout>
