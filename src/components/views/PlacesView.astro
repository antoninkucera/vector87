---
import Layout from '../../layouts/Layout.astro';
import placesData from '../../data/places-data.json';
import mapPaths from '../../data/world-map-paths.json';
import { ui, type Locale } from '../../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang].places;

const { meta, pillars, countries } = placesData;

// Seřazení všech 217 zemí podle výchozího kompozitního skóre (nekompletní data N/A na konec)
const allCountries = [...countries];
allCountries.sort((a, b) => {
  const scoreA = a.pillar_scores.composite_score;
  const scoreB = b.pillar_scores.composite_score;
  if (scoreA === null || scoreA === undefined) return 1;
  if (scoreB === null || scoreB === undefined) return -1;
  return scoreB - scoreA;
});
const allCountriesMap = Object.fromEntries(countries.map((c) => [c.country_code_alpha3, c]));

// Pomocná funkce pro určení barvy podle skóre
function getScoreColor(score: number | null | undefined): string {
  if (score === null || score === undefined) return '#1e293b';
  if (score >= 80) return '#10b981'; // emerald
  if (score >= 70) return '#06b6d4'; // cyan
  if (score >= 60) return '#3b82f6'; // blue
  if (score >= 50) return '#6366f1'; // indigo
  return '#475569'; // slate
}

const placesJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: t.pageTitle,
  description: t.pageDescription,
  itemListElement: allCountries.slice(0, 30).map((c, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: c.country_name,
    description: `Composite Score: ${c.pillar_scores.composite_score ?? 'N/A'} (Safety: ${c.pillar_scores.safety ?? 'N/A'}, Housing: ${c.pillar_scores.housing ?? 'N/A'}, Economy: ${c.pillar_scores.economy ?? 'N/A'}, Governance: ${c.pillar_scores.governance ?? 'N/A'})`,
  })),
};
---

<Layout title={t.pageTitle} description={t.pageDescription} activeNav="places" lang={lang} jsonLd={placesJsonLd}>
  <!-- 1. Hero Header -->
  <section class="mb-10 pb-8 border-b border-slate-800/80">
    <div class="max-w-3xl space-y-3">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-mono font-medium tracking-wide bg-cyan-950/80 border border-cyan-500/30 text-cyan-400">
          {t.heroBadge}
        </span>
        <span class="text-xs font-mono text-slate-400">
          • {meta.total_countries} COUNTRIES • {meta.focus_countries_count} FOCUS DESTINATIONS
        </span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold text-white tracking-tight leading-tight">
        {t.heroTitlePrefix}
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-teal-300 to-indigo-400">
          {t.heroTitleHighlight}
        </span>
      </h1>
      <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
        {t.heroDescription}
      </p>
    </div>
  </section>

  <!-- 2. Interactive Map Section -->
  <section class="mb-12">
    <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-4 sm:p-6 shadow-2xl backdrop-blur-sm relative overflow-hidden">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4 pb-4 border-b border-slate-800/60">
        <div>
          <span class="text-xs font-mono uppercase tracking-widest text-cyan-400">GLOBAL CHOROPLETH TELEMETRY</span>
          <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">{t.mapTitle}</h2>
          <p class="text-xs sm:text-sm text-slate-400">{t.mapSubtitle}</p>
        </div>
        <!-- Map Legend -->
        <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-slate-400 bg-slate-950/80 px-3 py-2 rounded-lg border border-slate-800">
          <span>SCORE:</span>
          <div class="flex items-center gap-1">
            <span class="w-3 h-3 rounded bg-emerald-500/80 inline-block"></span>
            <span>80+</span>
          </div>
          <div class="flex items-center gap-1">
            <span class="w-3 h-3 rounded bg-cyan-500/80 inline-block"></span>
            <span>70-79</span>
          </div>
          <div class="flex items-center gap-1">
            <span class="w-3 h-3 rounded bg-blue-500/80 inline-block"></span>
            <span>60-69</span>
          </div>
          <div class="flex items-center gap-1">
            <span class="w-3 h-3 rounded bg-indigo-500/80 inline-block"></span>
            <span>50-59</span>
          </div>
          <div class="flex items-center gap-1">
            <span class="w-3 h-3 rounded bg-slate-600 inline-block"></span>
            <span>&lt;50</span>
          </div>
        </div>
      </div>

      <!-- SVG Map Canvas -->
      <div class="relative w-full overflow-hidden rounded-lg bg-[#070b14] border border-slate-800/80 aspect-[960/500]">
        <svg
          id="world-map-svg"
          viewBox="0 0 960 500"
          class="w-full h-full select-none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <rect width="960" height="500" fill="#070b14" />
          <g id="map-countries-group">
            {Object.entries(mapPaths).map(([iso3, pathD]) => {
              const country = allCountriesMap[iso3];
              const isFocus = country?.is_focus_country;
              const score = country?.pillar_scores?.composite_score;
              const fillColor = getScoreColor(score);

              return (
                <path
                  d={pathD}
                  id={`map-${iso3}`}
                  data-iso3={iso3}
                  class={`country-path transition-all duration-150 cursor-pointer stroke-[#070b14] stroke-[0.5] ${
                    isFocus
                      ? 'opacity-95 hover:opacity-100 hover:stroke-cyan-300 hover:stroke-[1.5]'
                      : 'opacity-70 hover:opacity-100 hover:stroke-slate-400 hover:stroke-[1.2]'
                  }`}
                  fill={fillColor}
                />
              );
            })}
          </g>
        </svg>

        <!-- Hover Tooltip -->
        <div
          id="map-tooltip"
          class="pointer-events-none absolute hidden z-30 w-72 p-3 bg-slate-950/95 border border-cyan-500/40 rounded-lg shadow-2xl text-xs backdrop-blur-md transition-opacity duration-75"
        >
          <div class="flex items-center justify-between pb-2 mb-2 border-b border-slate-800">
            <div>
              <span id="tooltip-country-name" class="font-bold text-sm text-white block"></span>
              <span id="tooltip-country-region" class="font-mono text-slate-400 text-[10px]"></span>
            </div>
            <span id="tooltip-score-badge" class="px-2 py-0.5 rounded font-mono font-bold text-xs"></span>
          </div>
          <div class="space-y-1.5 font-mono text-[11px]">
            <div class="flex justify-between text-slate-300">
              <span class="text-slate-400">GDP PPP (pc):</span>
              <span id="tooltip-gdp" class="text-white font-medium"></span>
            </div>
            <div class="flex justify-between text-slate-300">
              <span class="text-slate-400">Peace Index:</span>
              <span id="tooltip-peace" class="text-white font-medium"></span>
            </div>
            <div class="flex justify-between text-slate-300">
              <span class="text-slate-400">{lang === 'cs' ? 'Právní stát (WGI):' : 'Rule of Law:'}</span>
              <span id="tooltip-rol" class="text-white font-medium"></span>
            </div>
            <div class="flex justify-between text-slate-300">
              <span class="text-slate-400">{lang === 'cs' ? 'Dostupnost přesunu:' : 'Relocation Ease:'}</span>
              <span id="tooltip-reloc" class="text-emerald-400 font-semibold"></span>
            </div>
            <div class="flex justify-between text-slate-300">
              <span class="text-slate-400">{lang === 'cs' ? 'Populace:' : 'Population:'}</span>
              <span id="tooltip-pop" class="text-white font-medium"></span>
            </div>
            <div id="tooltip-tech-row" class="flex justify-between text-slate-300 pt-1.5 border-t border-slate-800/80 hidden">
              <span class="text-slate-400">{lang === 'cs' ? 'AI & Data trh:' : 'AI & Data Jobs:'}</span>
              <span id="tooltip-jobs" class="text-cyan-300 font-semibold"></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Dynamic Weight Customizer (Always Sums to 100%) -->
  <section class="mb-10">
    <div class="bg-slate-900/40 border border-slate-800 rounded-xl p-5 sm:p-6 backdrop-blur-sm">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div>
          <span class="text-xs font-mono uppercase tracking-widest text-cyan-400">BALANCED METHODOLOGY (SUM = 100%)</span>
          <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">{t.rankingTitle}</h2>
          <p class="text-xs sm:text-sm text-slate-400">{t.rankingSubtitle}</p>
        </div>
        <div class="flex items-center gap-3">
          <div class="text-xs font-mono text-slate-400 bg-slate-950 px-2.5 py-1 rounded border border-slate-800">
            TOTAL: <span id="val-weight-total" class="font-bold text-cyan-400">100%</span>
          </div>
          <button
            id="btn-reset-weights"
            type="button"
            class="px-3 py-1.5 rounded-lg border border-slate-700 hover:border-cyan-500/50 bg-slate-800/60 hover:bg-slate-800 text-xs font-mono text-slate-300 hover:text-cyan-400 transition-colors cursor-pointer"
          >
            ↺ {t.metrics.resetWeights}
          </button>
        </div>
      </div>

      <!-- Sliders Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <!-- Safety Slider -->
        <div class="bg-slate-950/60 p-4 rounded-lg border border-slate-800/80">
          <div class="flex justify-between items-center mb-2">
            <span class="text-xs font-mono font-semibold text-emerald-400 uppercase tracking-wide">
              {t.pillars.safety}
            </span>
            <span id="val-weight-safety" class="text-xs font-mono font-bold text-white bg-slate-800 px-2 py-0.5 rounded">25%</span>
          </div>
          <input
            type="range"
            id="slider-safety"
            aria-label={t.pillars.safety}
            min="0"
            max="100"
            value="25"
            step="1"
            class="w-full h-1.5 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-emerald-400"
          />
          <p class="text-[11px] text-slate-400 mt-2 line-clamp-2">
            {lang === 'cs' ? pillars[0].description_cs : pillars[0].description}
          </p>
        </div>

        <!-- Housing Slider -->
        <div class="bg-slate-950/60 p-4 rounded-lg border border-slate-800/80">
          <div class="flex justify-between items-center mb-2">
            <span class="text-xs font-mono font-semibold text-amber-400 uppercase tracking-wide">
              {t.pillars.housing}
            </span>
            <span id="val-weight-housing" class="text-xs font-mono font-bold text-white bg-slate-800 px-2 py-0.5 rounded">25%</span>
          </div>
          <input
            type="range"
            id="slider-housing"
            aria-label={t.pillars.housing}
            min="0"
            max="100"
            value="25"
            step="1"
            class="w-full h-1.5 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-amber-400"
          />
          <p class="text-[11px] text-slate-400 mt-2 line-clamp-2">
            {lang === 'cs' ? pillars[1].description_cs : pillars[1].description}
          </p>
        </div>

        <!-- Economy Slider -->
        <div class="bg-slate-950/60 p-4 rounded-lg border border-slate-800/80">
          <div class="flex justify-between items-center mb-2">
            <span class="text-xs font-mono font-semibold text-cyan-400 uppercase tracking-wide">
              {t.pillars.economy}
            </span>
            <span id="val-weight-economy" class="text-xs font-mono font-bold text-white bg-slate-800 px-2 py-0.5 rounded">25%</span>
          </div>
          <input
            type="range"
            id="slider-economy"
            aria-label={t.pillars.economy}
            min="0"
            max="100"
            value="25"
            step="1"
            class="w-full h-1.5 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-cyan-400"
          />
          <p class="text-[11px] text-slate-400 mt-2 line-clamp-2">
            {lang === 'cs' ? pillars[2].description_cs : pillars[2].description}
          </p>
        </div>

        <!-- Governance Slider -->
        <div class="bg-slate-950/60 p-4 rounded-lg border border-slate-800/80">
          <div class="flex justify-between items-center mb-2">
            <span class="text-xs font-mono font-semibold text-indigo-400 uppercase tracking-wide">
              {t.pillars.governance}
            </span>
            <span id="val-weight-governance" class="text-xs font-mono font-bold text-white bg-slate-800 px-2 py-0.5 rounded">25%</span>
          </div>
          <input
            type="range"
            id="slider-governance"
            aria-label={t.pillars.governance}
            min="0"
            max="100"
            value="25"
            step="1"
            class="w-full h-1.5 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-indigo-400"
          />
          <p class="text-[11px] text-slate-400 mt-2 line-clamp-2">
            {lang === 'cs' ? pillars[3].description_cs : pillars[3].description}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Methodology Explainer: Decoded Indices -->
  <section class="mb-10">
    <div class="p-5 rounded-xl bg-slate-900/60 border border-slate-800">
      <div class="flex items-center gap-2 mb-1.5">
        <span class="text-xs font-mono uppercase tracking-widest text-emerald-400">
          {t.indicesExplainerTag}
        </span>
      </div>
      <h3 class="text-sm font-semibold text-white mb-1">
        {t.indicesExplainerTitle}
      </h3>
      <p class="text-xs text-slate-400 mb-4 leading-relaxed max-w-3xl">
        {t.indicesExplainerSub}
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- 1. AI Thriving Index -->
        <div class="p-3.5 rounded-lg bg-slate-950/70 border border-slate-800/90 space-y-1.5 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-1">
              <span class="text-xs font-mono font-bold text-emerald-300">
                🌟 {t.indexThrivingName}
              </span>
              <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 font-bold">
                0–100
              </span>
            </div>
            <p class="text-xs text-slate-300 leading-relaxed">
              {t.indexThrivingDef}
            </p>
          </div>
          <div class="pt-2 border-t border-slate-800/80 text-[11px] font-mono text-slate-400 space-y-0.5">
            <div>• <strong class="text-cyan-300 font-semibold">35 %</strong> {t.indexThrivingPartMarket}</div>
            <div>• <strong class="text-emerald-300 font-semibold">40 %</strong> {t.indexThrivingPartLife}</div>
            <div>• <strong class="text-indigo-300 font-semibold">25 %</strong> {t.indexThrivingPartReloc}</div>
          </div>
        </div>

        <!-- 2. Livability & Stability -->
        <div class="p-3.5 rounded-lg bg-slate-950/70 border border-slate-800/90 space-y-1.5 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-1">
              <span class="text-xs font-mono font-bold text-white">
                🏡 {t.indexLivabilityName}
              </span>
              <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-slate-800 text-slate-300 border border-slate-700 font-bold">
                0–100
              </span>
            </div>
            <p class="text-xs text-slate-300 leading-relaxed">
              {t.indexLivabilityDef}
            </p>
          </div>
          <div class="pt-2 border-t border-slate-800/80 text-[11px] font-mono text-slate-400 space-y-0.5">
            <div>• <strong>25 %</strong> {t.indexLifeSafe}</div>
            <div>• <strong>25 %</strong> {t.indexLifeHouse}</div>
            <div>• <strong>25 %</strong> {t.indexLifeEcon}</div>
            <div>• <strong>25 %</strong> {t.indexLifeGov}</div>
          </div>
        </div>

        <!-- 3. Ease of Relocation -->
        <div class="p-3.5 rounded-lg bg-slate-950/70 border border-slate-800/90 space-y-1.5 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-1">
              <span class="text-xs font-mono font-bold text-cyan-300">
                🛂 {t.indexRelocationName}
              </span>
              <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 font-bold">
                0–100
              </span>
            </div>
            <p class="text-xs text-slate-300 leading-relaxed">
              {t.indexRelocationDef}
            </p>
          </div>
          <div class="pt-2 border-t border-slate-800/80 text-[11px] font-mono text-slate-400 space-y-0.5">
            <div>• <strong class="text-emerald-400 font-semibold">90–98:</strong> {t.indexRelocTierEu}</div>
            <div>• <strong class="text-cyan-400 font-semibold">75–85:</strong> {t.indexRelocTierPoints}</div>
            <div>• <strong class="text-amber-400 font-semibold">30–40:</strong> {t.indexRelocTierLottery}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Ranking Table of All Countries -->
  <section class="mb-16">
    <div class="bg-slate-900/60 border border-slate-800 rounded-xl overflow-hidden shadow-xl">
      <!-- Search & Filters -->
      <div class="p-4 bg-slate-950/80 border-b border-slate-800 flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="relative w-full md:w-80">
          <input
            type="text"
            id="input-country-search"
            placeholder={lang === 'cs' ? 'Hledat zemi nebo kód...' : 'Search country or code...'}
            class="w-full px-3 py-1.5 pl-8 bg-slate-900 border border-slate-700/80 rounded-lg text-xs font-mono text-white placeholder-slate-500 focus:outline-none focus:border-cyan-400"
          />
          <span class="absolute left-2.5 top-2 text-slate-500 text-xs">🔍</span>
        </div>

        <div class="flex items-center gap-1.5 text-xs font-mono overflow-x-auto w-full md:w-auto pb-1 md:pb-0">
          <button data-filter="all" class="filter-btn px-3 py-1 rounded-md bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 whitespace-nowrap">
            {t.filterAll} ({meta.total_countries})
          </button>
          <button data-filter="focus" class="filter-btn px-3 py-1 rounded-md bg-slate-800/80 text-slate-400 hover:text-white border border-slate-700/60 whitespace-nowrap">
            {t.filterFocus} ({meta.focus_countries_count})
          </button>
          <button data-filter="tech" class="filter-btn px-3 py-1 rounded-md bg-slate-800/80 text-slate-400 hover:text-white border border-slate-700/60 whitespace-nowrap">
            🔥 {t.techJobsFilterLabel}
          </button>
          <button data-filter="eu" class="filter-btn px-3 py-1 rounded-md bg-slate-800/80 text-slate-400 hover:text-white border border-slate-700/60 whitespace-nowrap">
            {t.filterEu}
          </button>
          <button data-filter="europe" class="filter-btn px-3 py-1 rounded-md bg-slate-800/80 text-slate-400 hover:text-white border border-slate-700/60 whitespace-nowrap">
            {t.filterEurope}
          </button>
          <button data-filter="americas" class="filter-btn px-3 py-1 rounded-md bg-slate-800/80 text-slate-400 hover:text-white border border-slate-700/60 whitespace-nowrap">
            {t.filterAmericas}
          </button>
          <button data-filter="asia" class="filter-btn px-3 py-1 rounded-md bg-slate-800/80 text-slate-400 hover:text-white border border-slate-700/60 whitespace-nowrap">
            {t.filterAsia}
          </button>
        </div>
      </div>

      <!-- Table Header & Body -->
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs">
          <thead>
            <tr class="bg-slate-950/90 border-b border-slate-800 font-mono text-slate-400 uppercase tracking-wider text-[11px]">
              <th scope="col" class="py-3 px-4 w-12 text-center" title="Rank">{t.thRank}</th>
              <th scope="col" class="py-3 px-4">{t.thCountry}</th>
              <th scope="col" class="py-3 px-4 text-center">{t.thScore}</th>
              <th scope="col" class="py-3 px-4 text-right">{t.colTechJobs}</th>
              <th scope="col" class="py-3 px-4 text-right">{t.colRelocation}</th>
              <th scope="col" class="py-3 px-4 text-right">{t.thSafety}</th>
              <th scope="col" class="py-3 px-4 text-right">{t.thHousing}</th>
              <th scope="col" class="py-3 px-4 text-right">{t.thEconomy}</th>
              <th scope="col" class="py-3 px-4 text-right">{t.thGovernance}</th>
              <th scope="col" class="py-3 px-4 text-center w-10" title={t.thDetails}><span class="sr-only">{t.thDetails}</span></th>
            </tr>
          </thead>
          <tbody id="ranking-tbody" class="divide-y divide-slate-800/60 font-mono">
            {allCountries.map((country, idx) => {
              const scores = country.pillar_scores;
              const hasScore = scores.composite_score !== null && scores.composite_score !== undefined;
              const comp = hasScore ? scores.composite_score! : null;
              let badgeColor = 'bg-slate-900 text-slate-500 border-slate-800';
              if (comp !== null) {
                if (comp >= 80) badgeColor = 'bg-emerald-950 text-emerald-300 border-emerald-700/50';
                else if (comp >= 70) badgeColor = 'bg-cyan-950 text-cyan-300 border-cyan-700/50';
                else if (comp >= 60) badgeColor = 'bg-blue-950 text-blue-300 border-blue-700/50';
                else if (comp >= 50) badgeColor = 'bg-indigo-950 text-indigo-300 border-indigo-700/50';
                else badgeColor = 'bg-slate-800/80 text-slate-300 border-slate-700/50';
              }

              return (
                <tr
                  class="country-row hover:bg-slate-800/40 transition-colors cursor-pointer group"
                  data-iso3={country.country_code_alpha3}
                  data-focus={country.is_focus_country ? 'true' : 'false'}
                  data-eu={country.is_eu ? 'true' : 'false'}
                  data-tech={country.tech_market?.active_jobs ? 'true' : 'false'}
                  data-continent={country.continent}
                  data-current-score={comp !== null ? comp : -1}
                >
                  <td class="py-3.5 px-4 text-center font-bold text-slate-500 rank-cell group-hover:text-cyan-400">
                    {hasScore ? idx + 1 : '—'}
                  </td>
                  <td class="py-3.5 px-4 font-sans font-medium text-white flex items-center gap-2">
                    <span class="font-mono text-xs text-slate-400">{country.country_code_alpha2}</span>
                    <span>{country.country_name}</span>
                    {country.is_focus_country && (
                      <span class="text-[9px] font-mono px-1.5 py-0.2 rounded bg-cyan-950/80 border border-cyan-600/40 text-cyan-300">
                        FOCUS
                      </span>
                    )}
                    {country.is_eu && (
                      <span class="text-[9px] font-mono px-1.5 py-0.2 rounded bg-blue-950/70 border border-blue-700/40 text-blue-300">
                        EU
                      </span>
                    )}
                  </td>
                  <td class="py-3.5 px-4 text-center">
                    <span class={`inline-block px-2.5 py-0.5 rounded font-bold border score-cell ${badgeColor}`}>
                      {comp !== null ? comp.toFixed(1) : 'N/A'}
                    </span>
                  </td>
                  <td class="py-3.5 px-4 text-right font-mono">
                    {country.tech_market?.active_jobs ? (
                      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-semibold bg-cyan-950/80 border border-cyan-600/40 text-cyan-300">
                        🔥 {country.tech_market.active_jobs.toLocaleString('en-US')}
                      </span>
                    ) : (
                      <span class="text-slate-600 text-xs">—</span>
                    )}
                  </td>
                  <td class="py-3.5 px-4 text-right font-mono">
                    {scores.ease_of_relocation !== null ? (
                      <span class="text-emerald-400 font-semibold">{scores.ease_of_relocation}</span>
                    ) : (
                      <span class="text-slate-600 text-xs">—</span>
                    )}
                  </td>
                  <td class="py-3.5 px-4 text-right text-slate-300 score-safety">
                    {scores.safety !== null ? scores.safety.toFixed(1) : '—'}
                  </td>
                  <td class="py-3.5 px-4 text-right text-slate-300 score-housing">
                    {scores.housing !== null ? scores.housing.toFixed(1) : '—'}
                  </td>
                  <td class="py-3.5 px-4 text-right text-slate-300 score-economy">
                    {scores.economy !== null ? scores.economy.toFixed(1) : '—'}
                  </td>
                  <td class="py-3.5 px-4 text-right text-slate-300 score-gov">
                    {scores.governance !== null ? scores.governance.toFixed(1) : '—'}
                  </td>
                  <td class="py-3.5 px-4 text-center text-slate-500 group-hover:text-cyan-400 text-xs">
                    ▼
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 5. Methodology Footnote -->
  <footer class="pt-6 border-t border-slate-800 text-xs font-mono text-slate-500 space-y-2">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
      <div>
        <span>DATA SOURCES: World Bank Open Data (2024–2025) • Eurostat (2024) • IEP Global Peace Index (2024)</span>
      </div>
      <div>
        <span>PIPELINE: duckdb world.duckdb via world_stats repository</span>
      </div>
    </div>
    <p class="text-[11px] text-slate-600 leading-relaxed">
      Normalization: Min-Max scaled to [0, 100] with 1st/99th percentile winsorization. Composite scores are dynamically computed client-side with user-defined weights (always strictly summing to 100%).
    </p>
  </footer>
</Layout>

<!-- Client Script: Interactive Map & Live Linked 100% Sliders -->
<script is:inline define:vars={{ countriesData: countries, pageLang: lang }}>
  const countries = countriesData;
  const countriesMap = new Map(countries.map(c => [c.country_code_alpha3, c]));

  // 1. Tooltip logic
  const tooltip = document.getElementById('map-tooltip');
  const ttName = document.getElementById('tooltip-country-name');
  const ttRegion = document.getElementById('tooltip-country-region');
  const ttScore = document.getElementById('tooltip-score-badge');
  const ttGdp = document.getElementById('tooltip-gdp');
  const ttPeace = document.getElementById('tooltip-peace');
  const ttRol = document.getElementById('tooltip-rol');
  const ttReloc = document.getElementById('tooltip-reloc');
  const ttPop = document.getElementById('tooltip-pop');
  const ttTechRow = document.getElementById('tooltip-tech-row');
  const ttJobs = document.getElementById('tooltip-jobs');

  const svg = document.getElementById('world-map-svg');

  document.querySelectorAll('.country-path').forEach(path => {
    path.addEventListener('mouseenter', () => {
      const iso3 = path.getAttribute('data-iso3');
      const c = countriesMap.get(iso3);
      if (!c) return;

      ttName.textContent = `${c.country_name} (${c.country_code_alpha2})`;
      ttRegion.textContent = `${c.continent} • ${c.subregion || ''}`;

      const score = c.pillar_scores.composite_score;
      if (score !== null && score !== undefined) {
        ttScore.textContent = `${score.toFixed(1)} / 100`;
        ttScore.className = `px-2 py-0.5 rounded font-mono font-bold text-xs ${
          score >= 80 ? 'bg-emerald-950 text-emerald-300 border border-emerald-700/50' :
          score >= 70 ? 'bg-cyan-950 text-cyan-300 border border-cyan-700/50' :
          score >= 60 ? 'bg-blue-950 text-blue-300 border border-blue-700/50' :
          score >= 50 ? 'bg-indigo-950 text-indigo-300 border border-indigo-700/50' :
          'bg-slate-800 text-slate-300 border border-slate-700'
        }`;
        ttScore.style.display = 'inline-block';
      } else {
        ttScore.style.display = 'none';
      }

      const ind = c.indicators || {};
      ttGdp.textContent = ind.gdp_pc_ppp?.raw_value ? `$${Math.round(ind.gdp_pc_ppp.raw_value).toLocaleString('en-US')}` : 'N/A';
      ttPeace.textContent = ind.peace_index?.raw_value ? ind.peace_index.raw_value.toFixed(2) : 'N/A';
      ttRol.textContent = ind.rule_of_law?.raw_value ? ind.rule_of_law.raw_value.toFixed(2) : 'N/A';
      ttReloc.textContent = c.pillar_scores?.ease_of_relocation !== null && c.pillar_scores?.ease_of_relocation !== undefined ? `${c.pillar_scores.ease_of_relocation} / 100` : 'N/A';
      ttPop.textContent = ind.population?.raw_value ? (ind.population.raw_value / 1e6).toFixed(1) + ' M' : 'N/A';

      const tm = c.tech_market;
      if (tm && tm.active_jobs) {
        const firmsWord = pageLang === 'cs' ? 'zaměstnavatelů' : 'employers';
        ttJobs.textContent = `${tm.active_jobs.toLocaleString('en-US')} (${tm.hiring_companies} ${firmsWord})`;
        ttTechRow?.classList.remove('hidden');
      } else {
        ttTechRow?.classList.add('hidden');
      }

      tooltip.classList.remove('hidden');
    });

    path.addEventListener('mousemove', (e) => {
      const rect = svg.getBoundingClientRect();
      const x = e.clientX - rect.left + 15;
      const y = e.clientY - rect.top + 15;
      tooltip.style.left = `${Math.min(x, rect.width - 290)}px`;
      tooltip.style.top = `${Math.min(y, rect.height - 150)}px`;
    });

    path.addEventListener('mouseleave', () => {
      tooltip.classList.add('hidden');
    });

    path.addEventListener('click', () => {
      const iso3 = path.getAttribute('data-iso3');
      const row = document.querySelector(`.country-row[data-iso3="${iso3}"]`);
      if (row) {
        row.scrollIntoView({ behavior: 'smooth', block: 'center' });
        row.classList.add('bg-cyan-950/60');
        setTimeout(() => row.classList.remove('bg-cyan-950/60'), 1800);
      }
    });
  });

  // 2. Linked Sliders Always Summing to 100%
  const sliders = {
    safety: document.getElementById('slider-safety'),
    housing: document.getElementById('slider-housing'),
    economy: document.getElementById('slider-economy'),
    governance: document.getElementById('slider-governance')
  };

  const valLabels = {
    safety: document.getElementById('val-weight-safety'),
    housing: document.getElementById('val-weight-housing'),
    economy: document.getElementById('val-weight-economy'),
    governance: document.getElementById('val-weight-governance')
  };

  const totalLabel = document.getElementById('val-weight-total');
  const btnReset = document.getElementById('btn-reset-weights');
  const tbody = document.getElementById('ranking-tbody');

  let currentWeights = { safety: 25, housing: 25, economy: 25, governance: 25 };

  function adjustWeights(changedKey, newVal) {
    newVal = Math.max(0, Math.min(100, Math.round(newVal)));
    const oldVal = currentWeights[changedKey];
    const delta = newVal - oldVal;
    if (delta === 0) return;

    const otherKeys = Object.keys(currentWeights).filter(k => k !== changedKey);
    const otherSum = otherKeys.reduce((acc, k) => acc + currentWeights[k], 0);

    if (otherSum === 0 && delta > 0) {
      sliders[changedKey].value = oldVal;
      return;
    }

    currentWeights[changedKey] = newVal;

    if (otherSum === 0) {
      const part = Math.abs(delta) / otherKeys.length;
      otherKeys.forEach(k => currentWeights[k] = Math.round(part));
    } else {
      let remainingToDistribute = -delta;
      otherKeys.forEach(k => {
        const share = currentWeights[k] / otherSum;
        const change = Math.round(remainingToDistribute * share);
        currentWeights[k] = Math.max(0, currentWeights[k] + change);
      });
    }

    // Korekce zaokrouhlení pro striktní součet 100
    let currentSum = Object.values(currentWeights).reduce((a, b) => a + b, 0);
    let diff = 100 - currentSum;
    if (diff !== 0) {
      const candidateKeys = otherKeys.filter(k => currentWeights[k] + diff >= 0);
      if (candidateKeys.length > 0) {
        candidateKeys.sort((a, b) => currentWeights[b] - currentWeights[a]);
        currentWeights[candidateKeys[0]] += diff;
      }
    }

    // Aktualizace UI posuvníků a popisek
    Object.keys(currentWeights).forEach(k => {
      sliders[k].value = currentWeights[k];
      valLabels[k].textContent = `${currentWeights[k]}%`;
    });
    totalLabel.textContent = `${Object.values(currentWeights).reduce((a, b) => a + b, 0)}%`;

    applyWeightsToData();
  }

  function applyWeightsToData() {
    const wSafe = currentWeights.safety;
    const wHouse = currentWeights.housing;
    const wEcon = currentWeights.economy;
    const wGov = currentWeights.governance;

    const rows = Array.from(document.querySelectorAll('.country-row'));

    rows.forEach(row => {
      const iso3 = row.getAttribute('data-iso3');
      const c = countriesMap.get(iso3);
      if (!c) return;

      const s = c.pillar_scores;
      let weightedSum = 0;
      let activeWeight = 0;
      let validPillarsCount = 0;

      if (s.safety !== null) {
        validPillarsCount++;
        if (wSafe > 0) {
          weightedSum += s.safety * wSafe;
          activeWeight += wSafe;
        }
      }
      if (s.housing !== null) {
        validPillarsCount++;
        if (wHouse > 0) {
          weightedSum += s.housing * wHouse;
          activeWeight += wHouse;
        }
      }
      if (s.economy !== null) {
        validPillarsCount++;
        if (wEcon > 0) {
          weightedSum += s.economy * wEcon;
          activeWeight += wEcon;
        }
      }
      if (s.governance !== null) {
        validPillarsCount++;
        if (wGov > 0) {
          weightedSum += s.governance * wGov;
          activeWeight += wGov;
        }
      }

      const hasValidScore = validPillarsCount >= 3 && activeWeight > 0;
      const score = hasValidScore ? (weightedSum / activeWeight) : null;
      row.dataset.currentScore = score !== null ? score : -1;

      const scoreCell = row.querySelector('.score-cell');

      if (score === null) {
        scoreCell.textContent = 'N/A';
        scoreCell.className = 'inline-block px-2.5 py-0.5 rounded font-bold border score-cell bg-slate-900 text-slate-500 border-slate-800';
      } else {
        scoreCell.textContent = score.toFixed(1);
        if (score >= 80) {
          scoreCell.className = 'inline-block px-2.5 py-0.5 rounded font-bold border score-cell bg-emerald-950 text-emerald-300 border-emerald-700/50';
        } else if (score >= 70) {
          scoreCell.className = 'inline-block px-2.5 py-0.5 rounded font-bold border score-cell bg-cyan-950 text-cyan-300 border-cyan-700/50';
        } else if (score >= 60) {
          scoreCell.className = 'inline-block px-2.5 py-0.5 rounded font-bold border score-cell bg-blue-950 text-blue-300 border-blue-700/50';
        } else if (score >= 50) {
          scoreCell.className = 'inline-block px-2.5 py-0.5 rounded font-bold border score-cell bg-indigo-950 text-indigo-300 border-indigo-700/50';
        } else {
          scoreCell.className = 'inline-block px-2.5 py-0.5 rounded font-bold border score-cell bg-slate-800 text-slate-300 border-slate-700';
        }
      }

      // Aktualizace barvy země na mapě
      const mapPath = document.getElementById(`map-${iso3}`);
      if (mapPath) {
        if (score === null) mapPath.setAttribute('fill', '#1e293b');
        else if (score >= 80) mapPath.setAttribute('fill', '#10b981');
        else if (score >= 70) mapPath.setAttribute('fill', '#06b6d4');
        else if (score >= 60) mapPath.setAttribute('fill', '#3b82f6');
        else if (score >= 50) mapPath.setAttribute('fill', '#6366f1');
        else mapPath.setAttribute('fill', '#475569');
      }
    });

    // Seřazení řádků podle nového skóre
    rows.sort((a, b) => parseFloat(b.dataset.currentScore) - parseFloat(a.dataset.currentScore));
    let visibleRank = 1;
    rows.forEach(r => {
      const isScored = parseFloat(r.dataset.currentScore) >= 0;
      r.querySelector('.rank-cell').textContent = isScored ? visibleRank++ : '—';
      tbody.appendChild(r);
    });
  }

  Object.keys(sliders).forEach(k => {
    sliders[k].addEventListener('input', (e) => {
      adjustWeights(k, parseFloat(e.target.value));
    });
  });

  btnReset.addEventListener('click', () => {
    currentWeights = { safety: 25, housing: 25, economy: 25, governance: 25 };
    Object.keys(currentWeights).forEach(k => {
      sliders[k].value = 25;
      valLabels[k].textContent = '25%';
    });
    totalLabel.textContent = '100%';
    applyWeightsToData();
  });

  // 3. Search & Filter Bar
  const searchInput = document.getElementById('input-country-search');
  const filterBtns = document.querySelectorAll('.filter-btn');
  let currentFilter = 'all';

  function filterTable() {
    const query = searchInput.value.toLowerCase().trim();
    let visibleIdx = 1;

    document.querySelectorAll('.country-row').forEach(row => {
      const iso3 = row.getAttribute('data-iso3').toLowerCase();
      const text = row.textContent.toLowerCase();
      const isFocus = row.getAttribute('data-focus') === 'true';
      const isEu = row.getAttribute('data-eu') === 'true';
      const isTech = row.getAttribute('data-tech') === 'true';
      const continent = row.getAttribute('data-continent');

      let matchesFilter = true;
      if (currentFilter === 'focus') matchesFilter = isFocus;
      else if (currentFilter === 'tech') matchesFilter = isTech;
      else if (currentFilter === 'eu') matchesFilter = isEu;
      else if (currentFilter === 'europe') matchesFilter = continent === 'Europe';
      else if (currentFilter === 'americas') matchesFilter = continent === 'Americas';
      else if (currentFilter === 'asia') matchesFilter = continent === 'Asia';

      const matchesQuery = !query || text.includes(query) || iso3.includes(query);
      const isVisible = matchesFilter && matchesQuery;
      row.style.display = isVisible ? '' : 'none';

      if (isVisible) {
        row.querySelector('.rank-cell').textContent = visibleIdx++;
      }
    });
  }

  searchInput.addEventListener('input', filterTable);

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => {
        b.className = 'filter-btn px-3 py-1 rounded-md bg-slate-800/80 text-slate-400 hover:text-white border border-slate-700/60 whitespace-nowrap';
      });
      btn.className = 'filter-btn px-3 py-1 rounded-md bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 whitespace-nowrap';
      currentFilter = btn.getAttribute('data-filter');
      filterTable();
    });
  });
</script>
