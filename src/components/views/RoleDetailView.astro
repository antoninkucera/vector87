  <script>
    function setupPostingsFilter() {
      const regionButtons = document.querySelectorAll<HTMLButtonElement>('.region-filter-btn');
      const countrySelect = document.getElementById('country-filter-select') as HTMLSelectElement | null;
      const cards = document.querySelectorAll<HTMLElement>('.posting-card');
      const counter = document.getElementById('visible-postings-count');
      const noResults = document.getElementById('postings-no-results');
      const resetBtn = document.getElementById('reset-postings-filter');
      const emptyResetBtn = document.getElementById('postings-empty-reset');
      const activeIndicator = document.getElementById('active-filter-indicator');

      if (!cards.length) return;

      let selectedRegion = 'ALL';
      let selectedCountry = 'ALL';

      function applyFilter() {
        let visible = 0;
        cards.forEach((card) => {
          const cardRegion = card.getAttribute('data-region') || '';
          const cardCountry = card.getAttribute('data-country') || '';

          const matchRegion = selectedRegion === 'ALL' || cardRegion === selectedRegion;
          const matchCountry = selectedCountry === 'ALL' || cardCountry === selectedCountry;

          if (matchRegion && matchCountry) {
            card.style.display = '';
            visible++;
          } else {
            card.style.display = 'none';
          }
        });

        if (counter) counter.textContent = String(visible);
        if (noResults) {
          if (visible === 0) noResults.classList.remove('hidden');
          else noResults.classList.add('hidden');
        }

        const isFiltered = selectedRegion !== 'ALL' || selectedCountry !== 'ALL';
        if (resetBtn) {
          if (isFiltered) resetBtn.classList.remove('hidden');
          else resetBtn.classList.add('hidden');
        }

        if (activeIndicator) {
          if (selectedCountry !== 'ALL') {
            const opt = countrySelect?.querySelector(`option[value="${selectedCountry}"]`);
            activeIndicator.textContent = `• ${opt ? opt.textContent?.trim() : selectedCountry}`;
          } else if (selectedRegion !== 'ALL') {
            const activeBtn = document.querySelector(`.region-filter-btn[data-region="${selectedRegion}"]`);
            const label = activeBtn ? activeBtn.textContent?.replace(/\s*\(\d+\)/, '').trim() : selectedRegion;
            activeIndicator.textContent = `• ${label}`;
          } else {
            activeIndicator.textContent = '';
          }
        }
      }

      function updateRegionButtons() {
        regionButtons.forEach((btn) => {
          const r = btn.getAttribute('data-region');
          if (r === selectedRegion) {
            btn.className =
              'region-filter-btn px-3 py-1.5 rounded-lg text-xs font-mono font-semibold transition-all border border-cyan-500/40 bg-cyan-500/20 text-cyan-300 shadow-sm cursor-pointer';
          } else {
            btn.className =
              'region-filter-btn px-3 py-1.5 rounded-lg text-xs font-mono font-semibold transition-all border border-slate-800 bg-slate-900/80 text-slate-400 hover:text-slate-200 hover:border-slate-700 cursor-pointer';
          }
        });
      }

      function resetAll() {
        selectedRegion = 'ALL';
        selectedCountry = 'ALL';
        if (countrySelect) countrySelect.value = 'ALL';
        updateRegionButtons();
        applyFilter();
      }

      regionButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const r = btn.getAttribute('data-region') || 'ALL';
          selectedRegion = r;
          if (selectedRegion !== 'ALL' && selectedCountry !== 'ALL' && countrySelect) {
            const opt = countrySelect.querySelector(`option[value="${selectedCountry}"]`) as HTMLOptionElement | null;
            if (opt && opt.getAttribute('data-region') && opt.getAttribute('data-region') !== selectedRegion) {
              selectedCountry = 'ALL';
              countrySelect.value = 'ALL';
            }
          }
          updateRegionButtons();
          applyFilter();
        });
      });

      countrySelect?.addEventListener('change', () => {
        selectedCountry = countrySelect.value;
        if (selectedCountry !== 'ALL') {
          const opt = countrySelect.querySelector(`option[value="${selectedCountry}"]`) as HTMLOptionElement | null;
          const reg = opt?.getAttribute('data-region');
          if (reg) {
            selectedRegion = reg;
            updateRegionButtons();
          }
        }
        applyFilter();
      });

      resetBtn?.addEventListener('click', resetAll);
      emptyResetBtn?.addEventListener('click', resetAll);
    }

    setupPostingsFilter();
    document.addEventListener('astro:page-load', setupPostingsFilter);
  </script>

