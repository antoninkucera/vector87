---
import Layout from '../../layouts/Layout.astro';
import marketData from '../../data/market-data.json';
import { ACADEMY_COURSES, CERTIFICATIONS_LIST } from '../../data/academy';
import { OPPORTUNITY_MATRIX_DATA } from '../../data/opportunity-matrix';
import { ui, getLocalePath, type Locale } from '../../i18n/ui';
import { getTechnology } from '../../data/technologies';
import { COMPARISONS_CATALOG } from '../../data/comparisons';
import ShareBar from '../ShareBar.astro';
import NewsletterCta from '../NewsletterCta.astro';

interface Props {
  lang: Locale;
  roleId: string;
}

const { lang, roleId } = Astro.props;
const t = ui[lang].roleDetail;
const rolesNav = ui[lang].roles;

const role = marketData.roles.find((r) => r.category_id === roleId);
if (!role) {
  throw new Error(`Role ${roleId} not found in marketData.roles`);
}
const roleKebabSlug = role.category_id.replace(/_/g, '-');

// Map technologies to cloud & tech stack sections for cross-linking
const cloudTechLinkMap: Record<string, string> = {
  AWS: '#hyperscalers',
  Azure: '#hyperscalers',
  GCP: '#gcp',
  'Google Cloud': '#gcp',
  BigQuery: '#gcp',
  Dataform: '#gcp',
  Looker: '#gcp',
  Dataflow: '#gcp',
  'Vertex AI': '#gcp',
  Databricks: '#lakehouse',
  Snowflake: '#lakehouse',
};

// Map domain to academy track
const domainTrackMap: Record<string, string> = {
  'AI/ML': 'applied-ai',
  'Data Engineering': 'data-engineering',
  'Analytics & DS': 'analytics',
  'Product': 'analytics',
  'Management': 'analytics',
  'Executive': 'analytics',
};
const targetTrackId = domainTrackMap[role.domain] || 'analytics';

// Skill names to match
const roleSkillNames = [
  ...role.top_skills.map((s) => s.skill_name.toLowerCase()),
  ...role.top_technologies.map((t) => t.skill_name.toLowerCase()),
];

// Match courses: by track or overlapping skills
const recommendedCourses = ACADEMY_COURSES.filter((course) => {
  if (course.trackId === targetTrackId) return true;
  return course.skills.some((sk) =>
    roleSkillNames.some((rsk) => rsk.includes(sk.toLowerCase()) || sk.toLowerCase().includes(rsk))
  );
}).slice(0, 3);

// Match certifications: by skills overlap or fallback
const recommendedCerts = CERTIFICATIONS_LIST.filter((cert) => {
  return cert.skills.some((sk) =>
    roleSkillNames.some((rsk) => rsk.includes(sk.toLowerCase()) || sk.toLowerCase().includes(rsk))
  );
}).slice(0, 2);

// If no certs matched specifically, pick top 2 relevant to track
const finalCerts = recommendedCerts.length > 0 ? recommendedCerts : CERTIFICATIONS_LIST.slice(0, 2);

// Related roles within same domain
const relatedRoles = marketData.roles
  .filter((r) => r.domain === role.domain && r.category_id !== role.category_id)
  .slice(0, 4);

// Head-to-Head Comparisons for this role
const roleComparisons = COMPARISONS_CATALOG.filter(
  (c) => c.type === 'role' && (c.entityAId === role.category_id || c.entityBId === role.category_id)
);

// Top geographic destinations for this role
const roleCountries = [
  OPPORTUNITY_MATRIX_DATA.find((c) => c.iso3 === 'CAN')!,
  OPPORTUNITY_MATRIX_DATA.find((c) => c.iso3 === 'CHE')!,
  OPPORTUNITY_MATRIX_DATA.find((c) => c.iso3 === 'CZE')!,
  OPPORTUNITY_MATRIX_DATA.find((c) => c.iso3 === 'USA')!,
].filter(Boolean);

const COUNTRY_NAME_CS_MAP: Record<string, string> = {
  AT: 'Rakousko',
  BE: 'Belgie',
  BG: 'Bulharsko',
  CA: 'Kanada',
  CH: 'Švýcarsko',
  CZ: 'Česká republika',
  DE: 'Německo',
  DK: 'Dánsko',
  ES: 'Španělsko',
  FI: 'Finsko',
  FR: 'Francie',
  GR: 'Řecko',
  HR: 'Chorvatsko',
  HU: 'Maďarsko',
  IE: 'Irsko',
  IT: 'Itálie',
  LT: 'Litva',
  LU: 'Lucembursko',
  NL: 'Nizozemsko',
  NO: 'Norsko',
  PL: 'Polsko',
  PT: 'Portugalsko',
  RO: 'Rumunsko',
  SE: 'Švédsko',
  SK: 'Slovensko',
  UK: 'Velká Británie',
  GB: 'Velká Británie',
  US: 'USA / Spojené státy',
};

function getCountryFlag(code?: string | null): string {
  if (!code || code.length !== 2) return '🌐';
  const c = code.toUpperCase();
  if (c === 'UK') return '🇬🇧';
  const offset = 127397;
  return String.fromCodePoint(c.charCodeAt(0) + offset, c.charCodeAt(1) + offset);
}

interface PostingCountryMeta {
  code: string;
  name: string;
  region: string;
  count: number;
}

const countryCountMap = new Map<string, PostingCountryMeta>();
const regionCountMap = new Map<string, number>();

for (const p of role.sample_postings || []) {
  if (p.region) {
    regionCountMap.set(p.region, (regionCountMap.get(p.region) || 0) + 1);
  }
  if (p.country_code) {
    const existing = countryCountMap.get(p.country_code);
    if (existing) {
      existing.count += 1;
    } else {
      countryCountMap.set(p.country_code, {
        code: p.country_code,
        name:
          lang === 'cs' && COUNTRY_NAME_CS_MAP[p.country_code]
            ? COUNTRY_NAME_CS_MAP[p.country_code]
            : p.country_name || p.country_code,
        region: p.region || 'Other',
        count: 1,
      });
    }
  }
}

const REGION_ORDER = ['EU', 'Americas', 'UK', 'Europe Non-EU', 'Other'];
const postingRegions = Array.from(regionCountMap.keys()).sort((a, b) => {
  const ia = REGION_ORDER.indexOf(a);
  const ib = REGION_ORDER.indexOf(b);
  return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib);
});

const postingCountries = Array.from(countryCountMap.values()).sort((a, b) => {
  if (lang === 'cs') {
    if (a.code === 'CZ') return -1;
    if (b.code === 'CZ') return 1;
  }
  return a.name.localeCompare(b.name, lang === 'cs' ? 'cs' : 'en');
});

const pageTitle =
  lang === 'cs'
    ? `${role.canonical_name}: Požadavky trhu, dovednosti & inzeráty | Vector87`
    : `${role.canonical_name}: Market Demand, Skills & Live Postings | Vector87`;

const topSkillsSummary = role.top_skills.slice(0, 3).map((s) => s.skill_name).join(', ');
const metaDescription =
  lang === 'cs'
    ? `${role.canonical_name}: Přehled klíčových dovedností (${topSkillsSummary}), reálné inzeráty firem a tržní požadavky na Vector87.`
    : `${role.canonical_name}: Essential skills (${topSkillsSummary}), hiring corporations, live job postings, and market profile on Vector87.`;

const roleDetailGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Occupation',
      name: role.canonical_name,
      occupationalCategory: role.domain,
      description: role.synthesized_description[lang]?.[0] || role.synthesized_description.en[0],
      skills: role.top_skills.map((s) => s.skill_name).join(', '),
      responsibilities: role.synthesized_description[lang]?.[1] || role.synthesized_description.en[1],
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': `https://vector87.com${lang === 'en' ? `/roles/${roleKebabSlug}` : `/cs/roles/${roleKebabSlug}`}`,
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: t.breadcrumbHome,
          item: `https://vector87.com${lang === 'en' ? '/' : '/cs/'}`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: t.breadcrumbRoles,
          item: `https://vector87.com${lang === 'en' ? '/roles' : '/cs/roles'}`,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: role.canonical_name,
          item: `https://vector87.com${lang === 'en' ? `/roles/${roleKebabSlug}` : `/cs/roles/${roleKebabSlug}`}`,
        },
      ],
    },
  ],
};
---

<Layout title={pageTitle} description={metaDescription} activeNav="roles" lang={lang} jsonLd={roleDetailGraph}>
  <!-- Breadcrumb Navigation -->
  <nav class="mb-6 flex items-center gap-2 text-xs font-mono text-slate-400" aria-label="Breadcrumb">
    <a href={lang === 'en' ? '/' : '/cs/'} class="hover:text-cyan-300 transition-colors">
      {t.breadcrumbHome}
    </a>
    <span class="text-slate-600">/</span>
    <a href={lang === 'en' ? '/roles' : '/cs/roles'} class="hover:text-cyan-300 transition-colors">
      {t.breadcrumbRoles}
    </a>
    <span class="text-slate-600">/</span>
    <span class="text-cyan-300 font-semibold">{role.canonical_name}</span>
  </nav>

  <!-- Hero Header -->
  <section class="mb-10 pb-8 border-b border-slate-800/80">
    <div class="space-y-4 max-w-4xl">
      <div class="flex flex-wrap items-center gap-2.5">
        <span class="px-2.5 py-1 rounded text-xs font-mono uppercase tracking-wider bg-cyan-500/10 text-cyan-300 border border-cyan-500/30">
          {t.tag}
        </span>
        <span class="px-2.5 py-1 rounded text-xs font-mono uppercase bg-slate-800 text-slate-300 border border-slate-700">
          {role.domain}
        </span>
        <span class="px-2.5 py-1 rounded text-xs font-mono uppercase bg-slate-900 text-slate-400 border border-slate-800">
          Track: {role.track}
        </span>
        {role.cz_job_count > 0 && (
          <span class="px-2.5 py-1 rounded text-xs font-mono bg-emerald-500/10 text-emerald-300 border border-emerald-500/30">
            CZ Sample: {role.cz_job_count} {t.positionsWord}
          </span>
        )}
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
        {role.canonical_name}
      </h1>

      <p class="text-base sm:text-lg text-slate-300 leading-relaxed font-light">
        {role.synthesized_description[lang][0]}
      </p>

      <!-- Quick Executive Answer / Search Intent Box -->
      <div class="p-4 rounded-xl bg-slate-900/70 border border-slate-800/90 text-xs text-slate-300 space-y-2">
        <div class="font-semibold text-white flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
          <span>
            {lang === 'cs'
              ? `Stručný přehled: Co obnáší ${role.canonical_name} a co firmy požadují?`
              : `Executive Summary: What does a ${role.canonical_name} do and what is required?`}
          </span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1 text-[11px] font-mono text-slate-400">
          <div>
            <span class="text-slate-500 uppercase block text-[10px]">{lang === 'cs' ? 'Klíčové dovednosti' : 'Top Skills'}:</span>
            <span class="text-cyan-300 font-medium">
              {role.top_skills.slice(0, 3).map((s) => s.skill_name).join(', ')}
            </span>
          </div>
          <div>
            <span class="text-slate-500 uppercase block text-[10px]">{lang === 'cs' ? 'Hlavní stack' : 'Tech Stack'}:</span>
            <span class="text-emerald-300 font-medium">
              {role.top_technologies.slice(0, 3).map((t) => t.skill_name).join(', ')}
            </span>
          </div>
          <div>
            <span class="text-slate-500 uppercase block text-[10px]">{lang === 'cs' ? 'Přední zaměstnavatelé' : 'Top Employers'}:</span>
            <span class="text-slate-200">
              {role.top_companies.slice(0, 3).map((c) => c.company_name).join(', ')}
            </span>
          </div>
        </div>
      </div>

      <!-- Quick Comparison Shortcuts (Venn Diagrams) -->
      {roleComparisons.length > 0 && (
        <div class="flex flex-wrap items-center gap-2 pt-2 text-xs font-mono">
          <span class="text-slate-400 font-semibold">{lang === 'cs' ? 'Přímá srovnání (Vennův diagram):' : 'Head-to-Head Comparisons:'}</span>
          {roleComparisons.map((c) => {
            const targetRoleId = c.entityAId === role.category_id ? c.entityBId : c.entityAId;
            const targetRole = marketData.roles.find((r) => r.category_id === targetRoleId);
            const targetName = targetRole ? targetRole.canonical_name : targetRoleId;
            return (
              <a
                href={`${lang === 'en' ? '/compare' : '/cs/compare'}/${c.slug}`}
                class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-indigo-500/10 hover:bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 hover:border-indigo-400 transition-colors shadow-sm"
              >
                <span>vs. {targetName}</span>
                <span class="text-slate-500">→</span>
              </a>
            );
          })}
        </div>
      )}
    </div>

    <!-- KPI Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 pt-8">
      <div class="p-4 rounded-xl panel-surface border border-slate-800">
        <div class="text-[10px] font-mono uppercase text-slate-400 tracking-wider mb-1">{t.kpiOpenJobs}</div>
        <div class="text-2xl font-bold font-mono text-cyan-300">{role.job_count.toLocaleString('en-US')}</div>
        <div class="text-[11px] text-slate-400 mt-0.5">
          {role.category_job_count && role.category_job_count > role.job_count ? (
            <span title={lang === 'cs' ? 'Celkem v kategorii včetně sekundárních shod v multilabelingu' : 'Total postings matching this role category including cross-discipline matches'}>
              {role.category_job_count.toLocaleString('en-US')} {lang === 'cs' ? 'v kategorii' : 'in category'}
            </span>
          ) : (
            t.kpiOpenJobsSub
          )}
        </div>
      </div>

      <div class="p-4 rounded-xl panel-surface border border-slate-800">
        <div class="text-[10px] font-mono uppercase text-slate-400 tracking-wider mb-1">{t.kpiSp500}</div>
        <div class="text-2xl font-bold font-mono text-white">
          {role.job_count > 0 ? Math.round((role.sp500_job_count / role.job_count) * 100) : 0}%
        </div>
        <div class="text-[11px] text-slate-400 mt-0.5">{role.sp500_job_count} S&P 500 {t.positionsWord}</div>
      </div>

      <div class="p-4 rounded-xl panel-surface border border-slate-800">
        <div class="text-[10px] font-mono uppercase text-slate-400 tracking-wider mb-1">{t.kpiSeniorPlus}</div>
        <div class="text-2xl font-bold font-mono text-amber-300">{role.senior_plus_pct}%</div>
        <div class="text-[11px] text-slate-400 mt-0.5">{t.kpiSeniorPlusSub}</div>
      </div>

      <div class="p-4 rounded-xl panel-surface border border-slate-800">
        <div class="text-[10px] font-mono uppercase text-slate-400 tracking-wider mb-1">{t.kpiRemote}</div>
        <div class="text-2xl font-bold font-mono text-emerald-300">{role.remote_pct}%</div>
        <div class="text-[11px] text-slate-400 mt-0.5">{t.kpiRemoteSub}</div>
      </div>

      <div class="p-4 rounded-xl panel-surface border border-slate-800">
        <div class="text-[10px] font-mono uppercase text-slate-400 tracking-wider mb-1">{t.kpiHeadcount}</div>
        <div class="text-2xl font-bold font-mono text-slate-200">
          {role.occupied_seats ? role.occupied_seats.toLocaleString('en-US') : 'N/A'}
        </div>
        <div class="text-[11px] text-slate-400 mt-0.5">{t.kpiHeadcountSub}</div>
      </div>

      <div class="p-4 rounded-xl panel-surface border border-slate-800">
        <div class="text-[10px] font-mono uppercase text-slate-400 tracking-wider mb-1">{t.kpiExpansion}</div>
        <div class="text-2xl font-bold font-mono text-purple-300">
          {role.expansion_index_pct ? `${role.expansion_index_pct}%` : 'N/A'}
        </div>
        <div class="text-[11px] text-slate-400 mt-0.5">{t.kpiExpansionSub}</div>
      </div>
    </div>
  </section>

  <!-- Executive Synthesis Narrative -->
  <section class="mb-12 p-6 sm:p-8 rounded-2xl bg-gradient-to-br from-slate-900/90 to-[#070b14]/90 border border-slate-800 shadow-xl space-y-4">
    <div class="flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-cyan-400">
      <span>{t.synthesisTag}</span>
      <span class="text-slate-600">//</span>
      <span>{t.synthesisTitle}</span>
    </div>
    <div class="space-y-4 max-w-4xl text-slate-200 text-sm sm:text-base leading-relaxed">
      {role.synthesized_description[lang].map((p) => (
        <p>{p}</p>
      ))}
    </div>
  </section>

  <!-- Skills & Technology Architecture Grid -->
  <section class="mb-12 grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Core Skills -->
    <div class="p-6 rounded-2xl panel-surface border border-slate-800 space-y-5">
      <div>
        <div class="flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-cyan-300">
          <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
          <span>{t.skillsTitle}</span>
        </div>
        <p class="text-xs text-slate-400 mt-1">
          {t.skillsSub}
          {role.full_desc_jobs_count ? ` (${role.full_desc_jobs_count.toLocaleString('en-US')} ${lang === 'cs' ? 'pozic se vzorkem požadavků' : 'postings with detailed text'})` : ''}
        </p>
      </div>

      {role.top_skills.length > 0 ? (
        <div class="space-y-3">
          {role.top_skills.map((sk) => (
            <div class="space-y-1">
              <div class="flex items-center justify-between text-xs font-mono">
                {(() => {
                  const resolved = getTechnology(sk.skill_id || sk.skill_name);
                  return resolved ? (
                    <a
                      href={`${lang === 'en' ? '/technologies' : '/cs/technologies'}/${resolved.id}`}
                      class="text-slate-200 font-semibold hover:text-cyan-300 transition-colors inline-flex items-center gap-1 group/skill"
                    >
                      <span>{sk.skill_name}</span>
                      <span class="text-[10px] text-cyan-400 group-hover/skill:translate-x-0.5 transition-transform">↗</span>
                    </a>
                  ) : (
                    <span class="text-slate-200 font-semibold">{sk.skill_name}</span>
                  );
                })()}
                <span class="text-cyan-300 font-bold">{sk.penetration_pct}% ({sk.job_count} {t.positionsWord})</span>
              </div>
              <div class="w-full bg-slate-800/80 rounded-full h-2 overflow-hidden">
                <div
                  class="bg-cyan-400 h-2 rounded-full transition-all duration-500"
                  style={`width: ${Math.min(sk.penetration_pct * 1.2, 100)}%`}
                ></div>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <p class="text-xs font-mono text-slate-500">{rolesNav.emptySample}</p>
      )}
    </div>

    <!-- Tech Stack & Frameworks -->
    <div class="p-6 rounded-2xl panel-surface border border-slate-800 space-y-5">
      <div>
        <div class="flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-blue-400">
          <span class="w-2 h-2 rounded-full bg-blue-400"></span>
          <span>{t.techTitle}</span>
        </div>
        <p class="text-xs text-slate-400 mt-1">
          {t.techSub}
          {role.full_desc_jobs_count ? ` (${role.full_desc_jobs_count.toLocaleString('en-US')} ${lang === 'cs' ? 'pozic se vzorkem požadavků' : 'postings with detailed text'})` : ''}
        </p>
      </div>

      {role.top_technologies.length > 0 ? (
        <div class="space-y-3">
          {role.top_technologies.map((tech) => (
            <div class="space-y-1">
              <div class="flex items-center justify-between text-xs font-mono">
                {(() => {
                  const resolved = getTechnology(tech.skill_id || tech.skill_name);
                  const href = resolved
                    ? `${lang === 'en' ? '/technologies' : '/cs/technologies'}/${resolved.id}`
                    : (cloudTechLinkMap[tech.skill_name] ? `${lang === 'en' ? '/cloud-tech' : '/cs/cloud-tech'}${cloudTechLinkMap[tech.skill_name]}` : null);
                  
                  return href ? (
                    <a
                      href={href}
                      class="text-slate-200 font-semibold hover:text-cyan-300 transition-colors inline-flex items-center gap-1 group/tech"
                    >
                      <span>{tech.skill_name}</span>
                      <span class="text-[10px] text-cyan-400 group-hover/tech:translate-x-0.5 transition-transform">↗</span>
                    </a>
                  ) : (
                    <span class="text-slate-200 font-semibold">{tech.skill_name}</span>
                  );
                })()}
                <span class="text-blue-300 font-bold">{tech.penetration_pct}% ({tech.job_count} {t.positionsWord})</span>
              </div>
              <div class="w-full bg-slate-800/80 rounded-full h-2 overflow-hidden">
                <div
                  class="bg-blue-400 h-2 rounded-full transition-all duration-500"
                  style={`width: ${Math.min(tech.penetration_pct * 1.5, 100)}%`}
                ></div>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <p class="text-xs font-mono text-slate-500">{rolesNav.emptySample}</p>
      )}
    </div>
  </section>

  <!-- Seniority, Companies & Sectors Section -->
  <section class="mb-12 grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- Seniority Breakdown -->
    <div class="p-6 rounded-2xl panel-surface border border-slate-800 space-y-4">
      <div>
        <h3 class="text-xs font-mono uppercase tracking-wider text-purple-300 font-semibold">{t.seniorityTitle}</h3>
        <p class="text-[11px] text-slate-400">{t.senioritySub}</p>
      </div>
      <div class="space-y-2.5">
        {role.seniority_breakdown.map((sen) => (
          <div class="flex items-center justify-between text-xs font-mono">
            <span class="text-slate-300">{sen.seniority}</span>
            <span class="text-purple-300 font-bold">{sen.share_pct}%</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Top Hiring Companies -->
    <div class="p-6 rounded-2xl panel-surface border border-slate-800 space-y-4">
      <div>
        <h3 class="text-xs font-mono uppercase tracking-wider text-emerald-300 font-semibold">{t.companiesTitle}</h3>
        <p class="text-[11px] text-slate-400">{t.companiesSub}</p>
      </div>
      {role.top_companies.length > 0 ? (
        <ul class="space-y-2.5 text-xs font-mono">
          {role.top_companies.map((comp) => (
            <li class="flex items-center justify-between gap-2">
              <span class="text-slate-200 truncate">{comp.company_name}</span>
              <span class="text-emerald-300 font-bold shrink-0">{comp.job_count} {t.positionsWord}</span>
            </li>
          ))}
