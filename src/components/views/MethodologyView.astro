---
import Layout from '../../layouts/Layout.astro';
import { ui, type Locale } from '../../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang].methodology;

const methodologyJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: t.pageTitle,
  description: t.pageDescription,
  publisher: {
    '@type': 'Organization',
    name: 'Vector87',
    url: 'https://vector87.com',
  },
};
---

<Layout title={t.pageTitle} description={t.pageDescription} activeNav="about" lang={lang} jsonLd={methodologyJsonLd}>
  <div class="max-w-4xl mx-auto py-4">
    <!-- Header -->
    <header class="mb-10 pb-6 border-b border-slate-800/80">
      <span class="text-xs font-mono uppercase tracking-widest text-cyan-400">{t.tag}</span>
      <h1 class="text-3xl sm:text-4xl font-bold text-white tracking-tight mt-2">
        {t.title}
      </h1>
      <p class="text-xs font-mono text-slate-400 mt-2">
        LAST UPDATED: {t.lastUpdated} // TELEMETRY CONTRACT SPECIFICATION
      </p>
    </header>

    <!-- Intro Card -->
    <div class="mb-10 p-5 sm:p-6 rounded-xl bg-slate-900/60 border border-slate-800 text-sm text-slate-300 leading-relaxed">
      {t.intro}
    </div>

    <!-- Methodology Pillars -->
    <div class="space-y-8">
      <!-- Section 1: Base Unit -->
      <section class="panel-surface rounded-xl p-6 border-t-2 border-t-cyan-400 space-y-3">
        <div class="flex items-center gap-2">
          <span class="px-2 py-0.5 rounded text-[10px] font-mono uppercase bg-cyan-500/10 text-cyan-300 border border-cyan-500/30 font-bold">
            01 // UNIT DEFINITION
          </span>
        </div>
        <h2 class="text-lg font-bold text-white tracking-tight">{t.s1Title}</h2>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
          {t.s1Text}
        </p>
      </section>

      <!-- Section 2: Role Taxonomy -->
      <section class="panel-surface rounded-xl p-6 border-t-2 border-t-emerald-400 space-y-3">
        <div class="flex items-center gap-2">
          <span class="px-2 py-0.5 rounded text-[10px] font-mono uppercase bg-emerald-500/10 text-emerald-300 border border-emerald-500/30 font-bold">
            02 // TAXONOMY & OVERLAPS
          </span>
        </div>
        <h2 class="text-lg font-bold text-white tracking-tight">{t.s2Title}</h2>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
          {t.s2Text}
        </p>
      </section>

      <!-- Section 3: Skills Extraction -->
      <section class="panel-surface rounded-xl p-6 border-t-2 border-t-amber-400 space-y-3">
        <div class="flex items-center gap-2">
          <span class="px-2 py-0.5 rounded text-[10px] font-mono uppercase bg-amber-500/10 text-amber-300 border border-amber-500/30 font-bold">
            03 // SKILL FREQUENCY
          </span>
        </div>
        <h2 class="text-lg font-bold text-white tracking-tight">{t.s3Title}</h2>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
          {t.s3Text}
        </p>
      </section>

      <!-- Section 4: S&P 500 Corpus & Entity Deduplication -->
      <section class="panel-surface rounded-xl p-6 border-t-2 border-t-purple-400 space-y-3">
        <div class="flex items-center gap-2">
          <span class="px-2 py-0.5 rounded text-[10px] font-mono uppercase bg-purple-500/10 text-purple-300 border border-purple-500/30 font-bold">
            04 // CORPUS & ENTITY RESOLUTION
          </span>
        </div>
        <h2 class="text-lg font-bold text-white tracking-tight">{t.s4Title}</h2>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
          {t.s4Text}
        </p>
      </section>

      <!-- Section 5: Lifecycle & Limitations -->
      <section class="panel-surface rounded-xl p-6 border-t-2 border-t-blue-400 space-y-3">
        <div class="flex items-center gap-2">
          <span class="px-2 py-0.5 rounded text-[10px] font-mono uppercase bg-blue-500/10 text-blue-300 border border-blue-500/30 font-bold">
            05 // LIFECYCLE & LIMITS
          </span>
        </div>
        <h2 class="text-lg font-bold text-white tracking-tight">{t.s5Title}</h2>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
          {t.s5Text}
        </p>
      </section>
    </div>

    <!-- Navigation Back -->
    <div class="mt-12 pt-6 border-t border-slate-800/80 flex items-center justify-between text-xs font-mono">
      <a href={lang === 'en' ? '/' : '/cs/'} class="text-cyan-400 hover:text-cyan-300 font-semibold">
        {t.ctaHome}
      </a>
      <span class="text-slate-500">VECTOR87.COM // INDEPENDENT TELEMETRY</span>
    </div>
  </div>
</Layout>
