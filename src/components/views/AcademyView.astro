---
import Layout from '../../layouts/Layout.astro';
import { ui, type Locale } from '../../i18n/ui';
import { ACADEMY_COURSES, CERTIFICATIONS_LIST } from '../../data/academy';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang].academy;

const platformColors: Record<string, string> = {
  Coursera: 'bg-blue-500/10 text-blue-300 border-blue-500/30',
  DataCamp: 'bg-emerald-500/10 text-emerald-300 border-emerald-500/30',
  'DeepLearning.AI': 'bg-amber-500/10 text-amber-300 border-amber-500/30',
  'Google Cloud': 'bg-cyan-500/10 text-cyan-300 border-cyan-500/30',
  'dbt Labs': 'bg-orange-500/10 text-orange-300 border-orange-500/30',
};

const academyJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: t.title,
  description: t.pageDescription,
  itemListElement: ACADEMY_COURSES.map((course, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    item: {
      '@type': 'Course',
      name: course.title,
      description: course.description,
      provider: {
        '@type': 'Organization',
        name: course.provider,
      },
      url: course.url,
    },
  })),
};
---

<Layout title={t.pageTitle} description={t.pageDescription} activeNav="academy" lang={lang} jsonLd={academyJsonLd}>
  <!-- Hero Section -->
  <section class="mb-12 pb-8 border-b border-slate-800/80">
    <div class="max-w-4xl space-y-3">
      <span class="text-xs font-mono uppercase tracking-widest text-cyan-400">{t.tag}</span>
      <h1 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">
        {t.title}
      </h1>
      <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
        {t.subtitle}
      </p>
    </div>
  </section>

  <!-- 1. Structured Curriculum Tracks -->
  <section class="mb-14">
    <div class="mb-6">
      <h2 class="text-2xl font-bold text-white tracking-tight">{t.tracksTitle}</h2>
      <p class="text-xs font-mono text-slate-400 mt-1">{t.tracksSubtitle}</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      {t.tracks.map((tr) => (
        <div class="panel-surface rounded-xl p-6 flex flex-col justify-between border-t-2 border-t-cyan-500/40">
          <div>
            <div class="flex items-center justify-between gap-2 text-xs font-mono">
              <span class="text-cyan-400 font-bold">{tr.code}</span>
              <span class="px-2 py-0.5 rounded bg-slate-900 text-slate-300 border border-slate-800">
                {tr.level}
              </span>
            </div>
            <h3 class="text-lg font-bold text-white mt-3 leading-snug">{tr.title}</h3>
            
            {tr.marketMetric && (
              <div class="mt-3 p-2.5 rounded-lg bg-cyan-950/30 border border-cyan-800/40 text-[11px] font-mono text-cyan-300 flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 shrink-0"></span>
                <span>{tr.marketMetric}</span>
              </div>
            )}

            <p class="text-xs text-slate-300 mt-3 leading-relaxed">{tr.focus}</p>

            <ul class="mt-5 space-y-2.5 border-t border-slate-800/80 pt-4">
              {tr.modules.map((mod) => (
                <li class="text-xs text-slate-200 flex items-start gap-2 leading-relaxed">
                  <span class="text-cyan-400 font-mono mt-0.5">→</span>
                  <span>{mod}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 2. Interactive Hands-on Courses (Coursera, DataCamp, DeepLearning.AI) -->
  <section class="mb-14">
    <div class="mb-6 flex flex-col sm:flex-row sm:items-end justify-between gap-2">
      <div>
        <h2 class="text-2xl font-bold text-white tracking-tight">{t.coursesTitle}</h2>
        <p class="text-xs font-mono text-slate-400 mt-1">{t.coursesSubtitle}</p>
      </div>
      <span class="text-xs font-mono text-cyan-400 bg-cyan-500/10 border border-cyan-500/30 px-2.5 py-1 rounded">
        TELEMETRY VERIFIED
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {ACADEMY_COURSES.map((course) => {
        const badgeClass = platformColors[course.platform] || 'bg-slate-800 text-slate-300 border-slate-700';
        return (
          <div class="panel-surface-interactive rounded-xl p-5 flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class:list={['text-[11px] font-mono uppercase px-2.5 py-0.5 rounded border font-semibold', badgeClass]}>
                  {course.platform}
                </span>
                <span class="text-[11px] font-mono text-slate-400">
                  {course.duration[lang]}
                </span>
              </div>

              <h3 class="text-base font-bold text-white group-hover:text-cyan-300 transition-colors leading-snug">
                {course.title[lang]}
              </h3>

              <div class="mt-2.5 p-2 rounded bg-slate-900/90 border border-slate-800/80 text-[11px] font-mono text-amber-300/90 flex items-start gap-1.5">
                <span class="text-amber-400 mt-0.5">⚡</span>
                <span class="leading-tight">{course.marketSignal[lang]}</span>
              </div>

              <p class="text-xs text-slate-300 mt-3 leading-relaxed">
                {course.description[lang]}
              </p>

              <div class="mt-4 flex flex-wrap gap-1.5">
                {course.skills.map((skill) => (
                  <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-800/80 text-slate-300 border border-slate-700/60">
                    {skill}
                  </span>
                ))}
              </div>
            </div>

            <div class="mt-5 pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs font-mono">
              <span class="text-slate-400">{course.level[lang]}</span>
              <a
                href={course.url}
                target="_blank"
                rel="sponsored noopener noreferrer"
                class="px-3 py-1.5 rounded bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 font-bold hover:bg-cyan-400 hover:text-slate-950 transition-colors inline-flex items-center gap-1"
              >
                {t.ctaEnroll}
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- 3. Industry Certifications Roadmap -->
  <section class="mb-14">
    <div class="mb-6">
      <h2 class="text-2xl font-bold text-white tracking-tight">{t.certsTitle}</h2>
      <p class="text-xs font-mono text-slate-400 mt-1">{t.certsSubtitle}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {CERTIFICATIONS_LIST.map((cert) => (
        <div class="panel-surface rounded-xl p-5 flex flex-col justify-between border-l-2 border-l-cyan-400">
          <div>
            <div class="flex items-center justify-between gap-2 text-xs font-mono mb-2">
              <span class="text-cyan-400 font-bold">{cert.code}</span>
              <span class="text-slate-400">{cert.issuer}</span>
            </div>

            <h3 class="text-base font-bold text-white leading-snug">{cert.title}</h3>

            <div class="mt-2.5 text-[11px] font-mono text-emerald-400 flex items-center gap-1.5">
              <span>●</span>
              <span>{cert.marketValue[lang]}</span>
            </div>

            <p class="text-xs text-slate-300 mt-3 leading-relaxed">
              {cert.summary[lang]}
            </p>

            <div class="mt-4 flex flex-wrap gap-1.5">
              {cert.skills.map((s) => (
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-900 text-slate-300 border border-slate-800">
                  {s}
                </span>
              ))}
            </div>
          </div>

          <div class="mt-5 pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs font-mono">
            <span class="text-slate-400">{cert.level[lang]}</span>
            <a
              href={cert.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-cyan-400 hover:text-cyan-300 underline font-semibold"
            >
              {t.ctaCertGuide}
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 4. Essential Architectural Library (Books) -->
  <section class="mb-14">
    <div class="mb-6">
      <h2 class="text-2xl font-bold text-white tracking-tight">{t.booksTitle}</h2>
      <p class="text-xs font-mono text-slate-400 mt-1">{t.booksSubtitle}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {t.books.map((b) => (
        <div class="panel-surface-interactive rounded-xl p-5 flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between gap-2">
              <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded bg-cyan-500/10 text-cyan-300 border border-cyan-500/30">
                {b.category}
              </span>
              <span class="text-xs font-mono text-slate-400">{b.author}</span>
            </div>
            <h3 class="text-base font-bold text-white mt-2.5 group-hover:text-cyan-300 transition-colors leading-snug">
              {b.title}
            </h3>
            <p class="text-xs text-slate-300 mt-2 leading-relaxed">{b.why}</p>
          </div>

          {b.url && (
            <div class="mt-4 pt-3 border-t border-slate-800/80 flex items-center justify-end">
              <a
                href={b.url}
                target="_blank"
                rel="sponsored noopener noreferrer"
                class="text-xs font-mono text-amber-400 hover:text-amber-300 flex items-center gap-1 font-semibold"
              >
                {t.ctaBook}
              </a>
            </div>
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- Affiliate / Transparency Disclaimer -->
  <section class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 text-[11px] font-mono text-slate-500 leading-relaxed text-center max-w-3xl mx-auto mb-6">
    {t.sponsorDisclaimer}
  </section>
</Layout>
